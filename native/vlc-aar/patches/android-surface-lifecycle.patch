diff --git a/src/input/resource.c b/src/input/resource.c
--- a/src/input/resource.c
+++ b/src/input/resource.c
@@ -377,7 +377,12 @@ static void input_resource_PutVoutLocked(input_resource_t *p_resource,
         vout_rsc->started = false;
     }
 
-    if (vout_rsc == resource_GetFirstVoutRsc(p_resource))
+    /* An embedded Android Surface may be destroyed while audio keeps playing.
+     * Do not retain its window/decoder device across a video-track deselection:
