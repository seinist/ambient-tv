+#include <dlfcn.h>
+/* Optional in-process PCM tap; no microphone or system-wide audio capture. */
+static void ambient_pcm_tap(int source, const void *data, size_t frames, int channels, int encoding)
+{
+    typedef void (*tap_fn)(int, const void *, size_t, int, int);
+    static tap_fn tap;
+    static unsigned retry;
+    if (!tap && (++retry % 64 == 1)) {
+        void *lib = dlopen("libambientprojectm.so", RTLD_NOW | RTLD_NOLOAD);
+        if (lib) {
+            tap = (tap_fn)dlsym(lib, "ambient_projectm_pcm_v1");
+            /* Retain the handle for the lifetime of the cached function pointer. */
+            if (!tap) dlclose(lib);
+        }
+    }
+    if (tap) tap(source, data, frames, channels, encoding);
+}
