+bool pl_vulkan_swapchain_ambient_enable(pl_swapchain sw)
+{
+    if (!sw)
+        return false;
+    struct priv *p = PL_PRIV(sw);
+    if (p->impl.destroy != vk_sw_destroy || p->swapchain || p->sems.num ||
+        p->vk->pools.num != 1)
+        return false;
+    p->ambient_wsi = true;
+    return true;
+}
+
+bool pl_vulkan_swapchain_ambient_mark_retired(pl_swapchain sw)
+{
+    if (!sw)
+        return false;
+    struct priv *p = PL_PRIV(sw);
+    struct vk_ctx *vk = p->vk;
+    if (p->impl.destroy != vk_sw_destroy || vk->pools.num != 1 ||
+        vk->pool_graphics->num_queues < 1)
+        return false;
+    // Queue zero has already retired. All other queues were flushed before
+    // the raw terminal fence; no new work may be submitted at this point.
+    struct vk_cmdpool *pool = vk->pool_graphics;
+    for (int i = 1; i < pool->num_queues; i++) {
+        vk->lock_queue(vk->queue_ctx, pool->qf, i);
+        VkResult res = vk->QueueWaitIdle(pool->queues[i]);
+        vk->unlock_queue(vk->queue_ctx, pool->qf, i);
+        if (res != VK_SUCCESS && res != VK_ERROR_DEVICE_LOST)
+            return false;
+    }
+    // Drain callbacks nonblocking and reject if anything remains outstanding.
+    vk_poll_commands(vk, 0);
+    pl_mutex_lock(&vk->lock);
+    bool empty = vk->cmds_pending.num == 0 && vk->num_pending_callbacks == 0 &&
+                 p->last_imgidx < 0 && pl_rc_count(&p->frames_in_flight) == 0;
+    pl_mutex_unlock(&vk->lock);
+    p->ambient_retired = empty;
+    return empty;
+}
+
+bool pl_vulkan_swapchain_ambient_presented(pl_swapchain sw)
+{
+    if (!sw)
+        return false;
+    struct priv *p = PL_PRIV(sw);
+    return p->impl.destroy == vk_sw_destroy && p->ambient_presented;
+}
