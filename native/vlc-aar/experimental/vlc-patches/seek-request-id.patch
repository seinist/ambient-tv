+int libvlc_media_player_ambient_set_time_with_id(libvlc_media_player_t *p_mi,
+                                                 libvlc_time_t time, uint64_t request_id)
+{
+    if (time < 0 || time > INT64_MAX / 1000 || !request_id)
+        return -1;
+    vlc_player_t *player = p_mi->player;
+    vlc_player_Lock(player);
+    int ret = vlc_player_SeekByTimeWithId(player, vlc_tick_from_libvlc_time(time), request_id);
+    vlc_player_Unlock(player);
+    return ret == VLC_SUCCESS ? 0 : -1;
