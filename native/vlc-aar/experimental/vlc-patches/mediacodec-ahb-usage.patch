+            bool use_air;
+            bool ambient_ahb;
+            vlc_cond_t air_cond;
             unsigned air_waiting_count;
         } video;
         struct {
@@ -930,11 +931,23 @@
         return;
     }
     vlc_mutex_lock(&p_sys->lock);
-    assert(p_sys->video.air_waiting_count > 0);
