+            else if (vlc_cond_timedwait(&p_sys->video.air_cond, &p_sys->lock, deadline))
+            {
+                if (p_sys->video.air_waiting_count != 0)
+                    AbortDecoderLocked(p_sys);
+                break;
+            }
+        }
     }
 }
 
