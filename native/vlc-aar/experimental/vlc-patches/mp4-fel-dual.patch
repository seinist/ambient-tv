+    for(unsigned r=0;r<t->context.runs.i_count;r++){
+        const mp4_run_t *run=&t->context.runs.p_array[r];
+        if(!run->p_trun||!run->p_trun->data.p_trun)return false;
+        const MP4_Box_data_trun_t *tr=run->p_trun->data.p_trun;
+        if(!tr->i_sample_count||((tr->i_flags&(MP4_TRUN_SAMPLE_SIZE|MP4_TRUN_SAMPLE_DURATION))&&
+           !tr->p_samples))return false;
+        stime_t time=run->i_first_dts;
+        uint64_t pos=run->i_offset;
+        for(unsigned i=0;i<tr->i_sample_count;i++){
+            uint32_t dur=tr->i_flags&MP4_TRUN_SAMPLE_DURATION?tr->p_samples[i].i_duration:
