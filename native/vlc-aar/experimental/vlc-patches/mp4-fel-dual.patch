+/* The same composition-offset interpretation as VLC's fragment reader.
+ * The legacy v0 negative-offset compatibility is retained deliberately. */
+static int64_t MP4_FEL_CompositionOffset(const MP4_Box_data_trun_t *trun,unsigned sample)
+{
+    if (!(trun->i_flags&MP4_TRUN_SAMPLE_TIME_OFFSET)) return 0;
+    const MP4_descriptor_trun_sample_t *s=&trun->p_samples[sample];
+    return trun->i_version==1 || s->i_composition_time_offset.v0>=0xff000000u ?
+        (int64_t)s->i_composition_time_offset.v1 : s->i_composition_time_offset.v0;
+}
+
+/* Prove run continuity before using a DTS cursor. Reject malformed or
+ * ambiguous timestamps, and bound work for adversarial fragment tables. */
+static bool MP4_FEL_ValidateRuns(const mp4_track_t *t,uint64_t *samples,stime_t *end)
+{
+    *samples=0;*end=0;
+    if (!t->context.runs.i_count) return true;
+    if (!t->context.runs.p_array || t->context.runs.i_count>65536) return false;
+    *end=t->context.runs.p_array[0].i_first_dts;
+    if (*end<0) return false;
+    for (unsigned r=0;r<t->context.runs.i_count;r++) {
+        const mp4_run_t *run=&t->context.runs.p_array[r];
+        if (!run->p_trun || !run->p_trun->data.p_trun || run->i_first_dts!=*end)
+            return false;
+        const MP4_Box_data_trun_t *tr=run->p_trun->data.p_trun;
+        if (!tr->i_sample_count || tr->i_sample_count>1048576-*samples ||
+            ((tr->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_SIZE|
+                           MP4_TRUN_SAMPLE_TIME_OFFSET)) && !tr->p_samples)) return false;
+        uint64_t offset=run->i_offset;
+        for (unsigned i=0;i<tr->i_sample_count;i++) {
+            uint32_t duration=tr->i_flags&MP4_TRUN_SAMPLE_DURATION ?
+                tr->p_samples[i].i_duration:run->ambient_fel_source?run->ambient_fel_duration:t->context.i_default_sample_duration;
+            uint32_t bytes=tr->i_flags&MP4_TRUN_SAMPLE_SIZE ?
+                tr->p_samples[i].i_size:run->ambient_fel_source?run->ambient_fel_size:t->context.i_default_sample_size;
+            if (!duration || !bytes || bytes>AMBIENT_FEL_MAX_AU ||
+                *end>INT64_MAX-duration || offset>UINT64_MAX-bytes ||
+                !ambient_fel_pts_valid(*end,MP4_FEL_CompositionOffset(tr,i))) return false;
+            *end+=duration;offset+=bytes;
+        }
+        *samples+=tr->i_sample_count;
+    }
+    return true;
+}
+
+/* Check every corresponding sample before submitting the first BL AU.
+ * Different trun partitioning is allowed; raw DTS, CTS and duration
+ * must map exactly. Earlier checks have bounded both tables and sums. */
+static bool MP4_FEL_ValidatePair(const mp4_track_t *bl,const mp4_track_t *el)
+{
+    unsigned er=0,ei=0;
+    for(unsigned br=0;br<bl->context.runs.i_count;br++){
+        const mp4_run_t *b=&bl->context.runs.p_array[br];
+        const MP4_Box_data_trun_t *bt=b->p_trun->data.p_trun;
+        for(unsigned bi=0;bi<bt->i_sample_count;bi++){
+            if(er>=el->context.runs.i_count)return false;
+            const mp4_run_t *e=&el->context.runs.p_array[er];
+            const MP4_Box_data_trun_t *et=e->p_trun->data.p_trun;
+            uint32_t bd=bt->i_flags&MP4_TRUN_SAMPLE_DURATION?
+                bt->p_samples[bi].i_duration:b->ambient_fel_source?b->ambient_fel_duration:bl->context.i_default_sample_duration;
+            uint32_t ed=et->i_flags&MP4_TRUN_SAMPLE_DURATION?
+                et->p_samples[ei].i_duration:e->ambient_fel_source?e->ambient_fel_duration:el->context.i_default_sample_duration;
+            int64_t mapped;
+            if(!ambient_fel_rescale_exact(bd,bl->i_timescale,el->i_timescale,&mapped)||
+               mapped!=ed||
+               !ambient_fel_rescale_exact(MP4_FEL_CompositionOffset(bt,bi),
+                    bl->i_timescale,el->i_timescale,&mapped)||
+               mapped!=MP4_FEL_CompositionOffset(et,ei))return false;
+            if(++ei==et->i_sample_count){ei=0;er++;}
+        }
+    }
+    return er==el->context.runs.i_count && !ei;
+}
