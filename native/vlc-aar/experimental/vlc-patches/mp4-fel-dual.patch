+/* Read a dependent sample by index without changing its demux state.
+ * Both DTS and PTS must match the BL after edit-list mapping. The
+ * dependent stream never enters the normal ES scheduling loop. */
+static block_t *MP4_FEL_ReadPaired(demux_t *d,mp4_track_t *bl,block_t *base)
+{
+    mp4_track_t *el=MP4_GetTrackByTrackID(d,bl->ambient_fel_el_id);
+    if (!el || !el->ambient_fel_hidden || bl->i_sample>=el->i_sample_count ||
+        base->i_pts==VLC_TICK_INVALID || base->i_dts==VLC_TICK_INVALID)
+        return NULL;
+    mp4_track_t pos=*el;
+    pos.i_sample=bl->i_sample;
+    // Binary search chunk start indices, then validate the selected range.
+    unsigned lo=0,hi=el->i_chunk_count;
+    while (lo<hi) {
+        unsigned mid=lo+(hi-lo)/2;
+        if (el->chunk[mid].i_sample_first<=pos.i_sample) lo=mid+1; else hi=mid;
+    }
+    if (!lo) return NULL;
+    pos.i_chunk=lo-1;
+    const mp4_chunk_t *ck=&el->chunk[pos.i_chunk];
+    if (pos.i_sample-ck->i_sample_first>=ck->i_sample_count) return NULL;
+    pos.i_elst=bl->i_elst;pos.i_elst_time=bl->i_elst_time;
+    pos.i_start_dts=bl->i_start_dts;
+    TrackUpdateSampleAndTimes(&pos);
+    vlc_tick_t pts;
+    vlc_tick_t dts=MP4_TrackGetDTSPTS(d,&pos,&pts);
+    if (pts==INVALID_PTS || base->i_dts!=VLC_TICK_0+dts ||
+        base->i_pts!=VLC_TICK_0+pts) return NULL;
+    uint64_t offset=ck->i_offset;
+    uint32_t size=pos.i_sample_size;
+    if (size) {
+        uint64_t add=(uint64_t)(pos.i_sample-ck->i_sample_first)*size;
+        if (add>UINT64_MAX-offset) return NULL;
+        offset+=add;
+    } else {
+        if (!pos.p_sample_size) return NULL;
+        for (uint32_t j=ck->i_sample_first;j<pos.i_sample;j++) {
+            if (pos.p_sample_size[j]>UINT64_MAX-offset) return NULL;
+            offset+=pos.p_sample_size[j];
+        }
+        size=pos.p_sample_size[pos.i_sample];
+    }
+    if (!size || size>AMBIENT_FEL_MAX_AU || size>UINT64_MAX-offset ||
+        MP4_Seek(d->s,offset)!=VLC_SUCCESS) return NULL;
+    block_t *enh=vlc_stream_Block(d->s,size);
+    if (!enh) return NULL;
+    block_t *merged=NULL;
+    const MP4_Box_t *bc=MP4_BoxGet(bl->p_sample,"hvcC");
+    const MP4_Box_t *ec=MP4_BoxGet(el->p_sample,"hvcC");
