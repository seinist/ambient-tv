+        unsigned bw=ambient_fel_hvcc_length(bc->data.p_binary->p_blob,bc->data.p_binary->i_blob);
+        const uint8_t *config=ec->data.p_binary->p_blob;
+        size_t cn=ec->data.p_binary->i_blob;
+        unsigned ew=ambient_fel_hvcc_length(config,cn);
