+static bool MP4_FEL_MetaString(const uint8_t **p,size_t *n)
+{
+    const uint8_t *end=memchr(*p,0,*n);
+    if(!end)return false;
+    size_t len=end-*p+1;
+    *p+=len;*n-=len;
+    return true;
+}
