+/* Optional per-media Android transport. A bounded worker owns all
+ * blocking I/O; the demux thread never waits for the application.
+ * The random abstract Unix socket is local-only, and both peers check UID.
+ * One connection = one framed event; partial writes cannot corrupt a later
+ * event. No external URI, file write, or arbitrary socket path is accepted. */
+#ifdef __ANDROID__
+struct ambient_fel_android_bridge {
+    pthread_t thread;
+    pthread_mutex_t mutex;
+    pthread_cond_t ready;
+    bool closing,barrier_pending;
+    uint32_t epoch;
+    unsigned head,count;
+    size_t bytes;
+    struct sockaddr_un address;
+    socklen_t address_len;
+    struct { block_t *block; uint32_t kind,epoch; } queue[64];
+};
+
+static int64_t MP4_FEL_AndroidMillis(void)
+{
+    struct timespec ts;
+    if(clock_gettime(CLOCK_MONOTONIC,&ts))return -1;
+    return (int64_t)ts.tv_sec*1000+ts.tv_nsec/1000000;
+}
+
+static bool MP4_FEL_AndroidWritable(int fd,int64_t deadline)
+{
+    for(;;){
+        int64_t now=MP4_FEL_AndroidMillis();
+        if(now<0||now>=deadline)return false;
+        struct pollfd p={.fd=fd,.events=POLLOUT};
+        int n=poll(&p,1,(int)(deadline-now));
+        if(n<0&&errno==EINTR)continue;
+        return n==1&&(p.revents&POLLOUT)&&!(p.revents&(POLLERR|POLLHUP|POLLNVAL));
+    }
+}
+
+static bool MP4_FEL_AndroidWrite(int fd,const void *data,size_t size,int64_t deadline)
+{
+    const uint8_t *p=data;
+    while(size){
+        ssize_t n=send(fd,p,size,MSG_NOSIGNAL);
+        if(n>0){p+=n;size-=n;continue;}
+        if(n<0&&errno==EINTR)continue;
+        if(n<0&&(errno==EAGAIN||errno==EWOULDBLOCK)&&MP4_FEL_AndroidWritable(fd,deadline))continue;
+        return false;
+    }
+    return true;
+}
+
+static void MP4_FEL_AndroidDeliver(struct ambient_fel_android_bridge *a,block_t *b,uint32_t kind,uint32_t epoch)
+{
+    int64_t now=MP4_FEL_AndroidMillis();
+    if(now<0)return;
+    int64_t deadline=now+150;
+    int fd=socket(AF_UNIX,SOCK_STREAM|SOCK_CLOEXEC|SOCK_NONBLOCK,0);
+    if(fd<0)return;
+    if(connect(fd,(struct sockaddr *)&a->address,a->address_len)){
+        int error=0;socklen_t n=sizeof(error);
+        if(errno!=EINPROGRESS||!MP4_FEL_AndroidWritable(fd,deadline)||
+           getsockopt(fd,SOL_SOCKET,SO_ERROR,&error,&n)||error)goto done;
+    }
+    struct {pid_t pid;uid_t uid;gid_t gid;} peer;
+    socklen_t length=sizeof(peer);
+    if(getsockopt(fd,SOL_SOCKET,SO_PEERCRED,&peer,&length)||length!=sizeof(peer)||peer.uid!=getuid())goto done;
+    uint8_t header[32];
+    memcpy(header,"AFM1",4);
+    SetDWBE(header+4,kind);
+    SetQWBE(header+8,b?(uint64_t)(b->i_pts-VLC_TICK_0):0);
+    SetQWBE(header+16,b?(uint64_t)b->i_length:0);
+    SetDWBE(header+24,b?b->i_buffer:0);
+    SetDWBE(header+28,epoch);
+    if(MP4_FEL_AndroidWrite(fd,header,sizeof(header),deadline)&&b)
+        MP4_FEL_AndroidWrite(fd,b->p_buffer,b->i_buffer,deadline);
+done:
+    close(fd);
+}
+
+static void *MP4_FEL_AndroidWorker(void *opaque)
+{
+    struct ambient_fel_android_bridge *a=opaque;
+    for(;;){
+        pthread_mutex_lock(&a->mutex);
+        while(!a->closing&&!a->barrier_pending&&!a->count)pthread_cond_wait(&a->ready,&a->mutex);
+        if(a->closing){pthread_mutex_unlock(&a->mutex);break;}
+        if(a->barrier_pending){
+            uint32_t epoch=a->epoch;
+            a->barrier_pending=false;
+            pthread_mutex_unlock(&a->mutex);
+            MP4_FEL_AndroidDeliver(a,NULL,2,epoch);
+            continue;
+        }
+        unsigned i=a->head;
+        block_t *b=a->queue[i].block;uint32_t kind=a->queue[i].kind,epoch=a->queue[i].epoch;
+        a->queue[i].block=NULL;a->head=(i+1)%64;--a->count;a->bytes-=b->i_buffer;
+        pthread_mutex_unlock(&a->mutex);
+        MP4_FEL_AndroidDeliver(a,b,kind,epoch);
+        block_Release(b);
+    }
+    return NULL;
+}
