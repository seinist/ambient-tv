+/* Preserve the entire original timed box as an opaque data ES sample.
+ * Only standardized timestamp envelopes are interpreted. */
+static bool MP4_FEL_MetaTicks(uint64_t value,uint32_t scale,vlc_tick_t *out)
+{
+    if(!scale)return false;
+    const uint64_t limit=(uint64_t)VLC_TICK_MAX-VLC_TICK_0;
+    uint64_t q=value/scale,r=value%scale;
+    if(q>limit/CLOCK_FREQ)return false;
+    uint64_t base=q*CLOCK_FREQ,frac=r*(uint64_t)CLOCK_FREQ/scale;
+    if(frac>limit-base)return false;
+    *out=base+frac;
+    return true;
+}
