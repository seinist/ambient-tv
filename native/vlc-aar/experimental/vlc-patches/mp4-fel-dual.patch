+static bool MP4_FEL_ValidatePayloads(const demux_sys_t *s)
+{
+    uint64_t start=s->context.ambient_fel_mdat_start,end=s->context.i_post_mdat_offset;
+    if(start>=end)return false;
+    size_t count=0;
