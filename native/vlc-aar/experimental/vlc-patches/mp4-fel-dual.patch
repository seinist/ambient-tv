+static bool MP4_FEL_TrackClock(vlc_tick_t target,uint32_t scale,stime_t *time)
+{
+    if(target<0||!scale)return false;
+    const uint64_t q=(uint64_t)target/CLOCK_FREQ,r=(uint64_t)target%CLOCK_FREQ;
+    if(q>(uint64_t)INT64_MAX/scale)return false;
+    const uint64_t base=q*scale,frac=r*scale/CLOCK_FREQ;
+    if(frac>(uint64_t)INT64_MAX-base)return false;
+    *time=base+frac;
+    return true;
+}
+
+/* Reselecting an independent ES must not emit expired buffered samples.
+ * Never rewind a track whose cursor already leads the movie clock. */
+static bool MP4_FEL_ResumeIndependentTrack(demux_sys_t *s,mp4_track_t *t)
+{
+    if(!s->context.ambient_fel_interleaved||t->ambient_fel_hidden||
+       t->ambient_fel_el_id||t->context.runs.i_current>=t->context.runs.i_count)return true;
+    stime_t target;
+    if(!MP4_FEL_TrackClock(s->i_nztime,t->i_timescale,&target))return false;
+    if(t->i_time<target&&!MP4_FEL_SeekIndexedTrack(t,target))return false;
+    t->i_next_block_flags|=BLOCK_FLAG_DISCONTINUITY;
+    return true;
+}
+
+static bool MP4_FEL_ApplyInterleaveSeek(demux_sys_t *s)
+{
+    if(!s->context.ambient_fel_seek_pending)return true;
+    const vlc_tick_t target=s->context.ambient_fel_seek_time;
+    if(target<0)return false;
+    for(unsigned i=0;i<s->i_tracks;i++){
+        mp4_track_t *t=&s->track[i];
+        if(!t->b_ok||t->ambient_fel_hidden||!t->context.runs.i_count)continue;
+        stime_t time;
+        if(!MP4_FEL_TrackClock(target,t->i_timescale,&time)||
+           !MP4_FEL_SeekIndexedTrack(t,time))return false;
+        t->i_next_block_flags|=BLOCK_FLAG_DISCONTINUITY;
+    }
+    s->context.ambient_fel_seek_pending=false;
+    return true;
+}
+
+static bool MP4_FEL_RunContains(const demux_sys_t *s,const mp4_run_t *run,uint64_t pos,uint32_t size)
+{
+    unsigned source=run->ambient_fel_source;
+    if(!source)return MP4_FEL_PayloadContains(s,false,pos,size);
+    if(source>s->ambient_fel_replay_count)return false;
+    return ambient_fel_payload_contains(s->ambient_fel_replay[source-1].extents,
+        s->ambient_fel_replay[source-1].count,pos,size);
+}
+
+/* Legacy OverflowCheck bounds streaming reads to the current BL mdat.
+ * The interleaved path instead proves the complete sample in its own
+ * source extent, including every independent and mixed fragment. */
+static uint32_t MP4_FEL_CheckedRunSize(demux_t *d,mp4_track_t *track,
+    const mp4_run_t *run,uint64_t pos,uint32_t size)
+{
+    const demux_sys_t *s=d->p_sys;
+    if(s->context.ambient_fel_interleaved)
+        return MP4_FEL_RunContains(s,run,pos,size)?size:0;
+    return OverflowCheck(d,track,pos,size);
+}
+
+static block_t *MP4_FEL_ReadRun(demux_t *d,const mp4_run_t *run,uint64_t pos,uint32_t size)
+{
+    demux_sys_t *s=d->p_sys;
+    if(!MP4_FEL_RunContains(s,run,pos,size))return NULL;
+    if(!s->context.ambient_fel_mdat)return MP4_FEL_ReadExact(d->s,pos,size);
+    if(!run->ambient_fel_source)return MP4_FEL_ReadCached(s,false,pos,size);
+    unsigned i=run->ambient_fel_source-1;
+    return MP4_FEL_ReadRanges(s->ambient_fel_replay[i].extents,
+        s->ambient_fel_replay[i].mixed_el?s->context.ambient_fel_el_cache:s->ambient_fel_replay[i].cache,
+        s->ambient_fel_replay[i].count,pos,size);
+}
+
+/* Advance all independent clocks to the end of their indexed timeline,
+ * including unselected audio/subtitles. The next implicit tfdt must not
+ * inherit the first unread sample of a disabled track. Hidden EL clocks
+ * are anchored by the paired BL/EL validation, not by this pass. */
+static bool MP4_FEL_CommitIndependentClocks(demux_sys_t *s)
+{
+    for(unsigned i=0;i<s->i_tracks;i++){
+        mp4_track_t *t=&s->track[i];
+        if(t->ambient_fel_hidden||t->ambient_fel_el_id||!t->context.runs.i_count)continue;
+        if(!t->context.runs.p_array)return false;
+        stime_t end;
+        if(!MP4_FEL_RunEnd(t,&t->context.runs.p_array[t->context.runs.i_count-1],&end))
+            return false;
+        if(t->context.runs.i_current<t->context.runs.i_count)
+            t->i_next_block_flags|=BLOCK_FLAG_DISCONTINUITY;
+        t->i_time=end;
+    }
+    return true;
+}
+
+/* Locate the physical fragment owning an event. Boxes before a moof
+ * describe that next fragment; boxes within its mdat gaps describe it.
+ * The terminal EL-only source is represented by UINT_MAX. */
+static bool MP4_FEL_MetaSource(const demux_sys_t *s,uint64_t pos,unsigned *source)
+{
+    const MP4_Box_t *bl=s->context.p_fragment_atom;
+    if(!bl||bl->i_type!=ATOM_moof)return false;
+    if(pos<s->context.i_post_mdat_offset){*source=0;return true;}
+    for(unsigned i=0;i<s->ambient_fel_replay_count;i++)
+        if(pos<s->ambient_fel_replay[i].end){*source=i+1;return true;}
+    if(s->context.ambient_fel_el_moof&&pos<s->context.ambient_fel_el_end){
+        *source=UINT_MAX;return true;
+    }
+    return false;
+}
+
+/* Compute earliest presentation, not earliest decode, over the complete
+ * indexed source. Hidden EL is a valid anchor only for EL-only sources.
+ * Bound the traversal by the existing group run/sample preflight. */
+static bool MP4_FEL_SourceEPT(const demux_sys_t *s,unsigned source,vlc_tick_t *ept)
+{
+    *ept=VLC_TICK_MAX;
+    for(unsigned i=0;i<s->i_tracks;i++){
+        const mp4_track_t *t=&s->track[i];
+        if(!t->b_ok||!t->i_timescale)continue;
+        for(unsigned j=0;j<t->context.runs.i_count;j++){
+            const mp4_run_t *r=&t->context.runs.p_array[j];
+            unsigned tag=r->ambient_fel_source;
+            if(!tag&&t->ambient_fel_hidden&&t->ambient_fel_separate)tag=UINT_MAX;
+            if(tag!=source)continue;
+            const MP4_Box_data_trun_t *tr=r->p_trun?r->p_trun->data.p_trun:NULL;
+            if(!tr||((tr->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_TIME_OFFSET))&&!tr->p_samples))return false;
+            stime_t time=r->i_first_dts;
+            for(unsigned k=0;k<tr->i_sample_count;k++){
+                const int64_t cts=MP4_FEL_CompositionOffset(tr,k);
+                uint32_t dur=tr->i_flags&MP4_TRUN_SAMPLE_DURATION?tr->p_samples[k].i_duration:
+                    r->ambient_fel_source?r->ambient_fel_duration:t->context.i_default_sample_duration;
+                if(time<0||!dur||time>INT64_MAX-dur||!ambient_fel_pts_valid(time,cts))return false;
+                vlc_tick_t pts;
+                if(time+cts<0||!MP4_FEL_MetaTicks(time+cts,t->i_timescale,&pts))return false;
+                if(pts<*ept)*ept=pts;
+                time+=dur;
+            }
+        }
+    }
+    return *ept!=VLC_TICK_MAX;
+}
+
+static bool MP4_FEL_ResolveMetadata(demux_sys_t *s)
+{
+    // At most one EPT scan per physical source, even with 64 events.
+    vlc_tick_t ept[27];bool known[27]={0};
+    for(unsigned i=0;i<s->ambient_fel_meta_count;i++){
+        if(!s->ambient_fel_meta[i].relative)continue;
+        unsigned source;
+        if(!MP4_FEL_MetaSource(s,s->ambient_fel_meta[i].pos,&source))return false;
+        unsigned slot=source==UINT_MAX?26:source;
+        if(slot>=27)return false;
+        if(!known[slot]){
+            if(!MP4_FEL_SourceEPT(s,source,&ept[slot]))return false;
+            known[slot]=true;
+        }
+        block_t *b=s->ambient_fel_meta[i].block;
+        if(b->i_pts>VLC_TICK_MAX-ept[slot]||
+           b->i_length>VLC_TICK_MAX-b->i_pts-ept[slot])return false;
+        b->i_pts+=ept[slot];b->i_dts=b->i_pts;
+        s->ambient_fel_meta[i].relative=false;
+    }
+    // Re-sort once all relative timestamps have become absolute.
+    for(unsigned i=1;i<s->ambient_fel_meta_count;i++)
+        for(unsigned j=i;j&&s->ambient_fel_meta[j-1].block->i_pts>s->ambient_fel_meta[j].block->i_pts;j--){
+            unsigned char tmp[sizeof(s->ambient_fel_meta[0])];
+            memcpy(tmp,&s->ambient_fel_meta[j],sizeof(tmp));
+            s->ambient_fel_meta[j]=s->ambient_fel_meta[j-1];
+            memcpy(&s->ambient_fel_meta[j-1],tmp,sizeof(tmp));
+        }
+    return true;
+}
+
+/* Data ES consumers receive complete raw emsg/prft boxes with PTS/DTS
+ * in movie ticks. The scheme-specific message payload is not rewritten. */
+static bool MP4_FEL_EmitMetadata(demux_t *d,bool flush)
+{
+    demux_sys_t *s=d->p_sys;
+    const vlc_tick_t now=s->i_nztime;
+    while(s->ambient_fel_meta_next<s->ambient_fel_meta_count){
+        unsigned i=s->ambient_fel_meta_next;
+        block_t *b=s->ambient_fel_meta[i].block;
+        if(s->ambient_fel_meta[i].relative)return false;
+        if(!flush&&(now<0||b->i_pts-VLC_TICK_0>now))break;
+        s->ambient_fel_meta[i].block=NULL;++s->ambient_fel_meta_next;
+        if(b->i_pts<s->ambient_fel_meta_seek_floor){block_Release(b);continue;}
+        unsigned kind=s->ambient_fel_meta[i].kind;
+        MP4_FEL_AndroidSend(d,b,kind);
+        if(!s->ambient_fel_meta_es[kind]){
+            es_format_t fmt;
+            es_format_Init(&fmt,DATA_ES,kind?VLC_FOURCC('p','r','f','t'):VLC_FOURCC('e','m','s','g'));
+            s->ambient_fel_meta_es[kind]=es_out_Add(d->out,&fmt);
+            es_format_Clean(&fmt);
+            if(!s->ambient_fel_meta_es[kind]){block_Release(b);continue;}
+        }
+        /* An optional data consumer must never abort A/V playback. */
+        es_out_Send(d->out,s->ambient_fel_meta_es[kind],b);
+    }
+    return true;
+}
+
+static bool MP4_FEL_FinishInterleave(demux_t *d)
+{
+    demux_sys_t *s=d->p_sys;
+    if(!s->context.ambient_fel_interleaved||!s->ambient_fel_replay_count)return false;
+    uint64_t target=s->ambient_fel_replay_end;
+    bool ok=MP4_FEL_CommitIndependentClocks(s) &&
+        (vlc_stream_Tell(d->s)==target||(s->b_seekable&&MP4_FEL_SeekExact(d->s,target)));
+    if(ok)s->context.i_lastseqnumber=s->ambient_fel_replay_sequence;
+    FragResetContext(s);
+    if(!ok)s->b_error=true;
+    return ok;
+}
+
+static block_t *MP4_FEL_ReadFragment(demux_t *d,mp4_track_t *bl,
+    block_t *base,stime_t dts,stime_t pts,uint32_t duration)
+{
+    demux_sys_t *s=d->p_sys;
+    mp4_track_t *el=MP4_GetTrackByTrackID(d,bl->ambient_fel_el_id);
+    if (!el || !el->ambient_fel_hidden || !s->context.p_fragment_atom ||
+        !el->context.runs.i_count || !el->context.runs.p_array || dts<0) return NULL;
+    int64_t edts,epts,edur;
+    if (!ambient_fel_rescale_exact(dts,bl->i_timescale,el->i_timescale,&edts) ||
+        !ambient_fel_rescale_exact(pts,bl->i_timescale,el->i_timescale,&epts) ||
+        !ambient_fel_rescale_exact(duration,bl->i_timescale,el->i_timescale,&edur) ||
+        edur<=0 || edur>UINT32_MAX) return NULL;
+    dts=edts;pts=epts;duration=(uint32_t)edur;
+    // trun boundaries are storage boundaries, not picture boundaries.
+    // Use the independent EL cursor and match exact raw decode time,
+    // permitting different run partitioning and chunk offsets.
+    unsigned run=el->context.runs.i_current;
+    if (run>=el->context.runs.i_count || el->i_time>dts) run=0;
+    uint64_t offset=0;
+    uint32_t size=0;
+    bool matched=false;
+    unsigned source=0;
+    for (;run<el->context.runs.i_count && !matched;run++) {
+        const mp4_run_t *er=&el->context.runs.p_array[run];
+        const MP4_Box_data_trun_t *et=er->p_trun->data.p_trun;
+        if (!et || er->i_first_dts<0 || er->i_first_dts>dts ||
+            ((et->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_SIZE|
+                           MP4_TRUN_SAMPLE_TIME_OFFSET)) && !et->p_samples)) return NULL;
+        offset=er->i_offset;
+        stime_t time=er->i_first_dts;
+        unsigned start=0;
+        if (el->context.runs.i_current==run && el->i_time<=dts &&
+            el->context.i_trun_sample<=et->i_sample_count &&
+            el->context.i_trun_sample_pos>=offset && el->i_time>=time) {
+            start=el->context.i_trun_sample;
+            offset=el->context.i_trun_sample_pos;
+            time=el->i_time;
+        }
+        for (unsigned i=start;i<et->i_sample_count;i++) {
+            size=et->i_flags&MP4_TRUN_SAMPLE_SIZE ? et->p_samples[i].i_size :
+                er->ambient_fel_source?er->ambient_fel_size:el->context.i_default_sample_size;
+            uint32_t dur=et->i_flags&MP4_TRUN_SAMPLE_DURATION ? et->p_samples[i].i_duration :
+                er->ambient_fel_source?er->ambient_fel_duration:el->context.i_default_sample_duration;
+            if (!size || !dur || size>AMBIENT_FEL_MAX_AU || size>UINT64_MAX-offset ||
+                time>INT64_MAX-dur || time>dts) return NULL;
+            if (time==dts) {
+                int64_t cts=MP4_FEL_CompositionOffset(et,i);
+                if (!ambient_fel_fragment_timing(time,cts,dur,dts,pts,duration)) return NULL;
+                el->context.runs.i_current=run;
+                el->context.i_trun_sample=i+1;
+                el->context.i_trun_sample_pos=offset+size;
+                el->i_time=time+dur;
+                source=er->ambient_fel_source;
+                matched=true;
+                break;
+            }
+            offset+=size;time+=dur;
+        }
+    }
+    const bool separate=s->context.ambient_fel_el_moof!=NULL && el->ambient_fel_separate;
+    const bool retained=source&&source!=UINT_MAX;
+    if (!matched || !size || size>AMBIENT_FEL_MAX_AU) return NULL;
+    if(retained){
+        if(source>s->ambient_fel_replay_count||
+           !ambient_fel_payload_contains(s->ambient_fel_replay[source-1].extents,
+              s->ambient_fel_replay[source-1].count,offset,size))return NULL;
+    }else if(!MP4_FEL_PayloadContains(s,separate,offset,size))return NULL;
+    if (s->context.ambient_fel_mdat) {
+        block_t *enh=retained?MP4_FEL_ReadRanges(s->ambient_fel_replay[source-1].extents,
+            s->ambient_fel_replay[source-1].mixed_el?s->context.ambient_fel_el_cache:
+            s->ambient_fel_replay[source-1].cache,s->ambient_fel_replay[source-1].count,offset,size):
+            MP4_FEL_ReadCached(s,separate,offset,size);
+        if (!enh) return NULL;
+        block_t *merged=MP4_FEL_MergeBlocks(bl,el,base,enh);
+        block_Release(enh);
+        return merged;
+    }
+    if (!s->b_seekable) return NULL;
+    // Restore the BL stream position before the normal trun loop continues.
+    uint64_t resume=vlc_stream_Tell(d->s);
+    block_t *enh=NULL,*merged=NULL;
+    if (MP4_FEL_SeekExact(d->s,offset)) enh=MP4_FEL_ReadExact(d->s,offset,size);
+    if (enh) merged=MP4_FEL_MergeBlocks(bl,el,base,enh);
+    if (enh) block_Release(enh);
+    if (!MP4_FEL_SeekExact(d->s,resume)) {
+        s->b_error=true;
+        if (merged) block_Release(merged);
+        return NULL;
+    }
+    return merged;
+}
