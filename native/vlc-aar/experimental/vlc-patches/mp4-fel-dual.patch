+static struct ambient_fel_android_bridge *MP4_FEL_AndroidOpen(demux_t *d)
+{
+    char *name=var_InheritString(d,"mp4-ambient-metadata-socket");
+    if(!name)return NULL;
+    bool valid=strlen(name)==44&&!memcmp(name,"ambient-fel-",12);
+    for(unsigned i=12;valid&&i<44;i++)
+        valid=(name[i]>='0'&&name[i]<='9')||(name[i]>='a'&&name[i]<='f');
+    if(!valid){free(name);return NULL;}
+    struct ambient_fel_android_bridge *a=calloc(1,sizeof(*a));
+    if(!a){free(name);return NULL;}
+    a->address.sun_family=AF_UNIX;
+    memcpy(a->address.sun_path+1,name,44);
+    a->address_len=offsetof(struct sockaddr_un,sun_path)+45;
+    free(name);
+    if(pthread_mutex_init(&a->mutex,NULL)){free(a);return NULL;}
+    if(pthread_cond_init(&a->ready,NULL)){pthread_mutex_destroy(&a->mutex);free(a);return NULL;}
+    if(pthread_create(&a->thread,NULL,MP4_FEL_AndroidWorker,a)){
+        pthread_cond_destroy(&a->ready);pthread_mutex_destroy(&a->mutex);free(a);return NULL;
+    }
+    return a;
+}
+
+static void MP4_FEL_AndroidClearLocked(struct ambient_fel_android_bridge *a)
+{
+    while(a->count){
+        block_Release(a->queue[a->head].block);
+        a->queue[a->head].block=NULL;a->head=(a->head+1)%64;--a->count;
+    }
+    a->bytes=0;
+}
+
+static struct ambient_fel_android_bridge *MP4_FEL_AndroidEnsure(demux_t *d)
+{
+    demux_sys_t *s=d->p_sys;
+    if(!s->ambient_fel_android_checked){
+        s->ambient_fel_android_checked=true;
+        s->ambient_fel_android=MP4_FEL_AndroidOpen(d);
+    }
+    return s->ambient_fel_android;
+}
+
+static void MP4_FEL_AndroidSeek(demux_t *d)
+{
+    /* A seek before the first timed box still retires epoch zero. */
+    struct ambient_fel_android_bridge *a=MP4_FEL_AndroidEnsure(d);
+    if(!a)return;
+    pthread_mutex_lock(&a->mutex);
+    MP4_FEL_AndroidClearLocked(a);++a->epoch;
+    a->barrier_pending=true;
+    pthread_cond_signal(&a->ready);
+    pthread_mutex_unlock(&a->mutex);
+}
+
+static void MP4_FEL_AndroidClose(demux_sys_t *s)
+{
+    struct ambient_fel_android_bridge *a=s->ambient_fel_android;
+    if(!a)return;
+    pthread_mutex_lock(&a->mutex);
+    a->closing=true;MP4_FEL_AndroidClearLocked(a);
+    pthread_cond_signal(&a->ready);pthread_mutex_unlock(&a->mutex);
+    pthread_join(a->thread,NULL);
+    pthread_cond_destroy(&a->ready);pthread_mutex_destroy(&a->mutex);
+    free(a);s->ambient_fel_android=NULL;
+}
+
+static void MP4_FEL_AndroidSend(demux_t *d,const block_t *b,unsigned kind)
+{
+    struct ambient_fel_android_bridge *a=MP4_FEL_AndroidEnsure(d);
+    if(!a||b->i_buffer>1024u*1024u||pthread_mutex_trylock(&a->mutex))return;
+    if(!a->closing&&a->count<64&&b->i_buffer<=4u*1024u*1024u-a->bytes){
+        block_t *copy=block_Duplicate(b);
+        if(copy){
+            unsigned i=(a->head+a->count)%64;
+            a->queue[i].block=copy;a->queue[i].kind=kind;a->queue[i].epoch=a->epoch;
+            ++a->count;a->bytes+=copy->i_buffer;
+            pthread_cond_signal(&a->ready);
+        }
+    }
+    pthread_mutex_unlock(&a->mutex);
+}
+#else
+static void MP4_FEL_AndroidSeek(demux_t *d){(void)d;}
+static void MP4_FEL_AndroidClose(demux_sys_t *s){(void)s;}
+static void MP4_FEL_AndroidSend(demux_t *d,const block_t *b,unsigned kind){(void)d;(void)b;(void)kind;}
+#endif
