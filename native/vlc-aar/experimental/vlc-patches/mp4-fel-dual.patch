+/* Scan only as far as the final referenced byte. Padding is legal
+ * between physical mdats, but never skip another timed/unknown box. */
+static bool MP4_FEL_ScanMdats(demux_t *d,struct ambient_fel_byte_range *ranges,
+    unsigned *count,uint64_t *last_end,uint64_t required,uint64_t *padding,unsigned *boxes)
+{
+    unsigned n=0;
+    uint64_t end=0;
+    do{
+        uint64_t start;
+        if(n==AMBIENT_FEL_MAX_MDAT_BOXES||
+           !MP4_FEL_SkipGap(d,padding,boxes,true)||
+           !MP4_FEL_PeekBox(d->s,ATOM_mdat,&start,&end)||start>=end||
+           !MP4_FEL_SeekExact(d->s,end))return false;
+        ranges[n++]=(struct ambient_fel_byte_range){start,end};
+    }while(end<required);
+    *count=n;*last_end=end;
+    return true;
+}
