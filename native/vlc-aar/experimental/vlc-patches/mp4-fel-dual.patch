+static bool MP4_FEL_ParseTimedBox(demux_t *d,uint32_t type,const uint8_t *p,size_t n,
+    uint64_t pos,uint64_t end,vlc_tick_t *pts,vlc_tick_t *duration,bool *relative)
+{
+    demux_sys_t *s=d->p_sys;
+    if(n<4||p[0]>1)return false;
+    unsigned version=p[0];p+=4;n-=4;
+    *duration=0;*relative=false;
+    if(type==VLC_FOURCC('s','i','d','x')){
+        // Keep all direct leaves and pending child-index references.
+        // On a forward-only stream children are parsed as encountered;
+        // their exact physical offset and rational clocks must match.
+        unsigned fixed=version?28:20;
+        if(n<fixed)return false;
+        uint32_t track=GetDWBE(p),scale=GetDWBE(p+4);
+        uint64_t earliest=version?GetQWBE(p+8):GetDWBE(p+8);
+        uint64_t offset=version?GetQWBE(p+16):GetDWBE(p+12);
+        unsigned count=GetWBE(p+fixed-2);
+        if(!track||!scale||!count||count>(256-s->ambient_fel_sidx_count)||
+           n!=fixed+12u*count||offset>UINT64_MAX-end||
+           !MP4_FEL_MetaTicks(earliest,scale,pts))return false;
+        unsigned depth=0,parent=UINT_MAX;
+        for(unsigned i=0;i<s->ambient_fel_sidx_count;i++){
+            if(!s->ambient_fel_sidx[i].index||s->ambient_fel_sidx[i].start!=pos)continue;
+            if(parent!=UINT_MAX||s->ambient_fel_sidx[i].seen||
+               s->ambient_fel_sidx[i].end<end||s->ambient_fel_sidx[i].track!=track)return false;
+            int64_t mapped;
+            if(earliest>INT64_MAX||s->ambient_fel_sidx[i].time>INT64_MAX||
+               !ambient_fel_rescale_exact(earliest,scale,s->ambient_fel_sidx[i].scale,&mapped)||
+               (uint64_t)mapped!=s->ambient_fel_sidx[i].time)return false;
+            depth=s->ambient_fel_sidx[i].depth+1;parent=i;
+        }
+        if(depth>8)return false;
+        uint64_t cursor=end+offset,time=earliest,total_duration=0,stream_size=0;
+        bool size_known=vlc_stream_GetSize(d->s,&stream_size)==VLC_SUCCESS;
+        unsigned base=s->ambient_fel_sidx_count;
+        for(unsigned i=0;i<count;i++){
+            const uint8_t *r=p+fixed+12*i;
+            uint32_t ref=GetDWBE(r),size=ref&0x7fffffffu,dur=GetDWBE(r+4);
+            if(!size||!dur||size>UINT64_MAX-cursor||dur>UINT64_MAX-time||
+               (size_known&&cursor+size>stream_size))return false;
+            unsigned j=base+i;
+            s->ambient_fel_sidx[j].start=cursor;s->ambient_fel_sidx[j].end=cursor+size;
+            s->ambient_fel_sidx[j].time=time;s->ambient_fel_sidx[j].duration=dur;
+            s->ambient_fel_sidx[j].scale=scale;s->ambient_fel_sidx[j].track=track;
+            s->ambient_fel_sidx[j].index=(ref>>31)!=0;
+            s->ambient_fel_sidx[j].depth=depth;s->ambient_fel_sidx[j].seen=false;
+            cursor+=size;time+=dur;total_duration+=dur;
+        }
+        if(parent!=UINT_MAX){
+            int64_t mapped;
+            if(total_duration>INT64_MAX||
+               !ambient_fel_rescale_exact(total_duration,scale,s->ambient_fel_sidx[parent].scale,&mapped)||
+               (uint64_t)mapped!=s->ambient_fel_sidx[parent].duration)return false;
+            s->ambient_fel_sidx[parent].seen=true;
+        }
+        s->ambient_fel_sidx_count=base+count;
+        return true;
+    }
+    if(type==VLC_FOURCC('p','r','f','t')){
+        if(n!=(version?20u:16u))return false;
+        const mp4_track_t *track=MP4_GetTrackByTrackID(d,GetDWBE(p));
+        if(!track)return false;
+        return MP4_FEL_MetaTicks(version?GetQWBE(p+12):GetDWBE(p+12),track->i_timescale,pts);
+    }
+    if(type!=VLC_FOURCC('e','m','s','g'))return false;
+    uint32_t scale,span;
+    uint64_t time;
+    if(version){
+        if(n<20)return false;
+        scale=GetDWBE(p);time=GetQWBE(p+4);span=GetDWBE(p+12);
+        p+=20;n-=20;
+        if(!MP4_FEL_MetaString(&p,&n)||!MP4_FEL_MetaString(&p,&n))return false;
+    }else{
+        if(!MP4_FEL_MetaString(&p,&n)||!MP4_FEL_MetaString(&p,&n)||n<16)return false;
+        scale=GetDWBE(p);time=GetDWBE(p+4);span=GetDWBE(p+8);
+    }
+    if(!MP4_FEL_MetaTicks(time,scale,pts)||
+       (span!=UINT32_MAX&&!MP4_FEL_MetaTicks(span,scale,duration)))return false;
+    if(!version){
+        *relative=true;
+        vlc_tick_t anchor=0;
+        for(unsigned i=0;i<s->ambient_fel_sidx_count;i++){
+            if(s->ambient_fel_sidx[i].index||pos<s->ambient_fel_sidx[i].start||
+               end>s->ambient_fel_sidx[i].end)continue;
+            vlc_tick_t candidate;
+            if(!MP4_FEL_MetaTicks(s->ambient_fel_sidx[i].time,s->ambient_fel_sidx[i].scale,&candidate)||
+               (!*relative&&anchor!=candidate))return false;
+            anchor=candidate;*relative=false;
+        }
+        if(!*relative){
+            if(*pts>VLC_TICK_MAX-VLC_TICK_0-anchor)return false;
+            *pts+=anchor;
+        }
+    }
+    return *duration<=VLC_TICK_MAX-VLC_TICK_0-*pts;
+}
+
+static bool MP4_FEL_MetaBudget(const demux_sys_t *s,uint64_t size)
+{
+    return s->ambient_fel_meta_boxes<64&&size<=1024u*1024u&&
+           size<=4u*1024u*1024u-s->ambient_fel_meta_bytes;
+}
+
+/* Takes ownership of block on every path. */
+static bool MP4_FEL_QueueTimedBox(demux_t *d,uint32_t type,block_t *block,
+    uint64_t pos,uint64_t payload,uint64_t end)
+{
+    demux_sys_t *s=d->p_sys;
+    if(payload<pos||end<payload||end-pos!=block->i_buffer||!MP4_FEL_MetaBudget(s,end-pos)){
+        block_Release(block);return false;
+    }
+    const bool index=type==VLC_FOURCC('s','i','d','x');
+    vlc_tick_t pts,duration;bool relative;
+    if(!MP4_FEL_ParseTimedBox(d,type,block->p_buffer+(payload-pos),end-payload,
+         pos,end,&pts,&duration,&relative)){block_Release(block);return false;}
+    s->ambient_fel_meta_bytes+=end-pos;++s->ambient_fel_meta_boxes;
+    if(index){block_Release(block);return true;}
+    block->i_pts=block->i_dts=VLC_TICK_0+pts;
+    block->i_length=duration;
+    unsigned i=s->ambient_fel_meta_count++;
+    // Stable timestamp ordering, irrespective of physical box order.
+    while(i&&s->ambient_fel_meta[i-1].block->i_pts>block->i_pts){
+        s->ambient_fel_meta[i]=s->ambient_fel_meta[i-1];--i;
+    }
+    s->ambient_fel_meta[i].block=block;
+    s->ambient_fel_meta[i].kind=type==VLC_FOURCC('e','m','s','g')?0:1;
+    s->ambient_fel_meta[i].relative=relative;s->ambient_fel_meta[i].pos=pos;
+    return true;
+}
+
+static bool MP4_FEL_CollectTimedBox(demux_t *d,uint32_t type)
+{
+    demux_sys_t *s=d->p_sys;
+    uint64_t pos=vlc_stream_Tell(d->s),payload,end;
+    if(!MP4_FEL_PeekBox(d->s,type,&payload,&end)||!MP4_FEL_MetaBudget(s,end-pos))return false;
+    block_t *block=MP4_FEL_ReadExact(d->s,pos,end-pos);
+    return block&&MP4_FEL_QueueTimedBox(d,type,block,pos,payload,end);
+}
+
+/* libmp4 retains bounded raw emsg/prft payloads in moof/traf children.
+ * Reconstruct the original header including extended-size form. */
+static bool MP4_FEL_CollectNested(demux_t *d,const MP4_Box_t *parent,unsigned depth)
+{
+    if(!parent||depth>8)return false;
+    demux_sys_t *s=d->p_sys;
+    for(const MP4_Box_t *box=parent->p_first;box;box=box->p_next){
+        if(box->i_type==VLC_FOURCC('e','m','s','g')||box->i_type==VLC_FOURCC('p','r','f','t')){
+            unsigned header=box->i_shortsize==1?16:8;
+            if(box->i_size<header||box->i_size>UINT64_MAX-box->i_pos||
+               !MP4_FEL_MetaBudget(s,box->i_size)||!box->data.p_binary||
+               box->data.p_binary->i_blob!=box->i_size-header||
+               !box->data.p_binary->p_blob)return false;
+            block_t *b=block_Alloc(box->i_size);
+            if(!b)return false;
+            SetDWBE(b->p_buffer,header==16?1:box->i_size);
+            memcpy(b->p_buffer+4,&box->i_type,4);
+            if(header==16)SetQWBE(b->p_buffer+8,box->i_size);
+            memcpy(b->p_buffer+header,box->data.p_binary->p_blob,box->i_size-header);
+            if(!MP4_FEL_QueueTimedBox(d,box->i_type,b,box->i_pos,box->i_pos+header,
+                 box->i_pos+box->i_size))return false;
+        }else if(box->i_type==ATOM_traf||box->i_type==ATOM_moof){
+            if(!MP4_FEL_CollectNested(d,box,depth+1))return false;
+        }
+    }
+    return true;
+}
+
+/* Consume explicitly inert padding and, during FEL lookahead only,
+ * preserve supported timed metadata. Unknown boxes stop the scan. */
+static bool MP4_FEL_SkipGap(demux_t *d,uint64_t *bytes,unsigned *count,bool allow_empty_mdat)
+{
+    demux_sys_t *s=d->p_sys;
+    for(;;){
+        const uint8_t *b;
+        if(vlc_stream_Peek(d->s,&b,8)!=8)return false;
+        uint32_t type=VLC_FOURCC(b[4],b[5],b[6],b[7]);
+        if(s->ambient_fel_collect_meta&&(type==VLC_FOURCC('e','m','s','g')||
+            type==VLC_FOURCC('p','r','f','t')||type==VLC_FOURCC('s','i','d','x'))){
+            if(!MP4_FEL_CollectTimedBox(d,type))return false;
+            continue;
+        }
+        bool empty_candidate=allow_empty_mdat&&type==ATOM_mdat;
+        if(type!=VLC_FOURCC('f','r','e','e') && type!=VLC_FOURCC('s','k','i','p') &&
+           !empty_candidate)return true;
+        uint64_t pos=vlc_stream_Tell(d->s),payload,end;
+        if(!MP4_FEL_PeekBox(d->s,type,&payload,&end))return false;
+        // Empty bounded mdats reference no media bytes. Never skip a
+        // nonempty mdat, even if its data are not referenced by this moof.
+        if(empty_candidate&&payload!=end)return true;
+        if(!ambient_fel_padding_budget(bytes,count,end-pos))return false;
+        if(s->b_seekable){
+            if(MP4_Seek(d->s,end)!=VLC_SUCCESS)return false;
+        }else if(vlc_stream_Read(d->s,NULL,(size_t)(end-pos))!=(ssize_t)(end-pos))
+            return false;
+        if(vlc_stream_Tell(d->s)!=end)return false;
+    }
+}
+
+static bool MP4_FEL_SkipPadding(demux_t *d,uint64_t *bytes,unsigned *count)
+{
+    return MP4_FEL_SkipGap(d,bytes,count,false);
+}
+
+/* A separate EL segment may carry its own ISO-BMFF segment type box.
+ * It declares brands, not media time or sample offsets. Consume only one
+ * structurally valid styp, with the same combined bound as inert padding.
+ * Timed metadata is collected separately by SkipGap during lookahead. */
+static bool MP4_FEL_SkipSegmentHeader(demux_t *d,uint64_t *bytes,unsigned *count)
+{
+    if(!MP4_FEL_SkipGap(d,bytes,count,true))return false;
+    const uint8_t *b;
+    if(vlc_stream_Peek(d->s,&b,8)!=8)return false;
+    const uint32_t type=VLC_FOURCC('s','t','y','p');
+    if(VLC_FOURCC(b[4],b[5],b[6],b[7])!=type)return true;
+    uint64_t pos=vlc_stream_Tell(d->s),payload,end;
+    if(!MP4_FEL_PeekBox(d->s,type,&payload,&end)||
+       end-payload<8||(end-payload-8)%4||
+       !ambient_fel_padding_budget(bytes,count,end-pos))return false;
+    if(((demux_sys_t *)d->p_sys)->b_seekable){
+        if(MP4_Seek(d->s,end)!=VLC_SUCCESS)return false;
+    }else if(vlc_stream_Read(d->s,NULL,(size_t)(end-pos))!=(ssize_t)(end-pos))
+        return false;
+    return vlc_stream_Tell(d->s)==end&&MP4_FEL_SkipGap(d,bytes,count,true);
+}
+
+static void MP4_FEL_ClearReplay(demux_sys_t *s)
+{
+    for(unsigned i=0;i<sizeof(s->ambient_fel_replay)/sizeof(s->ambient_fel_replay[0]);i++){
+        if(s->ambient_fel_replay[i].moof)MP4_BoxFree(s->ambient_fel_replay[i].moof);
+        for(unsigned j=0;j<AMBIENT_FEL_MAX_MDAT_BOXES;j++)
+            if(s->ambient_fel_replay[i].cache[j])block_Release(s->ambient_fel_replay[i].cache[j]);
+    }
+    memset(s->ambient_fel_replay,0,sizeof(s->ambient_fel_replay));
+    s->ambient_fel_replay_count=0;
+    s->ambient_fel_replay_end=0;s->ambient_fel_replay_sequence=0;
+    for(unsigned i=0;i<s->ambient_fel_meta_count;i++)
+        if(s->ambient_fel_meta[i].block)block_Release(s->ambient_fel_meta[i].block);
+    memset(s->ambient_fel_meta,0,sizeof(s->ambient_fel_meta));
+    s->ambient_fel_meta_count=s->ambient_fel_meta_next=s->ambient_fel_meta_boxes=0;
+    s->ambient_fel_meta_bytes=0;s->ambient_fel_sidx_count=0;
+    s->ambient_fel_meta_seek_floor=0;
+    s->ambient_fel_collect_meta=false;
+}
+
+/* Classify independent, dependent, additional BL and mixed BL/EL sources. */
+static int MP4_FEL_LookaheadKind(demux_t *d,const MP4_Box_t *moof)
+{
+    bool independent=false,hidden=false,base=false;
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type!=ATOM_traf)continue;
+        const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+        if(!tfhd||!tfhd->data.p_tfhd)return -1;
+        const mp4_track_t *t=MP4_GetTrackByTrackID(d,tfhd->data.p_tfhd->i_track_ID);
+        if(!t)return -1;
+        base|=t->ambient_fel_el_id!=0;
+        hidden|=t->ambient_fel_hidden;
+        independent|=!t->ambient_fel_hidden&&!t->ambient_fel_el_id;
+    }
+    if(base)return hidden?4:3;
+    return hidden?(independent?2:1):independent?0:-1;
+}
+
+/* Count actual samples, not trun or moof boundaries. The BL establishes
+ * the required count for each dependent track. A split EL is complete
+ * only when every required track has reached its exact count. */
+struct ambient_fel_layer_count { unsigned id; uint64_t remaining; };
+static bool MP4_FEL_TrafSamples(const MP4_Box_t *traf,uint64_t *samples)
+{
+    *samples=0;
+    for(const MP4_Box_t *b=traf->p_first;b;b=b->p_next){
+        if(b->i_type!=ATOM_trun)continue;
+        if(!b->data.p_trun||b->data.p_trun->i_sample_count>1048576-*samples)return false;
+        *samples+=b->data.p_trun->i_sample_count;
+    }
+    return *samples!=0;
+}
+
+static bool MP4_FEL_LayerCounts(demux_t *d,const MP4_Box_t *moof,
+    struct ambient_fel_layer_count *counts,unsigned *n,bool dependent,bool extend,bool *complete)
+{
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type!=ATOM_traf)continue;
+        const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+        if(!tfhd||!tfhd->data.p_tfhd)return false;
+        const mp4_track_t *t=MP4_GetTrackByTrackID(d,tfhd->data.p_tfhd->i_track_ID);
+        if(!t)return false;
+        if(dependent?!t->ambient_fel_hidden:!t->ambient_fel_el_id)continue;
+        uint64_t samples;
+        if(!MP4_FEL_TrafSamples(traf,&samples))return false;
+        if(!dependent){
+            if(extend){
+                unsigned i=0;
+                while(i<*n&&counts[i].id!=t->ambient_fel_el_id)++i;
+                if(i==*n||samples>1048576-counts[i].remaining)return false;
+                counts[i].remaining+=samples;
+            }else{
+                if(*n>=256)return false;
+                counts[(*n)++]=(struct ambient_fel_layer_count){t->ambient_fel_el_id,samples};
+            }
+        }else if(*n){
+            unsigned i=0;
+            while(i<*n&&counts[i].id!=t->i_track_ID)++i;
+            if(i==*n||samples>counts[i].remaining)return false;
+            counts[i].remaining-=samples;
+        }
+    }
+    *complete=true;
+    for(unsigned i=0;i<*n;i++)if(counts[i].remaining)*complete=false;
+    return true;
+}
+
+/* Dolby dual-track fragmented carriage: BL moof/mdat followed by an
+ * EL-only moof/mdat, optionally separated by padding and a segment type box. Retain the
+ * second tree while its trun pointers are live. Seekable inputs restore
+ * BL position; forward-only inputs use one combined memory budget. */
+static bool MP4_FEL_Lookahead(demux_t *d,const MP4_Box_t *bl)
+{
+    demux_sys_t *s=d->p_sys;
+    if(s->context.ambient_fel_el_moof||s->context.ambient_fel_mdat||
+       s->context.ambient_fel_el_mdat||s->ambient_fel_replay_count)return false;
+    uint64_t resume=vlc_stream_Tell(d->s),bp,be,mp,me,ep,ee;
+    if(bl->i_size>UINT64_MAX-bl->i_pos||bl->i_pos+bl->i_size!=resume)return false;
+    MP4_Box_t *root=NULL,*el=NULL;
+    uint64_t padding=0,total=0;
+    unsigned boxes=0;
+    bool ok=false;
+    s->ambient_fel_collect_meta=true;
+    if(!MP4_FEL_SkipPadding(d,&padding,&boxes))goto done;
+    if(s->b_seekable){
+        if(!MP4_FEL_ScanMdats(d,s->context.ambient_fel_bl_extents,
+            &s->context.ambient_fel_bl_extent_count,&be,s->context.ambient_fel_required_end,&padding,&boxes))goto done;
+    }else{
+        if(!MP4_FEL_BufferMdats(d,s->context.ambient_fel_bl_extents,
+            s->context.ambient_fel_bl_cache,&s->context.ambient_fel_bl_extent_count,
+            &be,&total,s->context.ambient_fel_required_end,&padding,&boxes))goto done;
+    }
+    bp=s->context.ambient_fel_bl_extents[0].start;
+    const MP4_Box_t *bm=MP4_BoxGet(bl,"mfhd");
+    if(!bm||!bm->data.p_mfhd)goto done;
+    uint32_t sequence=bm->data.p_mfhd->i_sequence_number;
+    uint64_t headers=0,group_runs=0,group_samples=0,bl_required;
+    struct ambient_fel_layer_count counts[256];unsigned layers=0,aux=0,split=0,extra_bl=0;
+    bool complete=false;
+    if(!MP4_FEL_PreflightBudget(d,bl,&bl_required,&group_runs,&group_samples)||
+       !MP4_FEL_LayerCounts(d,bl,counts,&layers,false,false,&complete))goto done;
+    for(;;){
+        if(!MP4_FEL_SkipSegmentHeader(d,&padding,&boxes))goto done;
+        const uint64_t pos=vlc_stream_Tell(d->s);
+        if(!MP4_FEL_PeekBox(d->s,ATOM_moof,&mp,&me)||
+           me-pos>16u*1024u*1024u-headers)goto done;
+        headers+=me-pos;
+        root=MP4_BoxGetNextChunk(d->s);
+        if(!root)goto done;
+        el=MP4_BoxExtract(&root->p_first,ATOM_moof);
+        const MP4_Box_t *em=el?MP4_BoxGet(el,"mfhd"):NULL;
+        if(!el||el->i_pos!=pos||el->i_size!=me-pos||vlc_stream_Tell(d->s)!=me||
+           !em||!em->data.p_mfhd||em->data.p_mfhd->i_sequence_number!=sequence+1u||
+           !MP4_BoxCount(el,"traf")||MP4_BoxCount(el,"traf")>256||
+           !MP4_FEL_CollectNested(d,el,0)||!MP4_FEL_SkipPadding(d,&padding,&boxes))goto done;
+        sequence=em->data.p_mfhd->i_sequence_number;
+        uint64_t required;
+        if(!MP4_FEL_PreflightBudget(d,el,&required,&group_runs,&group_samples))goto done;
+        int kind=MP4_FEL_LookaheadKind(d,el);
+        if(kind<0)goto done;
+        if(kind>=3){
+            if(!layers||!MP4_FEL_LayerCounts(d,el,counts,&layers,false,true,&complete))goto done;
+        }
+        if((kind==1||kind==2||kind==4)&&
+           !MP4_FEL_LayerCounts(d,el,counts,&layers,true,false,&complete))goto done;
+        if((kind==1||kind==2||kind==4)&&complete){
+            if(s->b_seekable){
+                if(!MP4_FEL_ScanMdats(d,s->context.ambient_fel_el_extents,
+                    &s->context.ambient_fel_el_extent_count,&ee,required,&padding,&boxes))goto done;
+            }else if(!MP4_FEL_BufferMdats(d,s->context.ambient_fel_el_extents,
+                s->context.ambient_fel_el_cache,&s->context.ambient_fel_el_extent_count,
+                &ee,&total,required,&padding,&boxes))goto done;
+            if(kind==2||kind==4){
+                if(s->ambient_fel_replay_count>=sizeof(s->ambient_fel_replay)/sizeof(s->ambient_fel_replay[0]))goto done;
+                unsigned i=s->ambient_fel_replay_count++;
+                s->ambient_fel_replay[i].mixed_el=true;
+                s->ambient_fel_replay[i].contains_el=true;
+                s->ambient_fel_replay[i].contains_bl=kind==4;
+                s->ambient_fel_replay[i].sequence=sequence;
+                s->ambient_fel_replay[i].count=s->context.ambient_fel_el_extent_count;
+                s->ambient_fel_replay[i].end=ee;
+                memcpy(s->ambient_fel_replay[i].extents,s->context.ambient_fel_el_extents,
+                    s->context.ambient_fel_el_extent_count*sizeof(s->context.ambient_fel_el_extents[0]));
+            }
+            break;
+        }
+        unsigned i=s->ambient_fel_replay_count;
+        if(i>=sizeof(s->ambient_fel_replay)/sizeof(s->ambient_fel_replay[0])-1||
+           (kind>=3?++extra_bl>8:kind>0?++split>8:++aux>8))goto done;
+        s->ambient_fel_replay[i].contains_el=kind==1||kind==2||kind==4;
+        s->ambient_fel_replay[i].contains_bl=kind>=3;
+        if(s->b_seekable){
+            if(!MP4_FEL_ScanMdats(d,s->ambient_fel_replay[i].extents,
+                &s->ambient_fel_replay[i].count,&s->ambient_fel_replay[i].end,
+                required,&padding,&boxes))goto done;
+        }else if(!MP4_FEL_BufferMdats(d,s->ambient_fel_replay[i].extents,
+            s->ambient_fel_replay[i].cache,&s->ambient_fel_replay[i].count,
+            &s->ambient_fel_replay[i].end,&total,required,&padding,&boxes))goto done;
+        s->ambient_fel_replay[i].moof=el;el=NULL;
+        s->ambient_fel_replay[i].sequence=sequence;
+        ++s->ambient_fel_replay_count;
+        MP4_BoxFree(root);root=NULL;
+    }
+    if(s->ambient_fel_replay_count){
+        s->ambient_fel_replay_end=ee;s->ambient_fel_replay_sequence=sequence;
+    }
+    ep=s->context.ambient_fel_el_extents[0].start;
+    ok=true;
+done:
+    s->ambient_fel_collect_meta=false;
+    if(root)MP4_BoxFree(root);
+    if(s->b_seekable && !MP4_FEL_SeekExact(d->s,resume)){s->b_error=true;ok=false;}
+    if(!ok){
+        s->context.ambient_fel_bl_extent_count=s->context.ambient_fel_el_extent_count=0;
+        if(el)MP4_BoxFree(el);
+        MP4_FEL_ReleaseCaches(s);
+        MP4_FEL_ClearReplay(s);
+        if(!s->b_seekable)s->b_error=true;
+        return false;
+    }
+    if(!s->b_seekable){
+        s->context.ambient_fel_mdat=true;
+        s->context.ambient_fel_mdat_start=bp;
+        s->context.i_post_mdat_offset=be;
+        s->context.ambient_fel_el_mdat=true;
+    }
+    s->context.ambient_fel_el_moof=el;
+    s->context.ambient_fel_el_start=ep;s->context.ambient_fel_el_end=ee;
+    return true;
+}
