+/* Index the separate EL traf in its OWN moof coordinate system.
+ * The ordinary VLC BL index must not be reset by a second index pass. */
+static bool MP4_FEL_IndexSeparate(demux_t *d,mp4_track_t *el,const MP4_Box_t *traf,
+    uint64_t implicit_base,uint64_t *traf_end,struct ambient_fel_byte_range *ranges,
+    size_t *used,size_t capacity,uint64_t *total_samples,unsigned source)
+{
+    demux_sys_t *s=d->p_sys;
+    if(source>s->ambient_fel_replay_count)return false;
+    const MP4_Box_t *moof=source&&!s->ambient_fel_replay[source-1].mixed_el?
+        s->ambient_fel_replay[source-1].moof:s->context.ambient_fel_el_moof;
+    const struct ambient_fel_byte_range *extents=source?s->ambient_fel_replay[source-1].extents:
+        s->context.ambient_fel_el_extents;
+    const unsigned extent_count=source?s->ambient_fel_replay[source-1].count:s->context.ambient_fel_el_extent_count;
+    if(!moof||!extent_count)return false;
+    const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+    if(!tfhd||!tfhd->data.p_tfhd||el->context.runs.i_count)return false;
+    const MP4_Box_data_tfhd_t *header=tfhd->data.p_tfhd;
+    if(header->i_track_ID!=el->i_track_ID)return false;
+    unsigned n=MP4_BoxCount(traf,"trun");
+    if(!n||n>capacity-*used)return false;
+    mp4_run_t *runs=calloc(n,sizeof(*runs));
+    if(!runs)return false;
+    uint32_t ds=0,dd=0;
+    MP4_GetDefaultSizeAndDuration(s->p_moov,header,&ds,&dd);
+    uint64_t base=(header->i_flags&MP4_TFHD_BASE_DATA_OFFSET)?
+        header->i_base_data_offset:
+        (header->i_flags&MP4_TFHD_DEFAULT_BASE_IS_MOOF)?moof->i_pos:implicit_base;
+    uint64_t offset=base,previous_end=0,samples=*total_samples;
+    stime_t time=el->i_time;
+    unsigned j=0;
+    for(const MP4_Box_t *box=traf->p_first;box;box=box->p_next){
+        if(box->i_type!=ATOM_trun)continue;
+        const MP4_Box_data_trun_t *tr=box->data.p_trun;
+        if(j>=n||!tr||!tr->i_sample_count||tr->i_sample_count>1048576-samples||
+           ((tr->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_SIZE|
+                          MP4_TRUN_SAMPLE_TIME_OFFSET))&&!tr->p_samples))goto fail;
+        if(tr->i_flags&MP4_TRUN_DATA_OFFSET){
+            if(!ambient_fel_trun_offset(base,tr->i_data_offset,&offset))goto fail;
+        }
+        /* With no trun offset the first sample starts at the proven tfhd
+         * base (or previous traf end); all bytes must fit the EL mdat. */
+        if(j&&offset<previous_end)goto fail;
+        runs[j++]=(mp4_run_t){.i_offset=offset,.i_first_dts=time,.p_trun=box};
+        for(unsigned i=0;i<tr->i_sample_count;i++){
+            uint32_t bytes=tr->i_flags&MP4_TRUN_SAMPLE_SIZE?tr->p_samples[i].i_size:ds;
+            uint32_t dur=tr->i_flags&MP4_TRUN_SAMPLE_DURATION?tr->p_samples[i].i_duration:dd;
+            if(time<0||!dur||time>INT64_MAX-dur||
+               !bytes||bytes>AMBIENT_FEL_MAX_AU||
+               !ambient_fel_payload_contains(extents,extent_count,offset,bytes))goto fail;
+            time+=dur;offset+=bytes;
+        }
+        if(!ambient_fel_payload_contains(extents,extent_count,runs[j-1].i_offset,offset-runs[j-1].i_offset))goto fail;
+        ranges[(*used)++]=(struct ambient_fel_byte_range){runs[j-1].i_offset,offset};
+        previous_end=offset;samples+=tr->i_sample_count;
+    }
+    if(j!=n)goto fail;
+    free(el->context.runs.p_array);
+    el->context.runs.p_array=runs;el->context.runs.i_count=n;
+    el->context.runs.i_current=0;
+    el->context.i_default_sample_size=ds;el->context.i_default_sample_duration=dd;
+    *traf_end=previous_end;*total_samples=samples;
+    return true;
+fail:
+    free(runs);return false;
+}
+
+/* Index each dependent source in its own coordinate system, and keep
+ * the original implicit bases for independent tracks in the same moof. */
+static bool MP4_FEL_IndexAdjacentSource(demux_t *d,const MP4_Box_t *moof,unsigned source)
+{
+    demux_sys_t *s=d->p_sys;
+    size_t capacity=0;
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type!=ATOM_traf)continue;
+        unsigned n=MP4_BoxCount(traf,"trun");
+        if(!n||n>65536-capacity)return false;
+        capacity+=n;
+    }
+    if(!capacity)return false;
+    struct ambient_fel_byte_range *ranges=calloc(capacity,sizeof(*ranges));
+    if(!ranges)return false;
+    size_t used=0;uint64_t total_samples=0,previous_end=moof->i_pos;
+    bool ok=false;
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type!=ATOM_traf)continue;
+        const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+        if(!tfhd||!tfhd->data.p_tfhd)goto done;
+        mp4_track_t *el=MP4_GetTrackByTrackID(d,tfhd->data.p_tfhd->i_track_ID);
+        if(!el)goto done;
+        if(el->ambient_fel_hidden||el->ambient_fel_el_id){
+            if(el->ambient_fel_hidden){
+                if(!el->ambient_fel_separate||(source&&!s->ambient_fel_replay[source-1].contains_el))goto done;
+            }else{
+                if(!source||!s->ambient_fel_replay[source-1].contains_bl||
+                   !el->ambient_fel_fragment_present||!el->context.runs.i_count)goto done;
+            }
+            unsigned old=el->context.runs.i_count;
+            stime_t start=el->i_time;
+            if(old){
+                const mp4_run_t *last=&el->context.runs.p_array[old-1];
+                const MP4_Box_data_trun_t *tr=last->p_trun->data.p_trun;
+                start=last->i_first_dts;
+                for(unsigned j=0;j<tr->i_sample_count;j++){
+                    uint32_t dur=tr->i_flags&MP4_TRUN_SAMPLE_DURATION?tr->p_samples[j].i_duration:
+                        last->ambient_fel_source?last->ambient_fel_duration:el->context.i_default_sample_duration;
+                    if(start<0||!dur||start>INT64_MAX-dur)goto done;
+                    start+=dur;
+                }
+            }
+            const MP4_Box_t *tfdt=MP4_BoxGet(traf,"tfdt");
+            if(tfdt&&(!tfdt->data.p_tfdt||tfdt->data.p_tfdt->i_base_media_decode_time!=(uint64_t)start))goto done;
+            mp4_track_t temp={.i_track_ID=el->i_track_ID,.i_time=start};
+            if(!MP4_FEL_IndexSeparate(d,&temp,traf,previous_end,&previous_end,
+                 ranges,&used,capacity,&total_samples,source))goto done;
+            unsigned n=temp.context.runs.i_count;
+            if(old>65536-n){free(temp.context.runs.p_array);goto done;}
+            // Terminal EL uses source zero only when no earlier EL runs
+            // exist; otherwise it needs an explicit source/default tag.
+            unsigned tag=source;
+            if(!tag&&old)tag=UINT_MAX;
+            for(unsigned j=0;j<n;j++){
+                mp4_run_t *r=&temp.context.runs.p_array[j];
+                r->ambient_fel_source=tag;
+                r->ambient_fel_size=temp.context.i_default_sample_size;
+                r->ambient_fel_duration=temp.context.i_default_sample_duration;
+            }
+            mp4_run_t *merged=realloc(el->context.runs.p_array,(old+n)*sizeof(*merged));
+            if(!merged){free(temp.context.runs.p_array);goto done;}
+            memcpy(merged+old,temp.context.runs.p_array,n*sizeof(*merged));
+            free(temp.context.runs.p_array);
+            el->context.runs.p_array=merged;el->context.runs.i_count=old+n;
+            if(!old){
+                el->context.i_default_sample_size=temp.context.i_default_sample_size;
+                el->context.i_default_sample_duration=temp.context.i_default_sample_duration;
+            }
+        }else{
+            const unsigned last=s->ambient_fel_replay_count;
+            if(!source&&(!last||!s->ambient_fel_replay[last-1].mixed_el))goto done;
+            MP4_Box_data_tfhd_t *header=tfhd->data.p_tfhd;
+            const uint64_t base=(header->i_flags&MP4_TFHD_BASE_DATA_OFFSET)?
+                header->i_base_data_offset:(header->i_flags&MP4_TFHD_DEFAULT_BASE_IS_MOOF)?
+                moof->i_pos:previous_end;
+            // Validate without replacing the live BL-side audio index.
+            mp4_track_t temp={.i_track_ID=el->i_track_ID};
+            if(!MP4_FEL_IndexSeparate(d,&temp,traf,previous_end,&previous_end,
+                ranges,&used,capacity,&total_samples,source))goto done;
+            free(temp.context.runs.p_array);
+            header->i_flags=(header->i_flags&~MP4_TFHD_DEFAULT_BASE_IS_MOOF)|MP4_TFHD_BASE_DATA_OFFSET;
+            header->i_base_data_offset=base;
+        }
+    }
+    ok=used==capacity&&ambient_fel_ranges_disjoint(ranges,used);
+done:
+    free(ranges);return ok;
+}
+
+static bool MP4_FEL_IndexAdjacent(demux_t *d)
+{
+    demux_sys_t *s=d->p_sys;
+    for(unsigned i=0;i<s->ambient_fel_replay_count;i++)
+        if((s->ambient_fel_replay[i].contains_el||s->ambient_fel_replay[i].contains_bl)&&
+           !s->ambient_fel_replay[i].mixed_el&&
+           !MP4_FEL_IndexAdjacentSource(d,s->ambient_fel_replay[i].moof,i+1))return false;
+    const unsigned last=s->ambient_fel_replay_count;
+    const unsigned source=last&&s->ambient_fel_replay[last-1].mixed_el&&
+        s->ambient_fel_replay[last-1].contains_bl?last:0;
+    return MP4_FEL_IndexAdjacentSource(d,s->context.ambient_fel_el_moof,source);
+}
+
+static bool MP4_FEL_FirstELTime(demux_sys_t *s,unsigned id,bool *present,
+    const MP4_Box_data_tfdt_t **time)
+{
+    for(unsigned i=0;i<s->ambient_fel_replay_count;i++){
+        if(!s->ambient_fel_replay[i].contains_el||s->ambient_fel_replay[i].mixed_el)continue;
+        if(!MP4_FEL_FragmentTime(s->ambient_fel_replay[i].moof,id,present,time))return false;
+        if(*present)return true;
+    }
+    return MP4_FEL_FragmentTime(s->context.ambient_fel_el_moof,id,present,time);
+}
+
+/* Reject oversized generic-indexer runs BEFORE its uint32_t size
+ * accumulator or pointer arithmetic can wrap. All trafs in a paired
+ * moof participate in implicit offsets, including audio. */
+/* Validate all indexed runs in the physical BL mdat, not merely the
+ * selected video samples. Separate EL runs were checked in their own
+ * mdat by IndexAdjacent. Reject cross-track aliasing before decoding. */
+static bool MP4_FEL_ValidatePayloads(const demux_sys_t *s)
+{
+    uint64_t start=s->context.ambient_fel_mdat_start,end=s->context.i_post_mdat_offset;
+    if(start>=end)return false;
+    size_t count=0;
+    for(unsigned i=0;i<s->i_tracks;i++){
+        const mp4_track_t *t=&s->track[i];
+        if(t->ambient_fel_separate)continue;
+        if(t->context.runs.i_count>65536-count ||
+           (t->context.runs.i_count&&!t->context.runs.p_array))return false;
+        count+=t->context.runs.i_count;
+    }
+    if(!count)return true;
+    struct ambient_fel_byte_range *ranges=calloc(count,sizeof(*ranges));
+    if(!ranges)return false;
+    size_t used=0;uint64_t samples=0;
+    bool ok=false;
+    for(unsigned i=0;i<s->i_tracks;i++){
+        const mp4_track_t *t=&s->track[i];
+        if(t->ambient_fel_separate)continue;
+        for(unsigned j=0;j<t->context.runs.i_count;j++){
+            const mp4_run_t *r=&t->context.runs.p_array[j];
+            if(r->ambient_fel_source)continue; /* already proven in its source */
+            const MP4_Box_data_trun_t *tr=r->p_trun?r->p_trun->data.p_trun:NULL;
+            if(!tr||tr->i_sample_count>1048576-samples ||
+               ((tr->i_flags&MP4_TRUN_SAMPLE_SIZE)&&!tr->p_samples))goto done;
+            uint64_t pos=r->i_offset,bytes=0;
+            for(unsigned k=0;k<tr->i_sample_count;k++){
+                uint32_t size=tr->i_flags&MP4_TRUN_SAMPLE_SIZE?
+                    tr->p_samples[k].i_size:t->context.i_default_sample_size;
+                if(!ambient_fel_run_add(&bytes,size))goto done;
+            }
+            samples+=tr->i_sample_count;
+            if(!bytes)continue; /* Empty auxiliary runs reference no data. */
+            if(!MP4_FEL_PayloadContains(s,false,pos,bytes))goto done;
+            ranges[used++]=(struct ambient_fel_byte_range){pos,pos+bytes};
+        }
+    }
+    ok=!used||ambient_fel_ranges_disjoint(ranges,used);
+done:
+    free(ranges);return ok;
+}
