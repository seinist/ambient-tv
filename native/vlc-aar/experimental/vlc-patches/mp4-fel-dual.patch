+            !ambient_fel_hvcc_length(bc->data.p_binary->p_blob,bc->data.p_binary->i_blob) ||
+            !ambient_fel_hvcc_length(ec->data.p_binary->p_blob,ec->data.p_binary->i_blob))
+            continue;
