+/* Read an exact top-level box at the current stream position without
+ * consuming it. Size zero is not a bounded fragment. */
+static bool MP4_FEL_PeekBox(stream_t *stream,uint32_t type,uint64_t *payload,uint64_t *end)
+{
+    const uint8_t *b;
+    uint64_t pos=vlc_stream_Tell(stream);
+    if(vlc_stream_Peek(stream,&b,8)!=8 ||
+        VLC_FOURCC(b[4],b[5],b[6],b[7])!=type)return false;
+    uint64_t size=GetDWBE(b);
+    unsigned header=8;
+    if(size==1){
+        if(vlc_stream_Peek(stream,&b,16)!=16)return false;
+        size=GetQWBE(b+8);header=16;
+    }
+    if(!ambient_fel_box_extent(pos,size,header,payload,end))return false;
+    uint64_t total;
+    return vlc_stream_GetSize(stream,&total)!=VLC_SUCCESS || *end<=total;
+}
+
+/* Preflight exact physical offsets using the same ISO-BMFF rules as
+ * the strict fragment indexer. A finite required end avoids waiting
+ * for a subsequent box header after the last referenced payload. */
+static bool MP4_FEL_PreflightMoof(demux_t *d,const MP4_Box_t *moof,uint64_t *required)
+{
+    demux_sys_t *s=d->p_sys;
+    if(!moof||!required||moof->i_size>UINT64_MAX-moof->i_pos)return false;
+    const uint64_t moof_end=moof->i_pos+moof->i_size;
+    uint64_t samples=0,runs=0,previous_traf=moof->i_pos;
+    uint32_t track_ids[256];
+    unsigned tracks=0,headers=0;
+    *required=moof_end;
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type==ATOM_mfhd){
+            if(++headers>1||!traf->data.p_mfhd)return false;
+        }
+        if(traf->i_type!=ATOM_traf)continue;
+        /* VLC stores one set of default sample values per track. A
+         * duplicate traf could overwrite the defaults for earlier runs. */
+        const MP4_Box_t *tfhd=NULL,*tfdt=NULL;
+        for(const MP4_Box_t *box=traf->p_first;box;box=box->p_next){
+            if(box->i_type==ATOM_tfhd){
+                if(tfhd||!box->data.p_tfhd)return false;
+                tfhd=box;
+            }else if(box->i_type==ATOM_tfdt){
+                if(tfdt||!box->data.p_tfdt)return false;
+                tfdt=box;
+            }
+        }
+        if(!tfhd||tracks==sizeof(track_ids)/sizeof(track_ids[0]))return false;
+        const MP4_Box_data_tfhd_t *header=tfhd->data.p_tfhd;
+        if(!header->i_track_ID||!MP4_GetTrackByTrackID(d,header->i_track_ID))return false;
+        for(unsigned j=0;j<tracks;j++)
+            if(track_ids[j]==header->i_track_ID)return false;
+        track_ids[tracks++]=header->i_track_ID;
+        uint32_t ds=0,dd=0;
+        MP4_GetDefaultSizeAndDuration(s->p_moov,header,&ds,&dd);
+        const uint64_t base=(header->i_flags&MP4_TFHD_BASE_DATA_OFFSET)?
+            header->i_base_data_offset:(header->i_flags&MP4_TFHD_DEFAULT_BASE_IS_MOOF)?
+            moof->i_pos:previous_traf;
+        uint64_t offset=base,previous_bytes=0;
+        bool have_run=false;
+        for(const MP4_Box_t *box=traf->p_first;box;box=box->p_next){
+            if(box->i_type!=ATOM_trun)continue;
+            const MP4_Box_data_trun_t *tr=box->data.p_trun;
+            if(++runs>65536||!tr||tr->i_sample_count>1048576-samples||
+               ((tr->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_SIZE|
+                              MP4_TRUN_SAMPLE_TIME_OFFSET))&&!tr->p_samples))return false;
+            if(!ambient_fel_run_offset(base,offset,(uint32_t)previous_bytes,
+                (tr->i_flags&MP4_TRUN_DATA_OFFSET)!=0,tr->i_data_offset,&offset))return false;
+            uint64_t bytes=0;
+            for(unsigned i=0;i<tr->i_sample_count;i++){
+                uint32_t size=tr->i_flags&MP4_TRUN_SAMPLE_SIZE?tr->p_samples[i].i_size:ds;
+                if(!ambient_fel_run_add(&bytes,size))return false;
+            }
+            if(!ambient_fel_required_end(required,moof_end,offset,bytes))return false;
+            previous_bytes=bytes;have_run=true;samples+=tr->i_sample_count;
+        }
+        if(have_run)previous_traf=offset+previous_bytes;
+    }
+    return true;
+}
+
+static bool MP4_FEL_SkipPadding(demux_t *,uint64_t *,unsigned *);
+static bool MP4_FEL_SkipGap(demux_t *,uint64_t *,unsigned *,bool);
+
+/* Scan only as far as the final referenced byte. Padding is legal
+ * between physical mdats, but never skip another timed/unknown box. */
+static bool MP4_FEL_ScanMdats(demux_t *d,struct ambient_fel_byte_range *ranges,
+    unsigned *count,uint64_t *last_end,uint64_t required,uint64_t *padding,unsigned *boxes)
+{
+    unsigned n=0;
+    uint64_t end=0;
+    do{
+        uint64_t start;
+        if(n==AMBIENT_FEL_MAX_MDAT_BOXES||
+           !MP4_FEL_SkipGap(d,padding,boxes,true)||
+           !MP4_FEL_PeekBox(d->s,ATOM_mdat,&start,&end)||start>=end||
+           !MP4_FEL_SeekExact(d->s,end))return false;
+        ranges[n++]=(struct ambient_fel_byte_range){start,end};
+    }while(end<required);
+    *count=n;*last_end=end;
+    return true;
+}
+
+/* Every buffer belongs to exactly one physical payload. Clear partial
+ * acquisitions too, irrespective of the published extent count. */
+static void MP4_FEL_ReleaseCaches(demux_sys_t *s)
+{
+    for(unsigned i=0;i<AMBIENT_FEL_MAX_MDAT_BOXES;i++){
+        if(s->context.ambient_fel_bl_cache[i])block_Release(s->context.ambient_fel_bl_cache[i]);
+        if(s->context.ambient_fel_el_cache[i])block_Release(s->context.ambient_fel_el_cache[i]);
+        s->context.ambient_fel_bl_cache[i]=s->context.ambient_fel_el_cache[i]=NULL;
+    }
+    s->context.ambient_fel_mdat=s->context.ambient_fel_el_mdat=false;
+}
+
+static bool MP4_FEL_BufferMdats(demux_t *d,struct ambient_fel_byte_range *ranges,
+    block_t **cache,unsigned *count,uint64_t *last_end,uint64_t *total,
+    uint64_t required,uint64_t *padding,unsigned *boxes)
+{
+    unsigned n=0;
+    uint64_t end=0;
+    do{
+        if(n==AMBIENT_FEL_MAX_MDAT_BOXES||cache[n]||
+           !MP4_FEL_SkipGap(d,padding,boxes,true))return false;
+        uint64_t pos=vlc_stream_Tell(d->s),start;
+        if(!MP4_FEL_PeekBox(d->s,ATOM_mdat,&start,&end)||
+           !ambient_fel_mdat_charge(total,end-start)||
+           vlc_stream_Read(d->s,NULL,start-pos)!=(ssize_t)(start-pos))return false;
+        cache[n]=vlc_stream_Block(d->s,(size_t)(end-start));
+        if(!cache[n]||cache[n]->i_buffer!=end-start||vlc_stream_Tell(d->s)!=end)return false;
+        ranges[n++]=(struct ambient_fel_byte_range){start,end};
+    }while(end<required);
+    *count=n;*last_end=end;
+    return true;
+}
+
+static bool MP4_FEL_PayloadContains(const demux_sys_t *s,bool separate,uint64_t pos,uint64_t bytes)
+{
+    const unsigned n=separate?s->context.ambient_fel_el_extent_count:
+        s->context.ambient_fel_bl_extent_count;
+    if(n)return ambient_fel_payload_contains(separate?s->context.ambient_fel_el_extents:
+        s->context.ambient_fel_bl_extents,n,pos,bytes);
+    uint64_t start=separate?s->context.ambient_fel_el_start:s->context.ambient_fel_mdat_start;
+    uint64_t end=separate?s->context.ambient_fel_el_end:s->context.i_post_mdat_offset;
+    return bytes&&pos>=start&&pos<end&&bytes<=end-pos;
+}
+
+/* Walk only explicitly inert top-level padding; never skip a timed
+ * fragment, event message, index, or unknown box. Account for all gaps
+ * using one combined bound, including on forward-only streams. */
+static bool MP4_FEL_SkipGap(demux_t *d,uint64_t *bytes,unsigned *count,bool allow_empty_mdat)
+{
+    demux_sys_t *s=d->p_sys;
+    for(;;){
+        const uint8_t *b;
+        if(vlc_stream_Peek(d->s,&b,8)!=8)return false;
+        uint32_t type=VLC_FOURCC(b[4],b[5],b[6],b[7]);
+        bool empty_candidate=allow_empty_mdat&&type==ATOM_mdat;
+        if(type!=VLC_FOURCC('f','r','e','e') && type!=VLC_FOURCC('s','k','i','p') &&
+           !empty_candidate)return true;
+        uint64_t pos=vlc_stream_Tell(d->s),payload,end;
+        if(!MP4_FEL_PeekBox(d->s,type,&payload,&end))return false;
+        // Empty bounded mdats reference no media bytes. Never skip a
+        // nonempty mdat, even if its data are not referenced by this moof.
+        if(empty_candidate&&payload!=end)return true;
+        if(!ambient_fel_padding_budget(bytes,count,end-pos))return false;
+        if(s->b_seekable){
+            if(MP4_Seek(d->s,end)!=VLC_SUCCESS)return false;
+        }else if(vlc_stream_Read(d->s,NULL,(size_t)(end-pos))!=(ssize_t)(end-pos))
+            return false;
+        if(vlc_stream_Tell(d->s)!=end)return false;
+    }
+}
+
+static bool MP4_FEL_SkipPadding(demux_t *d,uint64_t *bytes,unsigned *count)
+{
+    return MP4_FEL_SkipGap(d,bytes,count,false);
+}
+
+/* A separate EL segment may carry its own ISO-BMFF segment type box.
+ * It declares brands, not media time or sample offsets. Consume only one
+ * structurally valid styp, with the same combined bound as inert padding.
+ * Never consume sidx, emsg, prft or a timed fragment as padding. */
+static bool MP4_FEL_SkipSegmentHeader(demux_t *d,uint64_t *bytes,unsigned *count)
+{
+    if(!MP4_FEL_SkipGap(d,bytes,count,true))return false;
+    const uint8_t *b;
+    if(vlc_stream_Peek(d->s,&b,8)!=8)return false;
+    const uint32_t type=VLC_FOURCC('s','t','y','p');
+    if(VLC_FOURCC(b[4],b[5],b[6],b[7])!=type)return true;
+    uint64_t pos=vlc_stream_Tell(d->s),payload,end;
+    if(!MP4_FEL_PeekBox(d->s,type,&payload,&end)||
+       end-payload<8||(end-payload-8)%4||
+       !ambient_fel_padding_budget(bytes,count,end-pos))return false;
+    if(((demux_sys_t *)d->p_sys)->b_seekable){
+        if(MP4_Seek(d->s,end)!=VLC_SUCCESS)return false;
+    }else if(vlc_stream_Read(d->s,NULL,(size_t)(end-pos))!=(ssize_t)(end-pos))
+        return false;
+    return vlc_stream_Tell(d->s)==end&&MP4_FEL_SkipGap(d,bytes,count,true);
+}
+
+static void MP4_FEL_ClearReplay(demux_sys_t *s)
+{
+    for(unsigned i=0;i<sizeof(s->ambient_fel_replay)/sizeof(s->ambient_fel_replay[0]);i++){
+        if(s->ambient_fel_replay[i].moof)MP4_BoxFree(s->ambient_fel_replay[i].moof);
+        for(unsigned j=0;j<AMBIENT_FEL_MAX_MDAT_BOXES;j++)
+            if(s->ambient_fel_replay[i].cache[j])block_Release(s->ambient_fel_replay[i].cache[j]);
+    }
+    memset(s->ambient_fel_replay,0,sizeof(s->ambient_fel_replay));
+    s->ambient_fel_replay_count=s->ambient_fel_replay_next=0;
+    s->ambient_fel_replay_ready=s->ambient_fel_replay_active=false;
+    s->ambient_fel_replay_end=0;s->ambient_fel_replay_sequence=0;
+}
+
+/* A replayable intermediate contains only independent tracks. Never pass
+ * another paired BL, or a mixture of hidden EL and independent tracks,
+ * through this queue: that would change the layer pairing transaction. */
+static int MP4_FEL_LookaheadKind(demux_t *d,const MP4_Box_t *moof)
+{
+    bool independent=false,hidden=false;
+    for(const MP4_Box_t *traf=moof->p_first;traf;traf=traf->p_next){
+        if(traf->i_type!=ATOM_traf)continue;
+        const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+        if(!tfhd||!tfhd->data.p_tfhd)return -1;
+        const mp4_track_t *t=MP4_GetTrackByTrackID(d,tfhd->data.p_tfhd->i_track_ID);
+        if(!t||t->ambient_fel_el_id)return -1;
+        hidden|=t->ambient_fel_hidden;independent|=!t->ambient_fel_hidden;
+    }
+    return hidden==independent?-1:hidden?1:0;
+}
+
+/* Dolby dual-track fragmented carriage: BL moof/mdat followed by an
+ * EL-only moof/mdat, optionally separated by padding and a segment type box. Retain the
+ * second tree while its trun pointers are live. Seekable inputs restore
+ * BL position; forward-only inputs use one combined memory budget. */
+static bool MP4_FEL_Lookahead(demux_t *d,const MP4_Box_t *bl)
+{
+    demux_sys_t *s=d->p_sys;
+    if(s->context.ambient_fel_el_moof||s->context.ambient_fel_mdat||
+       s->context.ambient_fel_el_mdat||s->ambient_fel_replay_count)return false;
+    uint64_t resume=vlc_stream_Tell(d->s),bp,be,mp,me,ep,ee;
+    if(bl->i_size>UINT64_MAX-bl->i_pos||bl->i_pos+bl->i_size!=resume)return false;
+    MP4_Box_t *root=NULL,*el=NULL;
+    uint64_t padding=0,total=0;
+    unsigned boxes=0;
+    bool ok=false;
+    if(!MP4_FEL_SkipPadding(d,&padding,&boxes))goto done;
+    if(s->b_seekable){
+        if(!MP4_FEL_ScanMdats(d,s->context.ambient_fel_bl_extents,
+            &s->context.ambient_fel_bl_extent_count,&be,s->context.ambient_fel_required_end,&padding,&boxes))goto done;
+    }else{
+        if(!MP4_FEL_BufferMdats(d,s->context.ambient_fel_bl_extents,
+            s->context.ambient_fel_bl_cache,&s->context.ambient_fel_bl_extent_count,
+            &be,&total,s->context.ambient_fel_required_end,&padding,&boxes))goto done;
+    }
+    bp=s->context.ambient_fel_bl_extents[0].start;
+    const MP4_Box_t *bm=MP4_BoxGet(bl,"mfhd");
+    if(!bm||!bm->data.p_mfhd)goto done;
+    uint32_t sequence=bm->data.p_mfhd->i_sequence_number;
+    uint64_t headers=0;
+    for(;;){
+        if(!MP4_FEL_SkipSegmentHeader(d,&padding,&boxes))goto done;
+        const uint64_t pos=vlc_stream_Tell(d->s);
+        if(!MP4_FEL_PeekBox(d->s,ATOM_moof,&mp,&me)||
+           me-pos>16u*1024u*1024u-headers)goto done;
+        headers+=me-pos;
+        root=MP4_BoxGetNextChunk(d->s);
+        if(!root)goto done;
+        el=MP4_BoxExtract(&root->p_first,ATOM_moof);
+        const MP4_Box_t *em=el?MP4_BoxGet(el,"mfhd"):NULL;
+        if(!el||el->i_pos!=pos||el->i_size!=me-pos||vlc_stream_Tell(d->s)!=me||
+           !em||!em->data.p_mfhd||em->data.p_mfhd->i_sequence_number!=sequence+1u||
+           !MP4_BoxCount(el,"traf")||MP4_BoxCount(el,"traf")>256||
+           !MP4_FEL_SkipPadding(d,&padding,&boxes))goto done;
+        sequence=em->data.p_mfhd->i_sequence_number;
+        uint64_t required;
+        if(!MP4_FEL_PreflightMoof(d,el,&required))goto done;
+        int kind=MP4_FEL_LookaheadKind(d,el);
+        if(kind<0)goto done;
+        if(kind==1){
+            if(s->b_seekable){
+                if(!MP4_FEL_ScanMdats(d,s->context.ambient_fel_el_extents,
+                    &s->context.ambient_fel_el_extent_count,&ee,required,&padding,&boxes))goto done;
+            }else if(!MP4_FEL_BufferMdats(d,s->context.ambient_fel_el_extents,
+                s->context.ambient_fel_el_cache,&s->context.ambient_fel_el_extent_count,
+                &ee,&total,required,&padding,&boxes))goto done;
+            break;
+        }
+        unsigned i=s->ambient_fel_replay_count;
+        if(i==sizeof(s->ambient_fel_replay)/sizeof(s->ambient_fel_replay[0]))goto done;
+        if(s->b_seekable){
+            if(!MP4_FEL_ScanMdats(d,s->ambient_fel_replay[i].extents,
+                &s->ambient_fel_replay[i].count,&s->ambient_fel_replay[i].end,
+                required,&padding,&boxes))goto done;
+        }else if(!MP4_FEL_BufferMdats(d,s->ambient_fel_replay[i].extents,
+            s->ambient_fel_replay[i].cache,&s->ambient_fel_replay[i].count,
+            &s->ambient_fel_replay[i].end,&total,required,&padding,&boxes))goto done;
+        s->ambient_fel_replay[i].moof=el;el=NULL;
+        s->ambient_fel_replay[i].sequence=sequence;
+        ++s->ambient_fel_replay_count;
+        MP4_BoxFree(root);root=NULL;
+    }
+    if(s->ambient_fel_replay_count){
+        s->ambient_fel_replay_end=ee;s->ambient_fel_replay_sequence=sequence;
+    }
+    ep=s->context.ambient_fel_el_extents[0].start;
+    ok=true;
+done:
+    if(root)MP4_BoxFree(root);
+    if(s->b_seekable && !MP4_FEL_SeekExact(d->s,resume)){s->b_error=true;ok=false;}
+    if(!ok){
+        s->context.ambient_fel_bl_extent_count=s->context.ambient_fel_el_extent_count=0;
+        if(el)MP4_BoxFree(el);
+        MP4_FEL_ReleaseCaches(s);
+        MP4_FEL_ClearReplay(s);
+        if(!s->b_seekable)s->b_error=true;
+        return false;
+    }
+    if(!s->b_seekable){
+        s->context.ambient_fel_mdat=true;
+        s->context.ambient_fel_mdat_start=bp;
+        s->context.i_post_mdat_offset=be;
+        s->context.ambient_fel_el_mdat=true;
+    }
+    s->context.ambient_fel_el_moof=el;
+    s->context.ambient_fel_el_start=ep;s->context.ambient_fel_el_end=ee;
+    return true;
+}
+
+/* Index the separate EL traf in its OWN moof coordinate system.
+ * The ordinary VLC BL index must not be reset by a second index pass. */
+static bool MP4_FEL_IndexSeparate(demux_t *d,mp4_track_t *el,const MP4_Box_t *traf,
+    uint64_t implicit_base,uint64_t *traf_end,struct ambient_fel_byte_range *ranges,
+    size_t *used,size_t capacity,uint64_t *total_samples)
+{
+    demux_sys_t *s=d->p_sys;
+    const MP4_Box_t *moof=s->context.ambient_fel_el_moof;
+    const MP4_Box_t *tfhd=MP4_BoxGet(traf,"tfhd");
+    if(!tfhd||!tfhd->data.p_tfhd||el->context.runs.i_count)return false;
+    const MP4_Box_data_tfhd_t *header=tfhd->data.p_tfhd;
+    if(header->i_track_ID!=el->i_track_ID)return false;
+    unsigned n=MP4_BoxCount(traf,"trun");
+    if(!n||n>capacity-*used)return false;
+    mp4_run_t *runs=calloc(n,sizeof(*runs));
+    if(!runs)return false;
+    uint32_t ds=0,dd=0;
+    MP4_GetDefaultSizeAndDuration(s->p_moov,header,&ds,&dd);
+    uint64_t base=(header->i_flags&MP4_TFHD_BASE_DATA_OFFSET)?
+        header->i_base_data_offset:
+        (header->i_flags&MP4_TFHD_DEFAULT_BASE_IS_MOOF)?moof->i_pos:implicit_base;
+    uint64_t offset=base,previous_end=0,samples=*total_samples;
+    stime_t time=el->i_time;
+    unsigned j=0;
+    for(const MP4_Box_t *box=traf->p_first;box;box=box->p_next){
+        if(box->i_type!=ATOM_trun)continue;
+        const MP4_Box_data_trun_t *tr=box->data.p_trun;
+        if(j>=n||!tr||!tr->i_sample_count||tr->i_sample_count>1048576-samples||
+           ((tr->i_flags&(MP4_TRUN_SAMPLE_DURATION|MP4_TRUN_SAMPLE_SIZE|
+                          MP4_TRUN_SAMPLE_TIME_OFFSET))&&!tr->p_samples))goto fail;
+        if(tr->i_flags&MP4_TRUN_DATA_OFFSET){
+            if(!ambient_fel_trun_offset(base,tr->i_data_offset,&offset))goto fail;
+        }
+        /* With no trun offset the first sample starts at the proven tfhd
+         * base (or previous traf end); all bytes must fit the EL mdat. */
+        if(j&&offset<previous_end)goto fail;
+        runs[j++]=(mp4_run_t){.i_offset=offset,.i_first_dts=time,.p_trun=box};
+        for(unsigned i=0;i<tr->i_sample_count;i++){
+            uint32_t bytes=tr->i_flags&MP4_TRUN_SAMPLE_SIZE?tr->p_samples[i].i_size:ds;
+            uint32_t dur=tr->i_flags&MP4_TRUN_SAMPLE_DURATION?tr->p_samples[i].i_duration:dd;
+            if(time<0||!dur||time>INT64_MAX-dur||
+               !bytes||bytes>AMBIENT_FEL_MAX_AU||
+               !MP4_FEL_PayloadContains(s,true,offset,bytes))goto fail;
+            time+=dur;offset+=bytes;
+        }
+        if(!MP4_FEL_PayloadContains(s,true,runs[j-1].i_offset,offset-runs[j-1].i_offset))goto fail;
+        ranges[(*used)++]=(struct ambient_fel_byte_range){runs[j-1].i_offset,offset};
+        previous_end=offset;samples+=tr->i_sample_count;
+    }
+    if(j!=n)goto fail;
+    free(el->context.runs.p_array);
+    el->context.runs.p_array=runs;el->context.runs.i_count=n;
+    el->context.runs.i_current=0;
+    el->context.i_default_sample_size=ds;el->context.i_default_sample_duration=dd;
+    *traf_end=previous_end;*total_samples=samples;
+    return true;
+fail:
+    free(runs);return false;
+}
+
+/* Index all and only the declared separate dependent tracks. Reject any
+ * unpaired/duplicate traf or overlapping storage before delivering BL data.
+ * The run and sample budgets are shared across the entire adjacent moof. */
+static bool MP4_FEL_IndexAdjacent(demux_t *d)
+{
+    demux_sys_t *s=d->p_sys;
+    const MP4_Box_t *moof=s->context.ambient_fel_el_moof;
+    size_t capacity=0;
