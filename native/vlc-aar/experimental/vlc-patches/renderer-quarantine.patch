-static int UpdateSourceSAR(vout_display_t *, const video_format_t *);
+#include "vout_internal.h"
+
+/* Process-lifetime poison bit: do not hand a potentially still-owned
+ * Android GPU output to another decoder/renderer after uncertain teardown. */
+static atomic_bool ambient_output_quarantined = false;
+void vlc_ambient_output_quarantine(void)
+{
+    atomic_store(&ambient_output_quarantined, true);
+}
+bool vlc_ambient_output_quarantined(void)
+{
+    return atomic_load(&ambient_output_quarantined);
+}
+
+static int UpdateSourceSAR(vout_display_t *, const video_format_t *);
 
 /*****************************************************************************
  *
@@ -815,8 +827,15 @@
                                  const char *module,
                                  const vout_display_owner_t *owner)
 {
+    /* A timed-out driver can still own the previous Android window.
+     * Do not allow VLC's internal fallback to create a different output
+     * before the Java retirement gate has observed the quarantine. */
+    if (vlc_ambient_output_quarantined()) {
+        msg_Err(parent, "Video output quarantined until process restart");
+        return NULL;
+    }
     vout_display_priv_t *osys = vlc_custom_create(parent, sizeof (*osys),
                                                   "vout display");
     if (unlikely(osys == NULL))
         return NULL;
 
