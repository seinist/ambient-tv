-#include "vout_internal.h"
-
-static int UpdateSourceSAR(vout_display_t *, const video_format_t *);
+#include "vout_internal.h"
+
+/* Process-lifetime poison bit: do not hand a potentially still-owned
+ * Android GPU output to another decoder/renderer after uncertain teardown. */
+static atomic_bool ambient_output_quarantined = false;
+void vlc_ambient_output_quarantine(void)
+{
+    atomic_store(&ambient_output_quarantined, true);
+}
+bool vlc_ambient_output_quarantined(void)
+{
+    return atomic_load(&ambient_output_quarantined);
+}
+
+static int UpdateSourceSAR(vout_display_t *, const video_format_t *);
