     MediaCodecH264DecContext *s = avctx->priv_data;
@@ -335,6 +424,9 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         ret = common_set_extradata(avctx, format);
         if (ret < 0)
             goto done;
+        dv_mime = mediacodec_dolby_vision_mime(avctx, s, format);
+        if (dv_mime)
+            codec_mime = dv_mime;
         break;
 #endif
 #if CONFIG_H264_MEDIACODEC_DECODER
@@ -353,29 +445,9 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
