+#include <dlfcn.h>
+#include <stdatomic.h>
+/* Optional in-process PCM tap; no microphone or system-wide audio capture. */
+static void ambient_pcm_tap(int source, const void *data, size_t frames, int channels, int encoding)
+{
+    typedef void (*tap_fn)(int, const void *, size_t, int, int);
+    static _Atomic(tap_fn) cached;
+    static atomic_uint retry;
+    tap_fn tap = atomic_load_explicit(&cached, memory_order_acquire);
+    if (!tap && (atomic_fetch_add_explicit(&retry, 1, memory_order_relaxed) % 64 == 0)) {
+        void *lib = dlopen("libambientprojectm.so", RTLD_NOW | RTLD_NOLOAD);
+        if (lib) {
+            tap_fn found = (tap_fn)dlsym(lib, "ambient_projectm_pcm_v1");
+            tap_fn expected = NULL;
+            if (found && atomic_compare_exchange_strong_explicit(&cached, &expected, found,
+                    memory_order_acq_rel, memory_order_acquire)) {
+                /* Retain the winning handle for the lifetime of the published pointer. */
+                tap = found;
+            } else {
+                dlclose(lib);
+                tap = expected;
+            }
+        }
+    }
+    if (tap) tap(source, data, frames, channels, encoding);
+}
 
