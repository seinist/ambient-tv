+/*
+ * Describe the stream's colour to the decoder before configure(), like Kodi's
+ * CDVDVideoCodecAndroidMediaCodec::ConfigureMediaCodec. Decoders and the
+ * composer use these keys to tag the output dataspace; container-only HDR
+ * (mastering display / content light level in MKV or MP4) reaches the
+ * display only through KEY_HDR_STATIC_INFO. Unknown values stay unset.
+ */
+static void mediacodec_set_color_info(AVCodecContext *avctx, FFAMediaFormat *format)
+{
+    const AVPacketSideData *sd;
+    int standard = 0, transfer = 0;
+    int range = ff_AMediaFormatColorRange_from_AVColorRange(avctx->color_range);
+
+    switch (avctx->color_primaries) {
+    case AVCOL_PRI_BT709:  standard = COLOR_STANDARD_BT709;  break;
+    case AVCOL_PRI_BT2020: standard = COLOR_STANDARD_BT2020; break;
+    default: break;
+    }
+    switch (avctx->color_trc) {
+    case AVCOL_TRC_LINEAR:       transfer = COLOR_TRANSFER_LINEAR;    break;
+    case AVCOL_TRC_BT709:
+    case AVCOL_TRC_SMPTE170M:    transfer = COLOR_TRANSFER_SDR_VIDEO; break;
+    case AVCOL_TRC_SMPTE2084:    transfer = COLOR_TRANSFER_ST2084;    break;
+    case AVCOL_TRC_ARIB_STD_B67: transfer = COLOR_TRANSFER_HLG;       break;
+    default: break;
+    }
+    if (range)
+        ff_AMediaFormat_setInt32(format, "color-range", range);
+    if (standard)
+        ff_AMediaFormat_setInt32(format, "color-standard", standard);
+    if (transfer)
+        ff_AMediaFormat_setInt32(format, "color-transfer", transfer);
+
+    sd = av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
+                                 AV_PKT_DATA_MASTERING_DISPLAY_METADATA);
+    if (sd && sd->size >= sizeof(AVMasteringDisplayMetadata)) {
+        /* CTA-861.3 static metadata type 1: descriptor id, then 12 little-endian u16. */
+        const AVMasteringDisplayMetadata *mdm = (const void *)sd->data;
+        const AVPacketSideData *cll_sd;
+        uint8_t info[25] = { 0 };
+        uint16_t v[12] = { 0 };
+        if (mdm->has_primaries) {
+            /* Android's HDRStaticInfo::Type1 order: R, G, B, white (as FFmpeg stores them). */
+            for (int i = 0; i < 3; i++) {
+                v[2 * i]     = av_q2d(mdm->display_primaries[i][0]) * 50000 + 0.5;
+                v[2 * i + 1] = av_q2d(mdm->display_primaries[i][1]) * 50000 + 0.5;
+            }
+            v[6] = av_q2d(mdm->white_point[0]) * 50000 + 0.5;
+            v[7] = av_q2d(mdm->white_point[1]) * 50000 + 0.5;
+        }
+        if (mdm->has_luminance) {
+            v[8] = av_q2d(mdm->max_luminance) + 0.5;
+            v[9] = av_q2d(mdm->min_luminance) * 10000 + 0.5;
+        }
+        cll_sd = av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
+                                         AV_PKT_DATA_CONTENT_LIGHT_LEVEL);
+        if (cll_sd && cll_sd->size >= sizeof(AVContentLightMetadata)) {
+            const AVContentLightMetadata *cll = (const void *)cll_sd->data;
+            v[10] = FFMIN(cll->MaxCLL, 0xFFFF);
+            v[11] = FFMIN(cll->MaxFALL, 0xFFFF);
+        }
+        for (int i = 0; i < 12; i++)
+            AV_WL16(&info[1 + 2 * i], v[i]);
+        if (mdm->has_primaries || mdm->has_luminance)
+            ff_AMediaFormat_setBuffer(format, "hdr-static-info", info, sizeof(info));
+    }
+    av_log(avctx, AV_LOG_INFO, "MediaCodec colour info: range=%d standard=%d transfer=%d hdr-static-info=%s\n",
+           range, standard, transfer, sd ? "yes" : "no");
+}
+
