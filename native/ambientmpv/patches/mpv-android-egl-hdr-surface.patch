+// Ambient TV runtime marker: this libmpv tags its EGL window surface BT2020_PQ (read by
+// libambientmpv nativeFeatures). libmpv hides symbols by default, so export it explicitly.
+extern const int ambient_mpv_egl_hdr_surface;
+__attribute__((visibility("default"), used)) const int ambient_mpv_egl_hdr_surface = 1;
