 #include "libavutil/mem.h"
 #include "libavutil/opt.h"
 #include "libavutil/intreadwrite.h"
@@ -57,6 +58,7 @@
     int amlogic_mpeg2_api23_workaround;
 
     int use_ndk_codec;
+    int dolbyvision;
     // Ref. MediaFormat KEY_OPERATING_RATE
     int operating_rate;
 } MediaCodecH264DecContext;
@@ -351,6 +353,29 @@
         ret = hevc_set_extradata(avctx, format);
         if (ret < 0)
             goto done;
+        if (s->dolbyvision) {
+            const AVPacketSideData *sd = av_packet_side_data_get(
+                avctx->coded_side_data, avctx->nb_coded_side_data, AV_PKT_DATA_DOVI_CONF);
+            if (sd && sd->size >= sizeof(AVDOVIDecoderConfigurationRecord)) {
+                const AVDOVIDecoderConfigurationRecord *dv = (const void *)sd->data;
+                if (dv->rpu_present_flag && dv->bl_present_flag && !dv->el_present_flag &&
+                    (dv->dv_profile == 5 || dv->dv_profile == 8)) {
+                    codec_mime = "video/dolby-vision";
+                    ff_AMediaFormat_setInt32(format, "profile", 1 << dv->dv_profile);
+                    /* Supply the source cadence to the vendor DV decoder. Without
+                     * it Android may configure its default (30 fps) operating rate. */
+                    const double fps = av_q2d(avctx->framerate);
+                    if (fps > 0 && fps <= 240) {
+                        ff_AMediaFormat_setFloat(format, "frame-rate", fps);
+                        if (s->operating_rate <= 0)
+                            ff_AMediaFormat_setInt32(format, "operating-rate", (int)(fps + 0.999));
+                    }
+                    av_log(avctx, AV_LOG_INFO, "Dolby Vision source frame rate %.3f\n", fps);
+                    av_log(avctx, AV_LOG_INFO, "Dolby Vision decoder requested: profile=%d level=%d\n",
+                           dv->dv_profile, dv->dv_level);
+                }
+            }
+        }
         break;
 #endif
 #if CONFIG_MPEG2_MEDIACODEC_DECODER
