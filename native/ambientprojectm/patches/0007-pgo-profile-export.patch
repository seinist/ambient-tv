+#if defined(AMBIENT_PROJECTM_PGO_GENERATE)
+// Only instrumented developer builds expose the profile writer. Keep the
+// compiler runtime in the same DSO as the instrumented code.
+extern "C" void __llvm_profile_set_filename(const char*);
+extern "C" int __llvm_profile_write_file();
+
+extern "C" PROJECTM_EXPORT int ambient_projectm_write_profile(const char* path)
+{
+    if (!path || !*path) return -1;
+    __llvm_profile_set_filename(path);
+    return __llvm_profile_write_file();
+}
