 void Shader::CompileProgram(const std::string& vertexShaderSource,
                             const std::string& fragmentShaderSource)
 {
+#if defined(__ANDROID__) && defined(AMBIENT_PROJECTM_PROGRAM_CACHE)
+    const auto key = BinaryKey(vertexShaderSource, fragmentShaderSource);
+    ProgramCache::Probe cached;
+    if (!key.empty()) {
+        cached = BinaryCache().Find(key);
+        if (cached.binary) {
+            m_uniformLocations.clear();
+            glProgramBinary(m_shaderProgram, cached.binary->format, cached.binary->data.data(),
+                static_cast<GLsizei>(cached.binary->data.size()));
+            GLint linked = GL_FALSE;
+            glGetProgramiv(m_shaderProgram, GL_LINK_STATUS, &linked);
+            if (linked == GL_TRUE) return;
+            BinaryCache().Reject(key, cached.binary);
+        }
+        // Avoid paying extraction cost for one-off preset shaders. Only programs
+        // encountered again qualify, and each binary is bounded to 4 MiB.
+        if (cached.repeated)
+            glProgramParameteri(m_shaderProgram, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+    }
+#endif
     auto vertexShader = CompileShader(vertexShaderSource, GL_VERTEX_SHADER);
     auto fragmentShader = CompileShader(fragmentShaderSource, GL_FRAGMENT_SHADER);
 
