+void VideoEcho::UploadVertices()
+{
+#if defined(AMBIENT_PROJECTM_DIRECT_CLASSIC_COMPOSITE)
+    // The old first copy sampled (u, 1-v); the final copy reflected the output.
+    // Keep the original UVs in m_vertices for gamma redraws and echo orientation.
+    auto vertices = m_vertices;
+    for (auto& vertex : vertices) vertex.v = 1.0f - vertex.v;
+    glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizei>(sizeof(TexturedPoint) * vertices.size()), vertices.data(), GL_DYNAMIC_DRAW);
+#else
+    glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizei>(sizeof(TexturedPoint) * m_vertices.size()), m_vertices.data(), GL_DYNAMIC_DRAW);
+#endif
+}
