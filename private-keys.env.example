# Private builds only: copy to private-keys.env (git-ignored), fill in your own keys and build with
#   PRIVATE_KEYS=1 ./build.sh release
# The keys are compiled into the APK and the matching inputs disappear from Settings.
# Anyone with the APK can extract them: never publish or share such a build.
# Leave a value empty to keep asking for it in Settings.

# Spotify app (developer.spotify.com/dashboard) – Client ID
SPOTIFY_CLIENT_ID=
# Telegram application (my.telegram.org/apps) for Monogram – api_id (number) and api_hash (32 hex)
MONOGRAM_API_ID=
MONOGRAM_API_HASH=
# TMDB API key (trailers)
TMDB_API_KEY=
# fanart.tv personal API key (wide artist backgrounds)
FANART_API_KEY=
# OpenSubtitles.com API consumer key
OPENSUBTITLES_API_KEY=
