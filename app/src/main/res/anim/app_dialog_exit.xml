<?xml version="1.0" encoding="utf-8"?>
<!-- Normal mode: a gentle 2% shrink and fade around the centered dialog. The whole dialog
     window exits, so direct Save/Cancel callbacks also animate when their owner disappears. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="160" />
    <scale
        android:fromXScale="1.0" android:toXScale="0.98"
        android:fromYScale="1.0" android:toYScale="0.98"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="160" />
</set>
