<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="gamepad_settings_title">Controller</string>
    <string name="gamepad_settings_hint">Mit einem Spielecontroller navigieren und die Tasten belegen</string>
    <string name="gamepad_settings_explanation">Steuerkreuz und linker Stick bewegen die Auswahl wie die Pfeiltasten der Fernbedienung. Jede Taste kann in Menüs und im Player eine eigene Funktion haben, für kurzes Drücken und für Gedrückthalten.</string>
    <string name="gamepad_none_connected">Kein Controller verbunden.</string>
    <string name="gamepad_connected">Verbunden: %1$s</string>
    <string name="gamepad_last_button">Zuletzt gedrückt: %1$s – %2$s</string>
    <string name="gamepad_section_general">Allgemein</string>
    <string name="gamepad_enabled">Controller verwenden</string>
    <string name="gamepad_enabled_hint">Aus: Android belegt selbst nur wenige Tasten (Bestätigen und Zurück).</string>
    <string name="gamepad_confirm_button">Bestätigen mit</string>
    <string name="gamepad_confirm_button_hint">Tauscht Bestätigen und Zurück. Viele Controller im Nintendo-Stil bestätigen mit der rechten Taste.</string>
    <string name="gamepad_confirm_bottom">Untere Taste (A / ✕)</string>
    <string name="gamepad_confirm_right">Rechte Taste (B / ○)</string>
    <string name="gamepad_left_stick">Linker Stick bewegt die Auswahl</string>
    <string name="gamepad_left_stick_hint">Wie das Steuerkreuz; gehalten läuft die Auswahl weiter und wird schneller.</string>
    <string name="gamepad_right_stick">Rechter Stick blättert</string>
    <string name="gamepad_right_stick_hint">Hoch und runter blättern seitenweise; im Player spulen links und rechts zurück und vor.</string>
    <string name="gamepad_deadzone">Totzone der Sticks</string>
    <string name="gamepad_deadzone_hint">Wie weit ein Stick geneigt sein muss, bevor sich die Auswahl bewegt.</string>
    <string name="gamepad_deadzone_small">Klein (empfindlich)</string>
    <string name="gamepad_deadzone_medium">Mittel</string>
    <string name="gamepad_deadzone_large">Groß</string>
    <string name="gamepad_repeat">Wiederholtempo</string>
    <string name="gamepad_repeat_hint">Wie schnell die Auswahl weiterläuft, solange ein Stick geneigt bleibt.</string>
    <string name="gamepad_repeat_slow">Langsam</string>
    <string name="gamepad_repeat_normal">Normal</string>
    <string name="gamepad_repeat_fast">Schnell</string>
    <string name="gamepad_section_menus">Tasten in Menüs</string>
    <string name="gamepad_section_menus_hint">Gilt überall außerhalb des Vollbild-Players.</string>
