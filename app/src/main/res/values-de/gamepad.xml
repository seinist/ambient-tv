    <string name="gamepad_section_player">Tasten im Player</string>
    <string name="gamepad_section_player_hint">„Wie in Menüs“ übernimmt die Menü-Funktion der Taste.</string>
    <string name="gamepad_section_player_long">Tasten halten im Player</string>
    <string name="gamepad_section_long_hint">Hat eine Taste eine Funktion fürs Halten, löst sie ihre kurze Funktion beim Loslassen aus.</string>
