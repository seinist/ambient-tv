    <string name="gamepad_cmd_next">Next (title or channel)</string>
    <string name="gamepad_cmd_previous">Previous / from the start</string>
    <string name="gamepad_cmd_fast_forward">Fast forward</string>
    <string name="gamepad_cmd_rewind">Rewind</string>
    <string name="gamepad_cmd_volume_up">Volume up</string>
    <string name="gamepad_cmd_volume_down">Volume down</string>
