<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="gamepad_settings_title">Controller</string>
    <string name="gamepad_settings_hint">Navigate with a game controller and choose what its buttons do</string>
    <string name="gamepad_settings_explanation">The D-pad and the left stick move the selection like the arrow keys of the remote. Every button can have its own function in menus and in the player, for a short press and for holding it.</string>
    <string name="gamepad_none_connected">No controller connected.</string>
    <string name="gamepad_connected">Connected: %1$s</string>
    <string name="gamepad_last_button">Last pressed: %1$s – %2$s</string>
    <string name="gamepad_section_general">General</string>
    <string name="gamepad_enabled">Use controller</string>
    <string name="gamepad_enabled_hint">Off: Android only maps a few buttons on its own (confirm and back).</string>
    <string name="gamepad_confirm_button">Confirm with</string>
    <string name="gamepad_confirm_button_hint">Swaps the confirm and back buttons by position. On Nintendo controllers the right button is labelled A; choose it to confirm as on the Switch.</string>
    <string name="gamepad_confirm_bottom">Bottom button (Xbox A / ✕ / Nintendo B)</string>
    <string name="gamepad_confirm_right">Right button (Xbox B / ○ / Nintendo A)</string>
    <string name="gamepad_left_stick">Left stick moves the selection</string>
    <string name="gamepad_left_stick_hint">Like the D-pad; held, it keeps moving and gets faster.</string>
    <string name="gamepad_right_stick">Right stick scrolls</string>
    <string name="gamepad_right_stick_hint">Up and down scroll page by page; in the player, left and right wind back and forward.</string>
    <string name="gamepad_deadzone">Stick dead zone</string>
    <string name="gamepad_deadzone_hint">How far a stick has to lean before the selection moves.</string>
    <string name="gamepad_deadzone_small">Small (sensitive)</string>
    <string name="gamepad_deadzone_medium">Medium</string>
    <string name="gamepad_deadzone_large">Large</string>
    <string name="gamepad_repeat">Repeat speed</string>
    <string name="gamepad_repeat_hint">How fast the selection keeps moving while a stick stays leaned.</string>
    <string name="gamepad_repeat_slow">Slow</string>
    <string name="gamepad_repeat_normal">Normal</string>
    <string name="gamepad_repeat_fast">Fast</string>
    <string name="gamepad_section_menus">Buttons in menus</string>
    <string name="gamepad_section_menus_hint">Applies everywhere outside the fullscreen player.</string>
    <string name="gamepad_section_menus_long">Holding buttons in menus</string>
    <string name="gamepad_section_player">Buttons in the player</string>
    <string name="gamepad_section_player_hint">“As in menus” keeps the button’s menu function.</string>
    <string name="gamepad_section_player_long">Holding buttons in the player</string>
    <string name="gamepad_section_long_hint">A button with a function for holding it does its short function when released.</string>
    <string name="gamepad_reset">Reset all buttons</string>
    <string name="gamepad_cmd_none">Nothing</string>
    <string name="gamepad_cmd_inherit">As in menus</string>
    <string name="gamepad_cmd_confirm">Confirm (OK)</string>
