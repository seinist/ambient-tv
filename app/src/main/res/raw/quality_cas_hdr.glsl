//!HOOK LUMA
//!BIND HOOKED
//!BIND CAS_HDR_PQ_LUT
//!DESC FidelityFX Sharpening (HDR, single pass)

#define SOURCE_TRC 4 // 2 = PQ, 5 = HLG, 4 = BT.1886 (unused for HDR)
#define TARGET_TRC 4 // Must match SOURCE_TRC.
#define CUSTOM_GAMMA 2.2 // Unused; kept for the shared validation.
#define SHARPENING 0.0 // 0.0 to 1.0, as in the original CAS.
#define CAS_BLEND 1.0 // Fraction of the sharpened result (Light/Medium use less than 1.0).
#define LIMITED_RANGE 1 // 1 = 10-bit limited range (64..940) luma, 0 = full range.
#define FLAT_CODES 0.000244140625 // 0.25 of a 10-bit code: CAS cannot move such a pixel visibly.

const float RANGE_LO = 64.0 / 1023.0;
const float RANGE_SCALE = 876.0 / 1023.0;

float expandRange(float v) {
#if (LIMITED_RANGE == 1)
	return clamp((v - RANGE_LO) / RANGE_SCALE, 0.0, 1.0);
#else
	return clamp(v, 0.0, 1.0);
#endif
}

float compressRange(float v) {
#if (LIMITED_RANGE == 1)
	return v * RANGE_SCALE + RANGE_LO;
#else
	return v;
#endif
}

#if (SOURCE_TRC == 2)
float lutEntry(int index) {
	uvec4 b = uvec4(texelFetch(CAS_HDR_PQ_LUT, ivec2(index, 1 - LIMITED_RANGE), 0) * 255.0 + 0.5);
	return uintBitsToFloat(b.r | (b.g << 8u) | (b.b << 16u) | (b.a << 24u));
}
#endif

// Linear light (1.0 = 10000 cd/m2 for PQ) of a raw luma code.
float toLinear(float code) {
#if (SOURCE_TRC == 2)
	float x = clamp(code, 0.0, 1.0) * 1023.0;
	float base = min(floor(x), 1022.0);
	int i = int(base);
	return mix(lutEntry(i), lutEntry(i + 1), x - base);
#elif (SOURCE_TRC == 5)
	float v = expandRange(code);
	if (v <= 0.5) return v * v / 3.0;
	return (exp((v - 0.55991073) / 0.17883277) + 0.28466892) / 12.0;
#else
	return pow(expandRange(code), 2.4);
#endif
}

float fromLinear(float l) {
	l = clamp(l, 0.0, 1.0);
	float v;
#if (TARGET_TRC == 2)
	float p = pow(l, 0.159302);
	v = pow((0.835938 + 18.8516 * p) / (1.0 + 18.6875 * p), 78.8438);
#elif (TARGET_TRC == 5)
	v = l <= 1.0 / 12.0 ? sqrt(3.0 * l) : 0.17883277 * log(12.0 * l - 0.28466892) + 0.55991073;
#else
	v = pow(l, 1.0 / 2.4);
#endif
	return compressRange(clamp(v, 0.0, 1.0));
}

#define TAP(x, y) HOOKED_texOff(vec2(x, y)).r

vec4 hook() {
	//  a b c
	//  d e f
	//  g h i
	vec4 pix = HOOKED_tex(HOOKED_pos);
	float a = TAP(-1.0, -1.0);
	float b = TAP( 0.0, -1.0);
	float c = TAP( 1.0, -1.0);
	float d = TAP(-1.0,  0.0);
	float f = TAP( 1.0,  0.0);
	float g = TAP(-1.0,  1.0);
	float h = TAP( 0.0,  1.0);
	float i = TAP( 1.0,  1.0);
	float ec = pix.r;

	// Min/max on codes: the transfer is monotonic, so min/max commute with it.
	float diagMin = min(min(a, c), min(g, i));
	float diagMax = max(max(a, c), max(g, i));
	float crossMin = min(min(min(b, d), min(f, h)), ec);
	float crossMax = max(max(max(b, d), max(f, h)), ec);
	if (max(crossMax, diagMax) - min(crossMin, diagMin) <= FLAT_CODES) return pix;

	float lb = toLinear(b);
	float ld = toLinear(d);
	float le = toLinear(ec);
	float lf = toLinear(f);
	float lh = toLinear(h);

	// Soft min and max (CAS_BETTER_DIAGONALS), 2x scaled as in the original.
	float mnL = min(min(min(ld, le), min(lf, lb)), lh);
	float mxL = max(max(max(ld, le), max(lf, lb)), lh);
	mnL += min(mnL, toLinear(diagMin));
	mxL += max(mxL, toLinear(diagMax));

	// Exact (CAS_GO_SLOWER) math; the guard keeps pure black from dividing by zero.
	float ampL = clamp(min(mnL, 2.0 - mxL) / max(mxL, 1e-10), 0.0, 1.0);
	ampL = sqrt(ampL);
	float peak = -mix(8.0, 5.0, clamp(SHARPENING, 0.0, 1.0));
	float wL = ampL / peak;
	float sharpened = ((lb + ld + lf + lh) * wL + le) / (1.0 + 4.0 * wL);
	float outL = mix(le, max(sharpened, 0.0), float(CAS_BLEND));
	// Unchanged pixels keep their source code (no round trip, footroom/headroom intact).
	if (outL == le) return pix;
	pix.r = fromLinear(outL);
	return pix;
}
