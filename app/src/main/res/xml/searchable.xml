<?xml version="1.0" encoding="utf-8"?>
<!-- The authority is the release applicationId; builds with an applicationIdSuffix answer no system search. -->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/external_search_hint"
    android:searchSettingsDescription="@string/external_search_description"
    android:searchSuggestAuthority="com.ambient.tv.search"
    android:searchSuggestIntentAction="android.intent.action.VIEW"
    android:searchSuggestSelection=" ?"
    android:searchSuggestThreshold="2"
    android:includeInGlobalSearch="true"
    android:voiceSearchMode="showVoiceSearchButton|launchRecognizer" />
