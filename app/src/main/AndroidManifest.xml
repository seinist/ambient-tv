<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: playback, companion and "progress not saved" notifications on phones.
         Requested once by the handheld UI; TVs do not show the prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for the phone's pairing scanner, requested when that screen is opened. TVs have no camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- WireGuard .conf import from device/USB storage on TVs without a document picker.
         API 29-32 read access; API 30+ needs "All files access" because .conf is not a media file. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- Standby via Device Admin is optional; TVs without this feature remain installable. -->
    <uses-feature android:name="android.software.device_admin" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <!-- YouTube activation must open in a browser even when YouTube handles web links. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <!-- Lets WireGuard import detect whether a system document picker exists (often absent on TV). -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".AmbientTvApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/brand_banner"
        android:icon="@mipmap/brand_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AmbientTv"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="android.software.leanback.supports_touch"
            android:value="true" />

        <!-- Opt-in force-lock only; Android shows its own approval screen in Settings. -->
        <receiver
            android:name=".ui.player.SleepTimerDeviceAdminReceiver"
            android:label="@string/sleep_standby_admin_label"
            android:description="@string/sleep_standby_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/sleep_timer_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <service android:name=".companion.CompanionReceiverService" android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Live TV reminders: the alarm itself, and re-arming after a reboot or an update. -->
        <receiver android:name=".livetv.LiveTvReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".companion.CompanionReceiverBoot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".companion.CompanionRemotePlaybackService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".spotify.SpotifyPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".ui.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".vpn.WireGuardVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="WireGuard split tunnel for Plex and Jellyfin" />
        </service>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.AmbientTv">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/companion_shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ambienttv" android:host="pair" />
            </intent-filter>
            <!-- System search, voice search and the Assistant ("search for … / play … on Ambient TV"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/searchable" />
        </activity>

        <!-- "Send to TV" share entry for phones. A TV cannot send to itself, so the alias is disabled at
             startup on TV devices by CompanionShareTargets (manifest resources cannot vary by UI mode). -->
        <activity-alias
            android:name=".ui.ShareToTvActivity"
            android:targetActivity=".ui.MainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.mobile.HandheldActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AmbientTv" />

        <activity
            android:name=".spotify.SpotifyWebAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbientTv" />

        <activity
            android:name=".spotify.SpotifyAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.AmbientTv">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${spotifyRedirectScheme}" android:host="${spotifyRedirectHost}" />
            </intent-filter>
        </activity>

        <!-- Posters for the launcher rows (Watch Next / preview channels): read-only, opaque
             names, no credentials in any URI. -->
        <!-- Answers the Android TV system search with titles from Plex, Jellyfin and Emby. -->
        <provider
            android:name=".search.SearchSuggestionProvider"
            android:authorities="${applicationId}.search"
            android:exported="true"
            android:readPermission="android.permission.GLOBAL_SEARCH" />
        <provider
            android:name=".launcher.LauncherArtworkProvider"
            android:authorities="${applicationId}.launcherart"
            android:exported="true"
            android:grantUriPermissions="false" />
        <!-- Result of the in-app update's install session (status, confirmation, retry without profile). -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
