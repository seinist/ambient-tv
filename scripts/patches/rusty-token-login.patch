+/// Ambient TV: a failed sign-in (e.g. a rejected access token) is reported to the app's log.
+struct ForwardingLogger { inner: android_logger::AndroidLogger }
+
+impl log::Log for ForwardingLogger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool { self.inner.enabled(metadata) }
+    fn log(&self, record: &log::Record) {
+        self.inner.log(record);
+        if record.level() <= log::Level::Warn && self.inner.enabled(record.metadata()) {
+            forward_native_log(&format!("{} {}: {}", record.level(), record.target(), record.args()));
+        }
+    }
+    fn flush(&self) { self.inner.flush() }
+}
+
+/// Never logs itself (that would recurse through the logger).
+fn forward_native_log(message: &str) {
+    let (Some(java_vm), Some(service_class)) = (JAVA_VM.get(), SPOTIFY_SERVICE_CLASS.get()) else { return };
+    let Ok(mut env) = java_vm.attach_current_thread() else { return };
+    let Ok(text) = env.new_string(message) else { return };
+    let _ = env.call_static_method(service_class, "onNativeLog", "(Ljava/lang/String;)V", &[JValue::Object(&text)]);
+    if let Ok(true) = env.exception_check() { let _ = env.exception_clear(); }
+}
+
+fn send_native_session_error(message: &str) {
+    let (Some(java_vm), Some(service_class)) = (JAVA_VM.get(), SPOTIFY_SERVICE_CLASS.get()) else { return };
+    let Ok(mut env) = java_vm.attach_current_thread() else { return };
+    let Ok(text) = env.new_string(message) else { return };
+    if let Err(e) = env.call_static_method(service_class, "onNativeSessionError",
+        "(Ljava/lang/String;)V", &[JValue::Object(&text)]) {
+        error!("Failed to publish native session error to Android: {:?}", e);
+    }
+    if let Ok(true) = env.exception_check() {
+        let _ = env.exception_clear();
+    }
+}
