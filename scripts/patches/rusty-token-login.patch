+/// Ambient TV: signs the running receiver in with an OAuth access token (scope "streaming"),
+/// so the app plays natively without first being picked in a Spotify app.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_rusty_app_NativeBridge_loginWithAccessToken(
+    mut env: JNIEnv,
+    _class: JClass,
+    token_java: JString,
+) -> jni::sys::jboolean {
+    let token: String = match env.get_string(&token_java) {
+        Ok(value) => value.into(),
+        Err(e) => {
+            error!("loginWithAccessToken: failed to read token: {:?}", e);
+            return 0;
+        }
+    };
+    if token.is_empty() { return 0; }
+    match token_login_slot().lock().unwrap_or_else(|poison| poison.into_inner()).as_ref() {
+        Some(tx) if tx.send(token).is_ok() => 1,
+        _ => {
+            info!("loginWithAccessToken: no running receiver");
+            0
+        }
+    }
+}
