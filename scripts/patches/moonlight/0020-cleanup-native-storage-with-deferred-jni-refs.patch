+// Cleanup is serialized by common-c's joined renderer threads and native slot.
+ // If attachment fails, retain at most the three existing global refs until
+ // the Java-owned stop worker can delete them. No allocation is needed.
+static void releaseFrameRef(JNIEnv* env) {
+    DecodedFrameCapacity = 0;
+    if (env != NULL && DecodedFrameBuffer != NULL) {
+        (*env)->DeleteGlobalRef(env, DecodedFrameBuffer);
+        DecodedFrameBuffer = NULL;
+    }
+}
