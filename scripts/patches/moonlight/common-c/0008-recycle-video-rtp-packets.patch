+    LC_ASSERT(packetPoolCount == 0);
+    packetPoolSize = StreamConfig.packetSize + MAX_RTP_HEADER_SIZE + sizeof(RTPV_QUEUE_ENTRY);
+    pthread_mutex_unlock(&packetPoolLock);
 
