 // RTP packets use a 90 KHz presentation timestamp clock
-#define PTS_DIVISOR 90
+#define PTS_DIVISOR 90
+
+// Bounded cache, with nonblocking acquisition and release on hot paths.
+#define VIDEO_PACKET_POOL_LIMIT 64
+static pthread_mutex_t packetPoolLock = PTHREAD_MUTEX_INITIALIZER;
+static void* packetPool[VIDEO_PACKET_POOL_LIMIT];
+static unsigned int packetPoolCount;
+static size_t packetPoolSize;
+
+void* RtpvAcquirePacket(size_t size) {
+    void* packet = NULL;
+    if (pthread_mutex_trylock(&packetPoolLock) == 0) {
+        LC_ASSERT(packetPoolSize == size);
+        if (packetPoolCount != 0 && packetPoolSize == size) {
+            packet = packetPool[--packetPoolCount];
+        }
+        pthread_mutex_unlock(&packetPoolLock);
+    }
+    return packet != NULL ? packet : malloc(size);
+}
+
+void RtpvReleasePacket(void* packet) {
+    if (packet == NULL) return;
+    if (pthread_mutex_trylock(&packetPoolLock) == 0) {
+        if (packetPoolSize != 0 && packetPoolCount < VIDEO_PACKET_POOL_LIMIT) {
+            packetPool[packetPoolCount++] = packet;
+            pthread_mutex_unlock(&packetPoolLock);
+            return;
+        }
+        pthread_mutex_unlock(&packetPoolLock);
+    }
+    free(packet);
+}
 
