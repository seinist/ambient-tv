@@ -6,7 +6,29 @@
 #if defined(__ANDROID__)
 #include <sys/uio.h>
 // A small burst amortizes syscalls without waiting for additional datagrams.
-#define VIDEO_UDP_BATCH 4
+#define VIDEO_UDP_BATCH 8
+
+// Grow only after consecutive full reads; shrink after sustained sparse reads.
+// MSG_WAITFORONE never waits for the remaining slots, even at the upper bound.
+static unsigned int nextVideoBatch(unsigned int current, unsigned int received,
+                                   unsigned int *full, unsigned int *sparse) {
+    if (received >= current) {
+        *sparse = 0;
+        if (++*full >= 3) {
+            *full = 0;
+            return current < VIDEO_UDP_BATCH ? current * 2 : current;
+        }
+    }
+    else if (received <= current / 2) {
+        *full = 0;
+        if (++*sparse >= 12) {
+            *sparse = 0;
+            return current > 1 ? current / 2 : 1;
+        }
+    }
+    else { *full = 0; *sparse = 0; }
+    return current;
+}
 
