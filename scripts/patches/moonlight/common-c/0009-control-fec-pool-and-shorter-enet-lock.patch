+static LINKED_BLOCKING_QUEUE frameFecStatusQueue;
+
+// Eight queued reports plus a sender and a producer holding a slot.
+// Reports are best-effort: no heap allocation or wait for a free slot.
+#define FRAME_FEC_QUEUE_LIMIT 8
+#define FRAME_FEC_POOL_LIMIT (FRAME_FEC_QUEUE_LIMIT + 2)
+static QUEUED_FRAME_FEC_STATUS frameFecPool[FRAME_FEC_POOL_LIMIT];
+static unsigned int frameFecPoolUsed;
+
+static PQUEUED_FRAME_FEC_STATUS acquireFrameFecStatus(void) {
+    unsigned int used = __atomic_load_n(&frameFecPoolUsed, __ATOMIC_RELAXED);
+    for (unsigned int attempt = 0; attempt < FRAME_FEC_POOL_LIMIT; attempt++) {
+        unsigned int available = ((1U << FRAME_FEC_POOL_LIMIT) - 1U) & ~used;
+        if (available == 0) return NULL;
+        unsigned int slot = (unsigned int)__builtin_ctz(available);
+        if (__atomic_compare_exchange_n(&frameFecPoolUsed, &used, used | (1U << slot),
+                                        false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+            return &frameFecPool[slot];
+        }
+    }
+    return NULL;
+}
+
+static void releaseFrameFecStatus(PQUEUED_FRAME_FEC_STATUS status) {
+    unsigned int slot = (unsigned int)(status - frameFecPool);
+    LC_ASSERT(slot < FRAME_FEC_POOL_LIMIT);
+    unsigned int previous = __atomic_fetch_and(&frameFecPoolUsed, ~(1U << slot), __ATOMIC_RELEASE);
+    LC_ASSERT(previous & (1U << slot));
+    (void)previous;
+}
