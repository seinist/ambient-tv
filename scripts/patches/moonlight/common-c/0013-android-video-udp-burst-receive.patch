+                    if (batchBuffers[slots] == NULL) break;
+                }
+                vectors[slots].iov_base = batchBuffers[slots];
+                vectors[slots].iov_len = receiveSize;
+                messages[slots].msg_hdr.msg_iov = &vectors[slots];
+                messages[slots].msg_hdr.msg_iovlen = 1;
