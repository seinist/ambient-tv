+        }
+        if (useBatch && batchIndex == batchCount) {
+            batchIndex = batchCount = 0;
+            memset(messages, 0, sizeof(messages));
+            unsigned int slots = 0;
+            for (; slots < VIDEO_UDP_BATCH; slots++) {
+                if (batchBuffers[slots] == NULL) {
