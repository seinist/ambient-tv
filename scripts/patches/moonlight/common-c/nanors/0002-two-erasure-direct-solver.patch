+static inline u8 fieldProduct(u8 a, u8 b)
+{
+    return a && b ? GF2_8_EXP[GF2_8_LOG[a] + GF2_8_LOG[b]] : 0;
+}
+
+// Solve two missing shards directly. Form the two residual parity equations,
+// then eliminate one unknown with existing SIMD axpy/scal kernels. If a
+// custom parity matrix has a zero pivot, leave the general solver in charge.
+static int recoverTwo(reed_solomon *rs, u8 **data, const u8 *missing,
+                      const u8 *rows, int bs)
+{
+    int x = missing[0], y = missing[1];
+    const u8 *r0 = rs->p + rows[0] * rs->ds;
+    const u8 *r1 = rs->p + rows[1] * rs->ds;
+    u8 a = r0[x], b = r0[y], c = r1[x], d = r1[y];
+    if (!a) return 0;
+    u8 invA = GF2_8_INV[a];
+    u8 ratio = fieldProduct(c, invA);
+    u8 pivot = d ^ fieldProduct(ratio, b);
+    if (!pivot) return 0;
+    memcpy(data[x], data[rs->ds + rows[0]], bs);
+    memcpy(data[y], data[rs->ds + rows[1]], bs);
+    for (int i = 0; i < rs->ds; i++) {
+        if (i == x || i == y) continue;
+        axpy(rs, data[x], data[i], r0[i], bs);
+        axpy(rs, data[y], data[i], r1[i], bs);
+    }
+    axpy(rs, data[y], data[x], ratio, bs);
+    scal(rs, data[y], GF2_8_INV[pivot], bs);
+    axpy(rs, data[x], data[y], b, bs);
+    scal(rs, data[x], invA, bs);
+    return 1;
+}
