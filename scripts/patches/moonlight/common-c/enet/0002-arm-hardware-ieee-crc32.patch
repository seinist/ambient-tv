+// ENet uses IEEE CRC32, not Castagnoli CRC32C. ARM supplies both; use
+// __crc32* exclusively. Never require the optional extension globally.
+__attribute__((target("+crc")))
+static enet_uint32 enet_crc32_arm(const ENetBuffer *buffers, size_t bufferCount)
+{
+    enet_uint32 crc = 0xFFFFFFFF;
+    while (bufferCount-- > 0) {
+        const enet_uint8 *data = buffers->data;
+        size_t remaining = buffers->dataLength;
+        while (remaining >= 8) {
+            uint64_t word;
+            memcpy(&word, data, sizeof(word));
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+            word = __builtin_bswap64(word);
+#endif
+            crc = __crc32d(crc, word);
+            data += 8;
+            remaining -= 8;
+        }
+        while (remaining-- > 0) crc = __crc32b(crc, *data++);
+        buffers++;
+    }
+    return ENET_HOST_TO_NET_32(~crc);
+}
+
+static int enet_has_arm_crc(void)
+{
+    static int cached;
+    int value = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    if (value == 0) {
+        value = (getauxval(AT_HWCAP) & HWCAP_CRC32) ? 2 : 1;
+        __atomic_store_n(&cached, value, __ATOMIC_RELAXED);
+    }
+    return value == 2;
+}
