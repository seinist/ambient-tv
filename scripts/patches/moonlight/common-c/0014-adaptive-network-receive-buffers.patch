+#define RTP_RECV_PACKETS_BUFFERED 2048
+#define RTP_RECV_PACKETS_MAX 4096
+static unsigned int adaptiveVideoBufferTier;
+
+void AmbientSetVideoBufferTier(unsigned int tier) {
+    __atomic_store_n(&adaptiveVideoBufferTier, tier > 2 ? 2 : tier, __ATOMIC_RELAXED);
+}
+
+// Keep the upstream floor, accommodate several frames at high bitrate, and
+// allow bounded extra capacity under sustained network pressure. The kernel
+// may impose a lower effective SO_RCVBUF; capacity is not a playout delay.
+static int videoReceiveBufferBytes(int bitrateKbps, int fps, int packetSize, unsigned int tier) {
+    uint64_t packetBytes = (packetSize > 0 && packetSize <= 65000 ? packetSize : 1024) + MAX_RTP_HEADER_SIZE;
+    uint64_t floor = RTP_RECV_PACKETS_BUFFERED * packetBytes;
+    uint64_t cap = RTP_RECV_PACKETS_MAX * packetBytes;
+    uint64_t burst = bitrateKbps > 0 && fps > 0 ? (uint64_t)bitrateKbps * 1000 * 4 / (8 * (uint64_t)fps) : 0;
+    uint64_t target = burst > floor ? burst : floor;
+    if (target > cap) target = cap;
+    if (tier > 2) tier = 2;
+    target = target * (2 + tier) / 2;
+    return (int)(target > cap ? cap : target);
+}
 
