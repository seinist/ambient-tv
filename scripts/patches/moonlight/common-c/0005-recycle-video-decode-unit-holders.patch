@@ -30,7 +30,33 @@
 #define CONSECUTIVE_DROP_LIMIT 120
 static unsigned int consecutiveFrameDrops;
 
-static LINKED_BLOCKING_QUEUE decodeUnitQueue;
+static LINKED_BLOCKING_QUEUE decodeUnitQueue;
+
+// Only queued holders are recycled. Direct-submit holders remain on the stack.
+#define VIDEO_DU_POOL_LIMIT 8
+static pthread_mutex_t videoDuPoolLock = PTHREAD_MUTEX_INITIALIZER;
+static PQUEUED_DECODE_UNIT videoDuPool[VIDEO_DU_POOL_LIMIT];
+static unsigned int videoDuPoolCount;
+
+static PQUEUED_DECODE_UNIT acquireDecodeUnit(void) {
+    PQUEUED_DECODE_UNIT unit = NULL;
+    pthread_mutex_lock(&videoDuPoolLock);
+    if (videoDuPoolCount != 0) unit = videoDuPool[--videoDuPoolCount];
+    pthread_mutex_unlock(&videoDuPoolLock);
+    if (unit == NULL) unit = malloc(sizeof(*unit));
+    return unit;
+}
+
+static void releaseDecodeUnit(PQUEUED_DECODE_UNIT unit) {
+    pthread_mutex_lock(&videoDuPoolLock);
+    if (videoDuPoolCount < VIDEO_DU_POOL_LIMIT) {
+        videoDuPool[videoDuPoolCount++] = unit;
+        pthread_mutex_unlock(&videoDuPoolLock);
+        return;
+    }
+    pthread_mutex_unlock(&videoDuPoolLock);
+    free(unit);
+}
 
 typedef struct _BUFFER_DESC {
     char* data;
