+    freeDecodeUnitList(LbqDestroyLinkedBlockingQueue(&decodeUnitQueue));
+    cleanupFrameState();
+    pthread_mutex_lock(&videoDuPoolLock);
+    while (videoDuPoolCount != 0) free(videoDuPool[--videoDuPoolCount]);
+    pthread_mutex_unlock(&videoDuPoolLock);
 }
 
