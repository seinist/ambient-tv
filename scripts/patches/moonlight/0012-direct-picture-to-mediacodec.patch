+// Only the synchronous renderer callback on this native thread can access the DU.
+// No native pointer is exposed to Java or retained after the callback returns.
+static __thread PDECODE_UNIT activePictureUnit;
+static __thread int activePictureLength;
+
+JNIEXPORT jboolean JNICALL Java_com_limelight_nvstream_jni_MoonBridge_copyActivePictureData(
+        JNIEnv* env, jclass clazz, jobject target, jint length) {
+    (void)clazz;
+    if (activePictureUnit == NULL || target == NULL || length <= 0 ||
+            length != activePictureLength) return JNI_FALSE;
+    unsigned char* dest = (*env)->GetDirectBufferAddress(env, target);
+    jlong capacity = (*env)->GetDirectBufferCapacity(env, target);
+    if (dest == NULL || capacity < length) return JNI_FALSE;
+    int offset = 0;
+    for (PLENTRY entry = activePictureUnit->bufferList; entry != NULL; entry = entry->next) {
+        if (entry->bufferType != BUFFER_TYPE_PICDATA) continue;
+        if (entry->length <= 0 || entry->length > length - offset || entry->data == NULL) return JNI_FALSE;
+        memcpy(dest + offset, entry->data, entry->length);
+        offset += entry->length;
+    }
+    return offset == length ? JNI_TRUE : JNI_FALSE;
+}
+
+static bool ensureFrameArray(JNIEnv* env, int length) {
+    if (DecodedFrameCapacity >= length) return true;
+    int capacity = DecodedFrameCapacity > 0 ? DecodedFrameCapacity : 32768;
+    while (capacity < length) {
+        if (capacity > INT_MAX / 2) { capacity = length; break; }
+        capacity *= 2;
+    }
+    jbyteArray local = (*env)->NewByteArray(env, capacity);
+    if (local == NULL) {
+        if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+        return false;
+    }
+    jbyteArray replacement = (*env)->NewGlobalRef(env, local);
+    (*env)->DeleteLocalRef(env, local);
+    if (replacement == NULL) {
+        if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+        return false;
+    }
+    if (DecodedFrameBuffer != NULL) (*env)->DeleteGlobalRef(env, DecodedFrameBuffer);
+    DecodedFrameBuffer = replacement;
+    DecodedFrameCapacity = capacity;
+    return true;
+}
+
+int BridgeDrSubmitDecodeUnit(PDECODE_UNIT decodeUnit) {
+    JNIEnv* env = GetThreadEnv();
+    if (decodeUnit->fullLength <= 0) return DR_NEED_IDR;
+    int pictureLength = 0, totalLength = 0, configLength = 0;
+    for (PLENTRY entry = decodeUnit->bufferList; entry != NULL; entry = entry->next) {
+        if (entry->length <= 0 || entry->length > decodeUnit->fullLength - totalLength ||
+                entry->data == NULL) return DR_NEED_IDR;
+        totalLength += entry->length;
+        if (entry->bufferType == BUFFER_TYPE_PICDATA) pictureLength += entry->length;
+        else if (entry->length > configLength) configLength = entry->length;
+    }
+    if (totalLength != decodeUnit->fullLength || pictureLength <= 0) return DR_NEED_IDR;
+    int arrayLength = directPictureEnabled ? configLength : decodeUnit->fullLength;
+    if (arrayLength > 0 && !ensureFrameArray(env, arrayLength)) return DR_NEED_IDR;
+    for (PLENTRY entry = decodeUnit->bufferList; entry != NULL; entry = entry->next) {
+        if (entry->bufferType == BUFFER_TYPE_PICDATA) continue;
+        (*env)->SetByteArrayRegion(env, DecodedFrameBuffer, 0, entry->length, (jbyte*)entry->data);
+        if ((*env)->ExceptionCheck(env)) { (*JVM)->DetachCurrentThread(JVM); return DR_OK; }
+        int ret = (*env)->CallStaticIntMethod(env, GlobalBridgeClass, BridgeDrSubmitDecodeUnitMethod,
+                DecodedFrameBuffer, entry->length, entry->bufferType,
+                decodeUnit->frameNumber, decodeUnit->frameType, (jchar)decodeUnit->frameHostProcessingLatency,
+                (jlong)decodeUnit->receiveTimeUs, (jlong)decodeUnit->enqueueTimeUs);
+        if ((*env)->ExceptionCheck(env)) { (*JVM)->DetachCurrentThread(JVM); return DR_OK; }
+        if (ret != DR_OK) return ret;
+    }
+    int ret;
+    if (directPictureEnabled) {
+        if (activePictureUnit != NULL) return DR_NEED_IDR;
+        activePictureUnit = decodeUnit;
+        activePictureLength = pictureLength;
+        ret = (*env)->CallStaticIntMethod(env, GlobalBridgeClass, BridgeDrSubmitPictureMethod,
+                pictureLength, decodeUnit->frameNumber, decodeUnit->frameType,
+                (jchar)decodeUnit->frameHostProcessingLatency,
+                (jlong)decodeUnit->receiveTimeUs, (jlong)decodeUnit->enqueueTimeUs);
+        activePictureUnit = NULL;
+        activePictureLength = 0;
+    }
+    else {
+        int offset = 0;
+        for (PLENTRY entry = decodeUnit->bufferList; entry != NULL; entry = entry->next) {
+            if (entry->bufferType != BUFFER_TYPE_PICDATA) continue;
+            (*env)->SetByteArrayRegion(env, DecodedFrameBuffer, offset, entry->length, (jbyte*)entry->data);
+            if ((*env)->ExceptionCheck(env)) { (*JVM)->DetachCurrentThread(JVM); return DR_OK; }
+            offset += entry->length;
+        }
+        ret = (*env)->CallStaticIntMethod(env, GlobalBridgeClass, BridgeDrSubmitDecodeUnitMethod,
+                DecodedFrameBuffer, pictureLength, BUFFER_TYPE_PICDATA, decodeUnit->frameNumber,
+                decodeUnit->frameType, (jchar)decodeUnit->frameHostProcessingLatency,
+                (jlong)decodeUnit->receiveTimeUs, (jlong)decodeUnit->enqueueTimeUs);
+    }
+    if ((*env)->ExceptionCheck(env)) { (*JVM)->DetachCurrentThread(JVM); return DR_OK; }
+    return ret;
+}
 
