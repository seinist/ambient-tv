+// Only cache threads attached by this bridge. Java-owned callers still query
+// the VM; their attachment lifetime is not under native control.
+static __thread JNIEnv* bridgeThreadEnv;
+static bool jniEnvKeyReady;
+
+void DetachThread(void* context) {
+    (void)context;
+    bridgeThreadEnv = NULL;
+    (*JVM)->DetachCurrentThread(JVM);
+}
+
+void JniEnvKeyInit(void) {
+    jniEnvKeyReady = pthread_key_create(&JniEnvKey, DetachThread) == 0;
+}
+
+static void detachCallbackThread(void) {
+    if (bridgeThreadEnv != NULL) {
+        bridgeThreadEnv = NULL;
+        // An exceptional manual detach must not leave the destructor armed.
+        pthread_setspecific(JniEnvKey, NULL);
+    }
+    (*JVM)->DetachCurrentThread(JVM);
+}
+
+JNIEnv* GetThreadEnv(void) {
+    if (bridgeThreadEnv != NULL) return bridgeThreadEnv;
+
+    JNIEnv* env = NULL;
+    if ((*JVM)->GetEnv(JVM, (void**)&env, JNI_VERSION_1_4) == JNI_OK)
+        return env;
+
+    pthread_once(&JniEnvKeyInitOnce, JniEnvKeyInit);
+    if (!jniEnvKeyReady || (*JVM)->AttachCurrentThread(JVM, &env, NULL) != JNI_OK || env == NULL)
+        abort(); // All existing bridge callers require a valid JNIEnv.
+    if (pthread_setspecific(JniEnvKey, env) != 0) {
+        (*JVM)->DetachCurrentThread(JVM);
+        abort();
+    }
+    bridgeThreadEnv = env;
+    return env;
+}
 
