+void VulkanBackend::setPreferFp16Frame(bool enabled) {
+    // Called before a new core is created, on the same thread as the Vulkan frontend.
+    if (preferFp16Frame == enabled && !forceRgba8Frame) return;
+    preferFp16Frame = enabled;
+    forceRgba8Frame = false;
+    if (frameBuffer != nullptr) destroyFrameBuffer();
+}
+
+void VulkanBackend::disableFp16Frame() {
+    if (!fp16Frame) return;
+    forceRgba8Frame = true;
+    destroyFrameBuffer();
+}
