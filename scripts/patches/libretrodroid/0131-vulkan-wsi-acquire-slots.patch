diff --git a/src/main/cpp/vulkan/vulkanwsiacquireslots.h b/src/main/cpp/vulkan/vulkanwsiacquireslots.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanwsiacquireslots.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <vector>
+
+namespace libretrodroid {
+
+// Swapchain-generation ownership: one acquire semaphore per frame slot,
+// completion semaphores per swapchain image. A bridge resize must not retire
+// an acquire semaphore independently of its WSI generation.
+template<class Semaphore, std::size_t Count = 2>
+class VulkanWsiAcquireSlots {
+public:
+    VulkanWsiAcquireSlots() = default;
+    VulkanWsiAcquireSlots(const VulkanWsiAcquireSlots&) = delete;
+    VulkanWsiAcquireSlots& operator=(const VulkanWsiAcquireSlots&) = delete;
+
+    Semaphore get(std::size_t index) const noexcept {
+        return index < Count ? acquire[index] : Semaphore{};
+    }
+    bool owns(Semaphore candidate) const noexcept {
+        if (!candidate) return false;
+        for (auto semaphore : acquire) if (semaphore == candidate) return true;
+        return false;
+    }
+    template<class Create>
+    bool ensure(std::size_t index, const std::vector<Semaphore>& complete, Create create) {
+        if (index >= Count) return false;
+        if (acquire[index]) return true;
+        Semaphore candidate{};
+        // A failed API call need not leave a valid output handle.
+        if (!create(candidate) || !candidate || owns(candidate)) return false;
+        for (auto semaphore : complete) if (semaphore == candidate) return false;
+        acquire[index] = candidate;
+        return true;
+    }
+    bool canRetire(bool hasDevice, bool canDestroy,
+                   const std::vector<Semaphore>& complete) const noexcept {
+        for (std::size_t i = 0; i < Count; ++i) {
+            if (!acquire[i]) continue;
+            if (!hasDevice || !canDestroy) return false;
+            for (std::size_t j = i + 1; j < Count; ++j)
+                if (acquire[i] == acquire[j]) return false;
+        }
+        for (std::size_t i = 0; i < complete.size(); ++i) {
+            if (!complete[i]) continue;
+            if (!hasDevice || !canDestroy || owns(complete[i])) return false;
+            for (std::size_t j = i + 1; j < complete.size(); ++j)
+                if (complete[i] == complete[j]) return false;
+        }
+        return true;
+    }
+    template<class Destroy>
+    bool retire(bool retired, bool hasDevice, bool canDestroy,
+                const std::vector<Semaphore>& complete, Destroy destroy) {
+        // The caller must establish completion for the entire WSI generation.
+        if (!retired || !canRetire(hasDevice, canDestroy, complete)) return false;
+        for (auto& semaphore : acquire) {
+            if (semaphore) destroy(semaphore);
+            semaphore = {};
+        }
+        return true;
+    }
+private:
+    std::array<Semaphore, Count> acquire{};
+};
+
+} // namespace libretrodroid
