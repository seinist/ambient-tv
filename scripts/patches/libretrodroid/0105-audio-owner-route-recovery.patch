diff --git a/src/main/cpp/audiostreamrecovery.h b/src/main/cpp/audiostreamrecovery.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/audiostreamrecovery.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "audioprocessinggate.h"
+#include <chrono>
+#include <utility>
+
+namespace libretrodroid {
+
+// The stream keeps this generation alive. Retiring it detaches the Audio
+// owner before stream close; a stale callback never touches a newer owner.
+template<class Owner>
+class AudioCallbackGeneration {
+public:
+    explicit AudioCallbackGeneration(Owner& owner) noexcept : owner(&owner) {}
+
+    template<class Process>
+    bool dispatch(Process&& process) {
+        AudioProcessingGate::CallbackScope scope(gate);
+        if (!scope || owner == nullptr) return false;
+        std::forward<Process>(process)(*owner);
+        return true;
+    }
+
+    AudioProcessingGate& processingGate() noexcept { return gate; }
+
+    // Only the render/control owner calls this, outside any other gate scope.
+    void retire() {
+        AudioProcessingGate::ControlScope scope(gate);
+        owner = nullptr;
+    }
+
+private:
+    AudioProcessingGate gate;
+    Owner* owner;
+};
+
+// Owner-thread only. Keep getState() and failed stream openings out of the
+// per-audio-packet hot path, and do not retry when playback is stopped.
+class AudioRouteRecovery {
+public:
+    using Clock = std::chrono::steady_clock;
+    using TimePoint = Clock::time_point;
+
+    bool shouldProbe(bool startRequested, TimePoint now) noexcept {
+        if (!startRequested || now < nextProbe) return false;
+        nextProbe = now + std::chrono::milliseconds(250);
+        return true;
+    }
+    void retryLater(TimePoint now) noexcept {
+        nextProbe = now + std::chrono::seconds(1);
+    }
+    void reset() noexcept { nextProbe = TimePoint::min(); }
+
+private:
+    TimePoint nextProbe = TimePoint::min();
+};
+
+} // namespace libretrodroid
