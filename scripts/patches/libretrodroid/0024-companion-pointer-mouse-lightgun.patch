-template<typename... T>
+void Input::onCompanionPointer(unsigned port, unsigned kind, unsigned index,
+                               float x, float y, unsigned flags) {
+    if (port >= 4 || kind > 2 || index >= 4 || !std::isfinite(x) || !std::isfinite(y)) return;
+    std::lock_guard<std::mutex> lock(inputMutex);
+    auto& pad = netplayActive ? captured[port] : pads[port];
+    if (kind == 0) {
+        if (index == 0) {
+            pad.pointerPressed = (flags & 1u) != 0;
+            if (pad.pointerPressed) {
+                pad.pointerScreenXAxis = std::clamp(x, 0.f, 1.f);
+                pad.pointerScreenYAxis = std::clamp(y, 0.f, 1.f);
+            }
+        } else {
+            auto& contact = pad.extraPointers[index - 1];
+            contact.pressed = (flags & 1u) != 0;
+            if (contact.pressed) {
+                contact.x = std::clamp(x, 0.f, 1.f);
+                contact.y = std::clamp(y, 0.f, 1.f);
+            }
+        }
+    } else if (kind == 1) {
+        // Relative movement: virtual trackpad deltas are in -1..1 of its width/height.
+        pad.mouseDX = std::clamp(pad.mouseDX + static_cast<int>(std::lround(x * 640.f)), -32767, 32767);
+        pad.mouseDY = std::clamp(pad.mouseDY + static_cast<int>(std::lround(y * 480.f)), -32767, 32767);
+        pad.mouseButtons = flags & 7u;
+    } else {
+        pad.gunOffscreen = x < 0.f || y < 0.f;
+        if (!pad.gunOffscreen) { pad.gunX = std::clamp(x, 0.f, 1.f); pad.gunY = std::clamp(y, 0.f, 1.f); }
+        pad.gunButtons = flags & 15u;
+    }
+}
+
+template<typename... T>
 bool Input::anyPressed(unsigned int port, unsigned int id, T &... args) const {
     return anyPressed(port, id) || anyPressed(port, args...);
 }
