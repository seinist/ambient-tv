--- a/src/main/cpp/vulkan/vulkanbackend.cpp
+++ b/src/main/cpp/vulkan/vulkanbackend.cpp
@@ -404,4 +404,15 @@ void VulkanBackend::setNativeOutputTransfer(uint32_t transfer) {
     nativeSdrDisabled = false;
 }
 
+void VulkanBackend::setNativeCoreSourceTransfer(uint32_t sourceTransfer) {
+    // This is a *separate* core option + observed VkImage contract, not the
+    // manual user setting or panel capabilities. A changed source must retire
+    // any prior HDR swapchain before another frame can be presented.
+    const uint32_t accepted = sourceTransfer <= 2u ? sourceTransfer : 0u;
+    if (accepted == nativeCoreSourceTransfer) return;
+    destroyNativeSdrSwapchain();
+    nativeCoreSourceTransfer = accepted;
+    nativeSdrDisabled = false;
+}
+
 void VulkanBackend::disableNativeSdrSwapchain(const char* reason) {
@@ -412,2 +423,7 @@ bool VulkanBackend::ensureNativeSdrSwapchain() {
     if (nativeSdrSwapchain != VK_NULL_HANDLE) return true;
+    // Refuse native HDR without independent source evidence. In particular,
+    // neither a 10-bit VkFormat nor manual PQ/HLG selection is sufficient.
+    // SDR diagnosis remains available with no HDR-aware core.
+    if (nativeOutputTransfer != 0u && nativeCoreSourceTransfer != nativeOutputTransfer)
+        return false;
     if (!isStarted() || nativeSdrWindow == nullptr || nativeSdrDisabled ||
@@ -1371,3 +1387,4 @@ void VulkanBackend::shutdown() {
     nativeSdrDisabled = false;
     nativeOutputTransfer = 0u;
+    nativeCoreSourceTransfer = 0u;
     nativeSdrStatus.store(0u, std::memory_order_release);
