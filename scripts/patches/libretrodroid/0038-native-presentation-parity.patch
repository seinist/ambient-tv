@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Geometry and draw ownership shared by the native WSI presenter and its host tests.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include "../contentaspect.h"
+#include "../integerscaling.h"
+
+namespace libretrodroid {
+
+struct NativeViewport {
+    int32_t x = 0;
+    int32_t y = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+};
+
+inline NativeViewport nativeViewportFor(uint32_t targetWidth, uint32_t targetHeight,
+                                       uint32_t sourceWidth, uint32_t sourceHeight,
+                                       float resolvedAspect, bool integerScaling,
+                                       bool automaticIntegerScaling) {
+    if (targetWidth == 0 || targetHeight == 0 || sourceWidth == 0 || sourceHeight == 0 ||
+        targetWidth > static_cast<uint32_t>(std::numeric_limits<int32_t>::max()) ||
+        targetHeight > static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) return {};
+
+    // The caller resolves the initial core AV geometry, runtime changes and user override
+    // exactly as GLES does. Source pixel ratio is only a last resort for invalid metadata.
+    const double aspect = aspectRatioForGeometry(resolvedAspect, sourceWidth, sourceHeight);
+    uint32_t width = std::clamp<uint32_t>(static_cast<uint32_t>(std::lround(
+        std::min<double>(targetWidth, targetHeight * aspect))), 1u, targetWidth);
+    uint32_t height = std::clamp<uint32_t>(static_cast<uint32_t>(std::lround(
+        std::min<double>(targetHeight, targetWidth / aspect))), 1u, targetHeight);
+    const int scale = integerScaling ? integerScaleFor(
+        static_cast<float>(targetWidth), static_cast<float>(targetHeight),
+        sourceWidth, sourceHeight, automaticIntegerScaling) : 0;
+    if (scale >= 1) {
+        width = static_cast<uint32_t>(std::min<uint64_t>(targetWidth, uint64_t(sourceWidth) * scale));
+        height = static_cast<uint32_t>(std::min<uint64_t>(targetHeight, uint64_t(sourceHeight) * scale));
+    }
+    return { static_cast<int32_t>((targetWidth - width) / 2),
+             static_cast<int32_t>((targetHeight - height) / 2), width, height };
+}
+
+/** GL-thread-only: diagnostic presentation never owns the visible primary picture. */
+class NativePresentationGate {
+public:
+    enum class PrimaryDraw { Draw, Force, Skip };
+
+    void setFullscreenActive(bool active) {
+        if (fullscreenActive == active) return;
+        fullscreenActive = active;
+        invalidateFrame();
+    }
+    void invalidateFrame() { framePresented = false; }
+    void didPresentFrame() { framePresented = true; }
+    void reset() { *this = NativePresentationGate{}; }
+
+    PrimaryDraw primaryDraw(bool force, bool canSkip) {
+        if (!force && canSkip && fullscreenActive && framePresented) {
+            primaryWasSkipped = true;
+            return PrimaryDraw::Skip;
+        }
+        // A duplicated/paused frame may not be marked dirty. Redraw it once when GLES
+        // becomes visible again, even if the core has supplied no replacement frame.
+        const bool redraw = force || primaryWasSkipped;
+        primaryWasSkipped = false;
+        return redraw ? PrimaryDraw::Force : PrimaryDraw::Draw;
+    }
+
+private:
+    bool fullscreenActive = false;
+    bool framePresented = false;
+    bool primaryWasSkipped = false;
+};
+
+} // namespace libretrodroid
