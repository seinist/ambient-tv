+void LibretroDroid::setNativeVulkanFullscreenActive(bool active) {
+    // The caller is the GL-thread owner of the actual fullscreen Surface, not
+    // the UI's earlier 16px diagnostic or a cached PRESENTING status bit.
+    VulkanBackend::getInstance().setNativeFullscreenActive(active);
+}
+
+bool LibretroDroid::nativePictureCompatible() const {
+    return !screenSplitEnabled && !bfiEnabled &&
+        viewportRect.getX() == 0.0F && viewportRect.getY() == 0.0F &&
+        viewportRect.getWidth() == 1.0F && viewportRect.getHeight() == 1.0F &&
+        std::all_of(std::begin(primaryCrop), std::end(primaryCrop),
+                    [](float crop) { return crop == 0.0F; });
+}
+
+void LibretroDroid::renderPrimaryFrame(bool force) {
+    if (!video) return;
+    const bool canSkip = video->presentsExternalFrames() && nativePictureCompatible() &&
+        !secondaryOutput.hasWindow() && !rewinding.load();
+    const auto draw = VulkanBackend::getInstance().primaryDraw(force, canSkip);
+    if (draw == NativePresentationGate::PrimaryDraw::Skip) return;
+    // Forced draws cover paused/duplicate frames after a native-only interval.
+    // AHB copying and GL/Vulkan synchronization remain intact for captures/fallback.
+    video->renderFrame(draw == NativePresentationGate::PrimaryDraw::Force);
 }
 
