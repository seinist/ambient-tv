diff --git a/src/main/cpp/ambientgametrace.h b/src/main/cpp/ambientgametrace.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/ambientgametrace.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#if defined(__ANDROID__)
+#include <android/trace.h>
+#endif
+#include <utility>
+
+namespace libretrodroid {
+
+// Android tracing is opt-in through the system tracing session. Host tools
+// compile exactly the same frame functions with a zero-work backend.
+struct GameTraceBackend {
+#if defined(__ANDROID__)
+    static bool enabled() noexcept { return ATrace_isEnabled(); }
+    static void begin(const char* name) noexcept { ATrace_beginSection(name); }
+    static void end() noexcept { ATrace_endSection(); }
+#else
+    static constexpr bool enabled() noexcept { return false; }
+    static void begin(const char*) noexcept {}
+    static void end() noexcept {}
+#endif
+};
+
+template<class Backend = GameTraceBackend>
+class BasicGameTraceScope {
+public:
+    explicit BasicGameTraceScope(const char* name) noexcept : active(Backend::enabled()) {
+        if (active) Backend::begin(name);
+    }
+    ~BasicGameTraceScope() { if (active) Backend::end(); }
+    BasicGameTraceScope(const BasicGameTraceScope&) = delete;
+    BasicGameTraceScope& operator=(const BasicGameTraceScope&) = delete;
+private:
+    const bool active;
+};
+
+using GameTraceScope = BasicGameTraceScope<>;
+
+template<class Callable>
+decltype(auto) traceGameCall(const char* name, Callable&& call) {
+    GameTraceScope trace(name);
+    return std::forward<Callable>(call)();
+}
+
+} // namespace libretrodroid
