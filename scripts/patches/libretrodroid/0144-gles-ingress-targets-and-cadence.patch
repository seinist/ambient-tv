new file mode 100644
--- /dev/null
+++ b/src/main/cpp/softwareframelayout.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstddef>
+#include <limits>
+
+namespace libretrodroid {
+// Validate before touching the core pointer, texture, layout or capture state.
+struct SoftwareFrameLayout {
+    std::size_t rowBytes = 0;
+    std::size_t packedBytes = 0;
+
+    static bool checked(unsigned width, unsigned height, std::size_t pitch,
+                        std::size_t bytesPerPixel, unsigned maximumDimension,
+                        SoftwareFrameLayout& result) noexcept {
+        constexpr auto maximum = std::numeric_limits<std::size_t>::max();
+        if (!width || !height || !bytesPerPixel || width > maximumDimension ||
+            height > maximumDimension || width > maximum / bytesPerPixel) return false;
+        const auto row = std::size_t(width) * bytesPerPixel;
+        if (pitch < row || height > maximum / row ||
+            std::size_t(height - 1) > (maximum - row) / pitch) return false;
+        result = {row, row * height};
+        return true;
+    }
+};
+} // namespace libretrodroid
