+void Environment::setHdrDisplayInfo(float peak, float average, float minimum, unsigned eotfs) {
+    // Caller uses the same GL/emulation thread as core environment callbacks.
+    // Reject nonsensical Android values; unknown capability stays zero.
+    hdrDisplayPeakNits = std::isfinite(peak) && peak > 0.0f ? peak : 0.0f;
+    hdrDisplayAverageNits = std::isfinite(average) && average > 0.0f ? average : 0.0f;
+    hdrDisplayMinNits = std::isfinite(minimum) && minimum >= 0.0f ? minimum : 0.0f;
+    hdrDisplayEotfs = eotfs & 7u;
+}
+
