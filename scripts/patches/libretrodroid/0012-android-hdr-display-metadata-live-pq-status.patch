+                state.transfer_function = 16u; // ITU-T H.273 SMPTE ST.2084
+                state.paper_white_nits = 203.0f; // frontend SDR reference white, not mastering max
+                state.max_nits = hdrDisplayPeakNits;
+                state.min_nits = hdrDisplayMinNits;
+                state.passthrough = true; // source already encoded; no extra PQ transform
