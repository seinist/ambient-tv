+bool VulkanBackend::createNativePresentFences(std::size_t count) {
+    if (!nativePresentFencesEnabled) return true;
+    if (!device || !vk.createFence || !vk.destroyFence || !vk.waitForFences || !vk.resetFences) return false;
+    return nativePresentFences.create(count, [&](VkFence& candidate) {
+        VkFenceCreateInfo info { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        const VkResult result = vk.createFence(device, &info, nullptr, &candidate);
+        if (result == VK_ERROR_DEVICE_LOST) checkFrameResult(result, "create present fence");
+        return result == VK_SUCCESS && candidate != frameSlot.fence && candidate != spareFrameSlot.fence;
+    });
+}
+
+bool VulkanBackend::waitNativePresentFence(VkFence fence) {
+    if (!device || !fence || !vk.waitForFences)
+        return checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "missing present fence dispatch");
+    // Bounded diagnostic wait: a timeout is not retirement proof. Retain the
+    // entire generation and permit a later teardown retry instead of hanging.
+    return checkFrameResult(vk.waitForFences(device, 1, &fence, VK_TRUE, FENCE_TIMEOUT_NS),
+                            "wait for present fence");
+}
+
+bool VulkanBackend::prepareNativePresentFence(std::size_t index) {
+    if (!nativePresentFencesEnabled) return true;
+    if (hasFatalError() || !device || !vk.resetFences) return false;
+    if (!nativePresentFences.prepare(index,
+            [&](VkFence fence) { return waitNativePresentFence(fence); },
+            [&](VkFence fence) {
+                return checkFrameResult(vk.resetFences(device, 1, &fence), "reset present fence");
+            }))
+        return checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "prepare present fence");
+    return true;
+}
+
+void VulkanBackend::recordNativePresentResult(std::size_t index, VkResult result) {
+    if (!nativePresentFencesEnabled) return;
+    // These results enqueue presentation queue operations even if the
+    // presentation engine rejects the image. OOM leaves the fence untouched.
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR ||
+            result == VK_ERROR_OUT_OF_DATE_KHR || result == VK_ERROR_SURFACE_LOST_KHR ||
+            result == VK_ERROR_FULL_SCREEN_EXCLUSIVE_MODE_LOST_EXT) {
+        if (!nativePresentFences.markPending(index))
+            checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "record present fence");
+    } else if (result != VK_ERROR_OUT_OF_HOST_MEMORY && result != VK_ERROR_OUT_OF_DEVICE_MEMORY &&
+            result != VK_ERROR_DEVICE_LOST) {
+        nativePresentFences.markUncertain(index);
+    }
+}
+
+bool VulkanBackend::completeNativePresentFences() {
+    if (!nativePresentFences.completeAll([&](VkFence fence) { return waitNativePresentFence(fence); }))
+        return checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "unproven present fence retirement");
+    return true;
+}
