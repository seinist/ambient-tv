--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanpresentfences.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstddef>
+#include <vector>
+
+namespace libretrodroid {
+
+// One fence per swapchain image, not per render frame. The render fence
+// cannot prove the presentation engine no longer accesses present resources.
+template<class Fence>
+class VulkanPresentFences {
+public:
+    enum class Phase { Idle, Pending, Complete, Uncertain };
+    struct Entry {
+        Fence fence{};
+        Phase phase = Phase::Idle;
+    };
+
+    VulkanPresentFences() = default;
+    VulkanPresentFences(const VulkanPresentFences&) = delete;
+    VulkanPresentFences& operator=(const VulkanPresentFences&) = delete;
+
+    bool empty() const noexcept { return entries.empty(); }
+    std::size_t size() const noexcept { return entries.size(); }
+    const Entry* get(std::size_t i) const noexcept {
+        return i < entries.size() ? &entries[i] : nullptr;
+    }
+    template<class Create>
+    bool create(std::size_t count, Create createFence) {
+        if (!entries.empty() || !count) return false;
+        entries.resize(count);
+        for (auto& entry : entries) {
+            Fence candidate{};
+            if (!createFence(candidate) || !candidate) return false;
+            for (const auto& other : entries)
+                if (other.fence == candidate) return false;
+            entry.fence = candidate;
+        }
+        return true;
+    }
+    bool markPending(std::size_t i) noexcept {
+        if (!ready(i)) return false;
+        entries[i].phase = Phase::Pending;
+        return true;
+    }
+    void markUncertain(std::size_t i) noexcept {
+        if (ready(i)) entries[i].phase = Phase::Uncertain;
+    }
+    bool ready(std::size_t i) const noexcept {
+        const auto* entry = get(i);
+        return entry && entry->fence && entry->phase == Phase::Idle;
+    }
+    template<class Wait, class Reset>
+    bool prepare(std::size_t i, Wait wait, Reset reset) {
+        if (i >= entries.size() || !entries[i].fence) return false;
+        auto& entry = entries[i];
+        if (entry.phase == Phase::Uncertain) return false;
+        if (entry.phase == Phase::Pending) {
+            if (!wait(entry.fence)) return false;
+            entry.phase = Phase::Complete;
+        }
+        if (entry.phase == Phase::Complete) {
+            if (!reset(entry.fence)) return false;
+            entry.phase = Phase::Idle;
+        }
+        return true;
+    }
+    template<class Wait>
+    bool completeAll(Wait wait) {
+        for (auto& entry : entries) {
+            if (entry.phase == Phase::Uncertain) return false;
+            if (entry.phase == Phase::Pending) {
+                if (!wait(entry.fence)) return false;
+                entry.phase = Phase::Complete;
+            }
+        }
+        return true;
+    }
+    // A lost device permits destruction, not reuse of its synchronization objects.
+    void abandonAfterDeviceLoss() noexcept {
+        for (auto& entry : entries)
+            if (entry.phase != Phase::Idle) entry.phase = Phase::Complete;
+    }
+    bool canRetire(bool hasDevice, bool canDestroy) const noexcept {
+        for (const auto& entry : entries)
+            if (entry.fence && (!hasDevice || !canDestroy)) return false;
+        return true;
+    }
+    template<class Destroy>
+    bool retire(bool hasDevice, bool canDestroy, Destroy destroy) {
+        if (!canRetire(hasDevice, canDestroy)) return false;
+        for (const auto& entry : entries)
+            if (entry.phase == Phase::Pending || entry.phase == Phase::Uncertain) return false;
+        for (const auto& entry : entries)
+            if (entry.fence) destroy(entry.fence);
+        entries.clear();
+        return true;
+    }
+private:
+    std::vector<Entry> entries;
+};
+
+} // namespace libretrodroid
