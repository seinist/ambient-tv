+
+bool VulkanBackend::allocateBridgeImage(
+        VulkanBridgeImage<AHardwareBuffer*, VkImage, VkDeviceMemory>& bridge,
+        unsigned width, unsigned height, bool fp16, VulkanBridgeAllocationBudget budget) {
+    // No GPU work is submitted here. Only this empty target may be changed;
+    // allocation failure cannot retire another slot or clear published status.
+    if (!bridge.empty() || !device || !vk.destroyImage || !vk.freeMemory ||
+            !vk.getAndroidHardwareBufferProperties || !vk.createImage || !vk.allocateMemory ||
+            !vk.bindImageMemory || !budget.permitsRequest(width, height, fp16)) return false;
+    const auto discard = [&] {
+        if (!bridge.retire(false, device != VK_NULL_HANDLE,
+                vk.destroyImage != nullptr, vk.freeMemory != nullptr,
+                [&](VkImage image) { vk.destroyImage(device, image, nullptr); },
+                [&](VkDeviceMemory memory) { vk.freeMemory(device, memory, nullptr); },
+                [](AHardwareBuffer* buffer) { AHardwareBuffer_release(buffer); }))
+            checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "retire unsubmitted bridge image");
+    };
+
+    AHardwareBuffer_Desc desc {};
+    desc.width = width;
+    desc.height = height;
+    desc.layers = 1;
+    const VkFormat format = fp16 ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+    if (fp16) {
+        if (vk.getPhysicalDeviceFormatProperties == nullptr) return false;
+        VkFormatProperties properties {};
+        vk.getPhysicalDeviceFormatProperties(gpu, format, &properties);
+        if ((properties.optimalTilingFeatures &
+             (VK_FORMAT_FEATURE_BLIT_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT)) !=
+            (VK_FORMAT_FEATURE_BLIT_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT)) {
+            LOGW("Vulkan GPU does not support FP16 framebuffer blit + sampling");
+            return false;
+        }
+    }
+    desc.format = fp16 ? AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT
+                       : AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+    desc.usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT;
+    AHardwareBuffer* newBuffer = nullptr;
+    if (AHardwareBuffer_allocate(&desc, &newBuffer) != 0) {
+        LOGW("AHardwareBuffer allocation failed for %ux%u (fp16=%d)", width, height, fp16);
+        return false;
+    }
+    bridge.buffer = newBuffer;
+
+    VkAndroidHardwareBufferPropertiesANDROID properties { VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID };
+    if (vk.getAndroidHardwareBufferProperties(device, bridge.buffer, &properties) != VK_SUCCESS) {
+        LOGE("vkGetAndroidHardwareBufferPropertiesANDROID failed");
+        discard();
+        return false;
+    }
+
+    // AHB allocation is needed to query the driver's size. Retire an
+    // over-budget candidate before creating/importing Vulkan image memory.
+    if (!budget.permitsAllocation(properties.allocationSize)) {
+        LOGW("Vulkan bridge allocation exceeds available budget");
+        discard();
+        return false;
+    }
+
+    VkExternalMemoryImageCreateInfo externalInfo { VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO };
+    externalInfo.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
+
+    VkImageCreateInfo imageInfo { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    imageInfo.pNext = &externalInfo;
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = format;
+    imageInfo.extent = { width, height, 1 };
+    imageInfo.mipLevels = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                      VK_IMAGE_USAGE_SAMPLED_BIT;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImage newImage = VK_NULL_HANDLE;
+    if (vk.createImage(device, &imageInfo, nullptr, &newImage) != VK_SUCCESS) {
+        LOGE("vkCreateImage failed for the shared frame image");
+        discard();
+        return false;
+    }
+
+    bridge.image = newImage;
+
+    VkImportAndroidHardwareBufferInfoANDROID importInfo { VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID };
+    importInfo.buffer = bridge.buffer;
+    VkMemoryDedicatedAllocateInfo dedicatedInfo { VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO };
+    dedicatedInfo.pNext = &importInfo;
+    dedicatedInfo.image = bridge.image;
+
+    VkMemoryAllocateInfo allocInfo { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    allocInfo.pNext = &dedicatedInfo;
+    allocInfo.allocationSize = properties.allocationSize;
+    if (properties.memoryTypeBits == 0) {
+        LOGW("AHardwareBuffer has no compatible Vulkan memory type (fp16=%d)", fp16);
+        discard();
+        return false;
+    }
+    allocInfo.memoryTypeIndex = static_cast<uint32_t>(__builtin_ctz(properties.memoryTypeBits));
+    VkDeviceMemory newMemory = VK_NULL_HANDLE;
+    if (vk.allocateMemory(device, &allocInfo, nullptr, &newMemory) != VK_SUCCESS) {
+        LOGE("Importing the shared frame buffer into Vulkan failed");
+        discard();
+        return false;
+    }
+    bridge.memory = newMemory;
+    bridge.allocationBytes = properties.allocationSize;
+    if (vk.bindImageMemory(device, bridge.image, bridge.memory, 0) != VK_SUCCESS) {
+        LOGE("Binding the shared frame buffer into Vulkan failed");
+        discard();
+        return false;
+    }
+
+    bridge.width = width;
+    bridge.height = height;
+    bridge.fp16 = fp16;
     return true;
 }
diff --git a/src/main/cpp/vulkan/vulkanbridgeallocationbudget.h b/src/main/cpp/vulkan/vulkanbridgeallocationbudget.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanbridgeallocationbudget.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <limits>
+
+namespace libretrodroid {
+
+// Admission for an optional second bridge, not a new limit on the legacy
+// single-frame path. The caller counts each live AHB identity exactly once.
+// All values are allocation bytes, not width/height estimates.
+class VulkanBridgeAllocationBudget {
+public:
+    using Bytes = std::uint64_t;
+    static constexpr Bytes maximum = 128ull * 1024ull * 1024ull;
+
+    static constexpr VulkanBridgeAllocationBudget primary() noexcept {
+        return VulkanBridgeAllocationBudget(std::numeric_limits<Bytes>::max());
+    }
+
+    static constexpr VulkanBridgeAllocationBudget additional(Bytes primaryBytes, Bytes eglOnlyBytes) noexcept {
+        // A missing/unknown primary size, unknown EGL size or exhausted cap
+        // denies the optional allocation. Subtraction cannot overflow.
+        if (!primaryBytes || primaryBytes >= maximum || eglOnlyBytes >= maximum - primaryBytes)
+            return VulkanBridgeAllocationBudget(0);
+        return VulkanBridgeAllocationBudget(maximum - primaryBytes - eglOnlyBytes);
+    }
+
+    constexpr Bytes available() const noexcept { return remaining; }
+
+    constexpr bool permitsAllocation(Bytes driverBytes) const noexcept {
+        return driverBytes != 0 && driverBytes <= remaining;
+    }
+
+    constexpr bool permitsRequest(unsigned width, unsigned height, bool fp16) const noexcept {
+        // Cheap rejection before allocating the AHB. The driver's actual size
+        // (which can exceed this lower bound) must be checked again afterwards.
+        const Bytes pixelBytes = fp16 ? 8 : 4;
+        return width != 0 && height != 0 &&
+            static_cast<Bytes>(width) <= remaining / pixelBytes / height;
+    }
+
+private:
+    explicit constexpr VulkanBridgeAllocationBudget(Bytes bytes) noexcept : remaining(bytes) {}
+    const Bytes remaining;
+};
+
+} // namespace libretrodroid
