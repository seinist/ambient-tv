     if (!checkFrameResult(result, "submit frame")) return false;
     bridgeReadPending = false; // this submit consumes the temporary payload
     frameInFlight = true;
     const int exportedFd = exportWrite ? exportBridgeWriteFence() : -1;
+    // WSI already waits for the submitted per-image completion semaphore.
+    // Queue presentation now, rather than delaying it until the host fence.
+    // The fence still gates publication and every resource reuse/retirement.
+    const bool queueNativePresent = useDirect && !shaderFailed && !hasFatalError();
+    VkResult presentResult = VK_SUCCESS;
+    if (queueNativePresent) {
+        const VkSemaphore finished = nativeSdrComplete[sdrIndex];
+        VkPresentInfoKHR present { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+        present.waitSemaphoreCount = 1;
+        present.pWaitSemaphores = &finished;
+        present.swapchainCount = 1;
+        present.pSwapchains = &nativeSdrSwapchain;
+        present.pImageIndices = &sdrIndex;
+        {
+            GameTraceScope presentTrace("AmbientGame Vulkan queue present");
+            std::lock_guard<std::mutex> lock(queueMutex);
+            presentResult = vk.queuePresent(queue, &present);
+        }
+        if (presentResult == VK_ERROR_DEVICE_LOST) {
+            checkFrameResult(presentResult, "present frame");
+        }
+    }
     if (!waitForFrame()) {
         if (exportedFd >= 0) close(exportedFd);
         return false;
     }
