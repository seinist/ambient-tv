diff --git a/src/main/cpp/vulkan/vulkancoresyncindices.h b/src/main/cpp/vulkan/vulkancoresyncindices.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkancoresyncindices.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace libretrodroid {
+
+// The emulation thread owns session/run transitions. Core callbacks may read
+// the published index/mask on worker threads. A session never changes its
+// mask; a new index is published only before the next retro_run().
+class VulkanCoreSyncIndices {
+public:
+    bool open(unsigned count) noexcept {
+        if (opened || active || (count != 1 && count != 2)) return false;
+        opened = true;
+        next = 0;
+        published.store(((1u << count) - 1u) << 1, std::memory_order_release);
+        return true;
+    }
+    uint32_t index() const noexcept { return published.load(std::memory_order_acquire) & 1u; }
+    uint32_t mask() const noexcept { return published.load(std::memory_order_acquire) >> 1; }
+    bool begin() noexcept {
+        if (!opened || active) return false;
+        const auto currentMask = mask();
+        published.store((currentMask << 1) | next, std::memory_order_release);
+        active = true;
+        return true;
+    }
+    void finish() noexcept {
+        if (!active) return;
+        next = mask() == 3u ? (index() ^ 1u) : 0u;
+        active = false;
+    }
+    void cancel() noexcept { active = false; }
+    // Only after the context and its GPU work have safely retired.
+    void resetAfterShutdown() noexcept {
+        active = opened = false;
+        next = 0;
+        published.store(2u, std::memory_order_release);
+    }
+private:
+    // Low bit is index, remaining bits are the advertised sync-index mask.
+    std::atomic<uint32_t> published{2u};
+    bool opened = false;
+    bool active = false;
+    uint32_t next = 0;
+};
+
+} // namespace libretrodroid
