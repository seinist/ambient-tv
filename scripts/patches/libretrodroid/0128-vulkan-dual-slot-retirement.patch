+bool VulkanBackend::canRetireFrameSlots() const noexcept {
+    if ((device && !vk.destroyDevice) || !frameSlot.canRetire(vk, device) ||
+            !spareFrameSlot.canRetire(vk, device)) return false;
+    // Both slots own their handles exclusively. Reject aliased ownership
+    // before any destruction, including cross-role bridge semaphores.
+    const auto aliases = [](auto a, auto b) { return a && a == b; };
+    const auto& a = frameSlot;
+    const auto& b = spareFrameSlot;
+    return !aliases(a.pool, b.pool) && !aliases(a.command, b.command) &&
+        !aliases(a.fence, b.fence) &&
+        !aliases(a.bridgeImage.buffer, b.bridgeImage.buffer) &&
+        !aliases(a.bridgeImage.image, b.bridgeImage.image) &&
+        !aliases(a.bridgeImage.memory, b.bridgeImage.memory) &&
+        !aliases(a.bridgeSync.readSemaphore, b.bridgeSync.readSemaphore) &&
+        !aliases(a.bridgeSync.readSemaphore, b.bridgeSync.writeSemaphore) &&
+        !aliases(a.bridgeSync.writeSemaphore, b.bridgeSync.readSemaphore) &&
+        !aliases(a.bridgeSync.writeSemaphore, b.bridgeSync.writeSemaphore);
+}
+
+bool VulkanBackend::retireFrameSlot(FrameSlot& slot) {
+    if (!slot.canRetire(vk, device)) return false;
+    if (!slot.bridgeImage.retire(slot.inFlight, device != VK_NULL_HANDLE,
+            vk.destroyImage != nullptr, vk.freeMemory != nullptr,
+            [&](VkImage image) { vk.destroyImage(device, image, nullptr); },
+            [&](VkDeviceMemory memory) { vk.freeMemory(device, memory, nullptr); },
+            [](AHardwareBuffer* buffer) { AHardwareBuffer_release(buffer); })) return false;
+    return slot.retire(vk, device);
+}
