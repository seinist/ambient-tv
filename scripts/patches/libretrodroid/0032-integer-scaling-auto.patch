+++ b/src/main/cpp/integerscaling.h
@@ -0,0 +1,36 @@
+/*
+ *     Ambient TV: shared whole-number scaling rule for the GL layout and native Vulkan WSI.
+ *
+ *     This program is free software: you can redistribute it and/or modify
+ *     it under the terms of the GNU General Public License as published by
+ *     the Free Software Foundation, either version 3 of the License, or
+ *     (at your option) any later version.
+ */
+
+#ifndef LIBRETRODROID_INTEGERSCALING_H
+#define LIBRETRODROID_INTEGERSCALING_H
+
+#include <algorithm>
+#include <cmath>
+
+namespace libretrodroid {
+
+/** In automatic mode whole-number scaling is used only when it keeps at least this share of the fitted size. */
+constexpr float INTEGER_SCALING_AUTO_MIN_FILL = 0.9F;
+
+/**
+ * Largest whole-number factor at which a [width] x [height] frame fits the screen, or 0 when the
+ * frame should be fitted normally: smaller than one source frame, or (automatic) too much border.
+ */
+inline int integerScaleFor(float screenWidth, float screenHeight, unsigned width, unsigned height, bool automatic) {
+    if (width == 0 || height == 0 || screenWidth <= 0.0F || screenHeight <= 0.0F) return 0;
+    const float fit = std::min(screenWidth / static_cast<float>(width), screenHeight / static_cast<float>(height));
+    const int whole = static_cast<int>(std::floor(fit));
+    if (whole < 1) return 0;
+    if (automatic && static_cast<float>(whole) / fit < INTEGER_SCALING_AUTO_MIN_FILL) return 0;
+    return whole;
+}
+
+}
+
+#endif
