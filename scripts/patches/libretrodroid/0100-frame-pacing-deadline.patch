diff --git a/src/main/cpp/framepacingdeadline.h b/src/main/cpp/framepacingdeadline.h
new file mode 100644
index 0000000..f438edb
--- /dev/null
+++ b/src/main/cpp/framepacingdeadline.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <chrono>
+#include <cmath>
+
+namespace libretrodroid {
+
+// Render-thread-owned clock. Explicit time arguments keep the pacing policy
+// testable without wall-clock sleeps or Android display hardware.
+class FramePacingDeadline {
+public:
+    using Clock = std::chrono::steady_clock;
+    using TimePoint = Clock::time_point;
+    using Duration = Clock::duration;
+
+    // The existing one-second future-deadline watchdog cannot pace sub-Hz
+    // content. Reject values that would also round to a zero clock interval.
+    static bool validRate(double fps) noexcept {
+        return std::isfinite(fps) && fps >= 1.0 && fps <= 1000000000.0;
+    }
+
+    void setRate(double fps) noexcept {
+        if (!validRate(fps)) return;
+        const auto nanos = std::chrono::nanoseconds(std::llround(1000000000.0 / fps));
+        period = std::chrono::duration_cast<Duration>(nanos);
+        if (period < Duration{1}) period = Duration{1};
+        reset();
+    }
+
+    bool armed() const noexcept { return started; }
+    void reset() noexcept { started = false; }
+    TimePoint target() const noexcept { return deadline; }
+    Duration interval() const noexcept { return period; }
+
+    unsigned advance(TimePoint now, bool vsync) noexcept {
+        if (!started) {
+            started = true;
+            deadline = now + period;
+            return 1;
+        }
+        if (now < deadline || now - deadline < period) {
+            deadline += period;
+            return 1;
+        }
+        if (vsync) {
+            // Match the existing post-stall reanchor on the vsync path.
+            deadline = now + period;
+            return 1;
+        }
+        const auto late = now - deadline;
+        // Skip elapsed deadlines in O(1), preserving fractional phase. The
+        // frontend already caps forward emulation to two frames per step.
+        // Never narrow a potentially huge elapsed-frame count to unsigned.
+        deadline = now - late % period;
+        return late / period >= 2 ? 2u : 1u;
+    }
+
+    TimePoint waitTarget(TimePoint now) noexcept {
+        if (!started || deadline <= now) return now;
+        if (std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count() > 1000) {
+            deadline = now;
+        }
+        return deadline;
+    }
+
+private:
+    bool started = false;
+    TimePoint deadline{};
+    Duration period = std::chrono::duration_cast<Duration>(std::chrono::nanoseconds(16666667));
+};
+
+} // namespace libretrodroid
