Ambient TV patch, 2026-11-19: setInputPortAnalog for netplay, so both analog sticks of every
port reach the core while netplay drives the input (setInputPortState only carries buttons).

diff --git a/src/main/cpp/input.cpp b/src/main/cpp/input.cpp
index f27ac7b..94da153 100644
--- a/src/main/cpp/input.cpp
+++ b/src/main/cpp/input.cpp
@@ -170,6 +170,15 @@ void Input::setNetplayActive(bool active) {
     }
 }
 
+void Input::setInputPortAnalog(unsigned int port, float leftX, float leftY, float rightX, float rightY) {
+    if (port >= 4) return;
+    std::lock_guard<std::mutex> lock(inputMutex);
+    pads[port].joypadLeftXAxis = leftX;
+    pads[port].joypadLeftYAxis = leftY;
+    pads[port].joypadRightXAxis = rightX;
+    pads[port].joypadRightYAxis = rightY;
+}
+
 void Input::setInputPortState(unsigned int port, uint32_t bitmask) {
     if (port >= 4) return;
 
