diff --git a/src/main/cpp/libretro/libretro-common/include/libretro.h b/src/main/cpp/libretro/libretro-common/include/libretro.h
--- a/src/main/cpp/libretro/libretro-common/include/libretro.h
+++ b/src/main/cpp/libretro/libretro-common/include/libretro.h
@@ -500,6 +500,13 @@
 /* Environment callback to be used internally in frontend. */
 #define RETRO_ENVIRONMENT_PRIVATE 0x20000
 
+/* Experimental Libretro HDR presentation/display queries (v1 contract).
+ * Source support is independent of the display's HDR capabilities. */
+#define RETRO_ENVIRONMENT_GET_HDR_METADATA (101 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+#define RETRO_ENVIRONMENT_GET_DISPLAY_METADATA (102 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+#define RETRO_HDR_SOURCE_FORMAT_HDR10_2101010 (1u << 0)
+#define RETRO_HDR_SOURCE_FORMAT_SCRGB_RGBA16F (1u << 1)
+
 /* Environment commands. */
 #define RETRO_ENVIRONMENT_SET_ROTATION  1  /* const unsigned * --
                                             * Sets screen rotation of graphics.
@@ -3184,11 +3191,69 @@
     *
     * It is also natively supported in APIs like OpenGL ES. */
    RETRO_PIXEL_FORMAT_RGB565   = 2,
+   /* SDR 10-bit, packed XRGB (currently refused by Ambient TV). */
+   RETRO_PIXEL_FORMAT_XRGB2101010 = 3,
+   /* Packed PQ / BT.2020 HDR10; requires a real HDR presentation path. */
+   RETRO_PIXEL_FORMAT_HDR10_2101010 = 4,
+   /* Linear extended-range scRGB FP16; requires non-clamping FP16 upload. */
+   RETRO_PIXEL_FORMAT_SCRGB_RGBA16F = 5,
 
    /* Ensure sizeof() == sizeof(int). */
    RETRO_PIXEL_FORMAT_UNKNOWN  = INT_MAX
 };
 
+/* Versioned experimental HDR contract. Callers set version=1 and size before
+ * GET_HDR_METADATA or GET_DISPLAY_METADATA. Do not advertise an unsupported
+ * source format even if the display supports HDR. */
+struct retro_hdr_metadata
+{
+   unsigned version;
+   unsigned size;
+   unsigned output_mode;       /* 0=SDR/unknown, 1=PQ BT.2020, 2=linear Rec.709 */
+   uint32_t source_formats;    /* RETRO_HDR_SOURCE_FORMAT_* */
+   float paper_white_nits;
+   float max_nits;
+   float min_nits;
+   unsigned expand_gamut;
+   float max_cll;
+   float max_fall;
+   unsigned color_primaries;   /* ITU-T H.273 code, 0=unknown */
+   unsigned transfer_function; /* ITU-T H.273 code, 0=unknown */
+   bool passthrough;
+   unsigned tonemap_operator;
+   uint32_t reserved[8];
+};
+
+struct retro_display_geometry
+{
+   unsigned native_width;
+   unsigned native_height;
+   unsigned width_mm;
+   unsigned height_mm;
+   unsigned refresh_min_mHz;
+   unsigned refresh_max_mHz;
+};
+
+struct retro_display_color_caps
+{
+   float peak_nits;
+   float min_nits;
+   float max_frame_avg_nits;
+   uint16_t primaries_xy[8];
+   unsigned supported_eotf_mask;
+   unsigned edid_gamma_x100;
+   unsigned capability_source;
+};
+
+struct retro_display_metadata
+{
+   unsigned version;
+   unsigned size;
+   struct retro_display_geometry geo;
+   struct retro_hdr_metadata hdr;
+   struct retro_display_color_caps caps;
+};
+
 enum retro_savestate_context
 {
    /* Standard savestate written to disk. */
