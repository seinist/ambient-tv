+        // The versioned API may be queried before any Vulkan Surface exists.
+        // Therefore output_mode=0 and source_formats=0 are intentional:
+        // no HDR core-input formats and no active HDR swapchain can be promised.
+        case RETRO_ENVIRONMENT_GET_HDR_METADATA: {
+            if (data == nullptr) return false;
+            auto* query = static_cast<retro_hdr_metadata*>(data);
+            if (query->version != 1 || query->size < sizeof(retro_hdr_metadata)) return false;
+            retro_hdr_metadata state {};
+            state.version = 1;
+            state.size = sizeof(state);
+            // The existing GLES/video path cannot handle HDR10 or scRGB input
+            // even when Vulkan->GLES frame transport happens to support FP16.
+            std::memcpy(query, &state, sizeof(state));
+            return true;
+        }
 
+        case RETRO_ENVIRONMENT_GET_DISPLAY_METADATA: {
+            if (data == nullptr) return false;
+            auto* query = static_cast<retro_display_metadata*>(data);
+            if (query->version != 1 || query->size < sizeof(retro_display_metadata)) return false;
+            retro_display_metadata state {};
+            state.version = 1;
+            state.size = sizeof(state);
+            state.hdr.version = 1;
+            state.hdr.size = sizeof(state.hdr);
+            // No EDID, peak luminance, output EOTF or active HDR signal is
+            // asserted until the real output renderer can report it accurately.
+            // A zero supported_eotf_mask means "unknown", not SDR-only.
+            std::memcpy(query, &state, sizeof(state));
+            return true;
+        }
+
         case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS:
             LOGD("Called SET_INPUT_DESCRIPTORS");
             return false;
