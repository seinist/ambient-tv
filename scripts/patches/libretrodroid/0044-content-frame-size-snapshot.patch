+
+void LibretroDroid::publishContentFrameSize() {
+    // A split screen draws a crop of the frame; its whole-number geometry is not this size.
+    if (!gameLoaded || video == nullptr || screenSplitEnabled) {
+        contentAspectSnapshot.publishFrame(0U, 0U);
+        return;
+    }
+    auto& layout = video->getLayout();
+    contentAspectSnapshot.publishFrame(layout.getDrawnContentWidth(), layout.getDrawnContentHeight());
+}
