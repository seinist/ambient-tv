Ambient TV: publish the drawn source size so the frontend can size the surface to the exact whole-number picture.

diff --git a/src/main/cpp/contentaspect.h b/src/main/cpp/contentaspect.h
index e998d0b..7defe4c 100644
--- a/src/main/cpp/contentaspect.h
+++ b/src/main/cpp/contentaspect.h
@@ -11,6 +11,7 @@
 #define LIBRETRODROID_CONTENTASPECT_H
 
 #include <atomic>
+#include <cstdint>
 #include <cmath>
 
 namespace libretrodroid {
@@ -47,13 +48,31 @@ public:
                     std::memory_order_relaxed);
     }
 
-    void reset() { value.store(0.0F, std::memory_order_relaxed); }
+    /**
+     * Drawn source size (width in the high, height in the low 32 bits), zero when unknown.
+     * The frontend uses it to size the surface to the exact whole-number picture, so the
+     * area beside the picture belongs to its own UI instead of the renderer's black clear.
+     */
+    void publishFrame(unsigned width, unsigned height) {
+        const uint64_t packed = width > 0 && height > 0
+            ? (static_cast<uint64_t>(width) << 32U) | static_cast<uint64_t>(height) : 0U;
+        frame.store(packed, std::memory_order_relaxed);
+    }
+
+    void reset() {
+        value.store(0.0F, std::memory_order_relaxed);
+        frame.store(0U, std::memory_order_relaxed);
+    }
     float get() const { return value.load(std::memory_order_relaxed); }
+    uint64_t getFrame() const { return frame.load(std::memory_order_relaxed); }
 
 private:
     static_assert(std::atomic<float>::is_always_lock_free,
                   "Content aspect observers must never wait for the emulation thread");
+    static_assert(std::atomic<uint64_t>::is_always_lock_free,
+                  "Content frame observers must never wait for the emulation thread");
     std::atomic<float> value{0.0F};
+    std::atomic<uint64_t> frame{0U};
 };
 
 }
