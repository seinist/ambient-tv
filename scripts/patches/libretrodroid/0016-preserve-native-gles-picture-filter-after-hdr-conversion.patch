 ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& config) {
+    // First tonemap a Vulkan core's PQ/HLG frame to SDR, then execute the
+    // *original* built-in picture shader chain without changing its individual
+    // passes, sampling, or CUT3 edge/temporal logic.
+    const auto prepass = config.params.find("AMBIENT_PREPEND");
+    if (prepass != config.params.end()) {
+        if (prepass->second != "1" || config.type == Type::SHADER_CUSTOM ||
+            config.customPasses.size() != 1)
+            return { {}, false };
+        Config unwrapped = config;
+        unwrapped.params.erase("AMBIENT_PREPEND");
+        unwrapped.customPasses.clear();
+        Chain original = getShader(unwrapped);
+        // Native pipeline reserves at most one prefix and four built-in passes.
+        if (original.passes.empty() || original.passes.size() > 4)
+            return { {}, false };
+        original.passes.insert(original.passes.begin(), config.customPasses.front());
+        return original;
+    }
     switch (config.type) {
     case Type::SHADER_DEFAULT: {
         return { { { defaultShaderVertex, defaultShaderFragment, true, 1.0 } }, true };
     }
