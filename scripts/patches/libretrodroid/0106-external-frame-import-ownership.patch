diff --git a/src/main/cpp/externalframelease.h b/src/main/cpp/externalframelease.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/externalframelease.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+namespace libretrodroid {
+
+// The frontend keeps its own AHB reference for as long as an EGL import exists.
+// Ops supplies the actual platform handles and dispatch, or a host test driver.
+// All calls belong to the render thread; this is not a cross-thread GPU fence.
+template<class Ops>
+class ExternalFrameLease {
+public:
+    using Buffer = typename Ops::Buffer;
+    using Display = typename Ops::Display;
+    using Context = typename Ops::Context;
+    using Image = typename Ops::Image;
+    using Texture = typename Ops::Texture;
+    using Destroy = typename Ops::Destroy;
+
+    ExternalFrameLease() = default;
+    ExternalFrameLease(const ExternalFrameLease&) = delete;
+    ExternalFrameLease& operator=(const ExternalFrameLease&) = delete;
+
+    bool matches(Buffer candidate, Display currentDisplay, Context currentContext,
+                 Texture texture) const noexcept {
+        return buffer && candidate == buffer && image && texture &&
+               display == currentDisplay && context == currentContext;
+    }
+
+    void adopt(Buffer acquiredBuffer, Display ownerDisplay, Context ownerContext,
+               Image importedImage, Destroy destroyImage) noexcept {
+        buffer = acquiredBuffer;
+        display = ownerDisplay;
+        context = ownerContext;
+        image = importedImage;
+        destroy = destroyImage;
+    }
+
+    bool ownsContext(Display currentDisplay, Context currentContext) const noexcept {
+        return image && display && context && display == currentDisplay && context == currentContext;
+    }
+
+    void finishUse(Texture texture, Display currentDisplay, Context currentContext, Ops& ops) const {
+        if (texture && ownsContext(currentDisplay, currentContext)) ops.finish();
+    }
+
+    void release(Texture& texture, Display currentDisplay, Context currentContext, Ops& ops) {
+        // Texture names are local to the context/share group. A surface recreation
+        // may already have made an unrelated context current; never delete its name.
+        if (texture && ownsContext(currentDisplay, currentContext)) {
+            ops.finish();
+            ops.deleteTexture(texture);
+        }
+        texture = {};
+        if (image && destroy) ops.destroyImage(destroy, display, image);
+        if (buffer) ops.releaseBuffer(buffer);
+        buffer = {};
+        display = {};
+        context = {};
+        image = {};
+        destroy = {};
+    }
+
+private:
+    Buffer buffer{};
+    Display display{};
+    Context context{};
+    Image image{};
+    Destroy destroy{};
+};
+
+} // namespace libretrodroid
