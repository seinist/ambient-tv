+
+bool Video::attachExternalFrame(AHardwareBuffer* buffer, unsigned int width, unsigned int height) {
+    if (!externalFrames || buffer == nullptr) return false;
+    const EGLDisplay display = eglGetCurrentDisplay();
+    const EGLContext context = eglGetCurrentContext();
+    if (display == EGL_NO_DISPLAY || context == EGL_NO_CONTEXT) return false;
+
+    // A buffer and its texture may be reused only within the same EGL context.
+    // The AHB reference prevents recycling its identity while this import lives.
+    if (externalFrame.matches(buffer, display, context, hwRenderTexture)) return true;
+
+    auto getClientBuffer = reinterpret_cast<PFNEGLGETNATIVECLIENTBUFFERANDROIDPROC>(
+        eglGetProcAddress("eglGetNativeClientBufferANDROID"));
+    auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    auto targetTexture = reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(
+        eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+    if (getClientBuffer == nullptr || createImage == nullptr || destroyImage == nullptr || targetTexture == nullptr) {
+        LOGE("EGL cannot import AHardwareBuffer frames on this device");
+        return false;
+    }
+    const auto clientBuffer = getClientBuffer(buffer);
+    if (clientBuffer == nullptr) return false;
+
+    releaseExternalFrame();
+
+    AHardwareBuffer_acquire(buffer);
+    EGLint attributes[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+    const EGLImageKHR image = createImage(
+        display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, clientBuffer, attributes);
+    if (image == EGL_NO_IMAGE_KHR) {
+        LOGE("eglCreateImageKHR failed for the Vulkan frame buffer: 0x%x", eglGetError());
+        AHardwareBuffer_release(buffer);
+        return false;
+    }
+    externalFrame.adopt(buffer, display, context, image, destroyImage);
+
+    // Bound the old-error drain even if the context/driver is broken. Do not
+    // discard errors from creating/binding the new texture itself.
+    GLenum error = GL_NO_ERROR;
+    for (unsigned i = 0; i < 16; ++i) {
+        error = glGetError();
+        if (error == GL_NO_ERROR) break;
+    }
+    if (error != GL_NO_ERROR) {
+        releaseExternalFrame();
+        return false;
+    }
+
+    glGenTextures(1, &hwRenderTexture);
+    glBindTexture(GL_TEXTURE_2D, hwRenderTexture);
+    targetTexture(GL_TEXTURE_2D, static_cast<GLeglImageOES>(image));
+    // A driver can accept FP16 in Vulkan but fail to import/sample it in GLES.
+    const GLenum importError = glGetError();
+    if (hwRenderTexture == 0 || importError != GL_NO_ERROR) {
+        LOGW("EGLImage to GLES texture import failed: 0x%x", importError);
+        glBindTexture(GL_TEXTURE_2D, 0);
+        releaseExternalFrame();
+        return false;
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    const GLenum samplerError = glGetError();
+    if (samplerError != GL_NO_ERROR) {
+        LOGW("Imported Vulkan texture setup failed: 0x%x", samplerError);
+        releaseExternalFrame();
+        return false;
+    }
+
+    hwFBOWidth = width;
+    hwFBOHeight = height;
+    if (renderer != nullptr) {
+        renderer->updateRenderedResolution(width, height);
+    }
+    LOGI("Vulkan frame buffer imported into GLES: tex=%u %ux%u", hwRenderTexture, width, height);
+    return true;
+}
