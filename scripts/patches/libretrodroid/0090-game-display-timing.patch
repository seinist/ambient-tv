+// Called on the owning GL thread after Android confirms its actual display mode.
+// Use software timing for an opted-in game: a 59.73 Hz core on a 60 Hz panel
+// must not run at a different emulation speed just to satisfy HDMI cadence.
+void LibretroDroid::setGameDisplayTiming(float refreshRate, bool strictTiming) {
+    if (!gameLoaded || !fpsSync || !audio || !std::isfinite(refreshRate) || refreshRate <= 0.0f) return;
+    if (std::abs(screenRefreshRate - refreshRate) < 0.001f && forceSoftwareTiming == strictTiming) return;
+    const double fps = Environment::getInstance().getGameTimingFps();
+    const double sampleRate = Environment::getInstance().getGameTimingSampleRate();
+    if (!std::isfinite(fps) || fps <= 0.0 || !std::isfinite(sampleRate) || sampleRate <= 0.0) return;
+    screenRefreshRate = refreshRate;
+    forceSoftwareTiming = strictTiming;
+    fpsSync = std::make_unique<FPSSync>(fps, screenRefreshRate, forceSoftwareTiming);
+    if (bfiEnabled) fpsSync->setExternalTimingControl(true);
+    audio->updateTiming(static_cast<int32_t>(std::lround(sampleRate * fpsSync->getTimeStretchFactor())), fps);
+    audio->resetBufferState();
+    updateAudioSampleRateMultiplier();
+}
