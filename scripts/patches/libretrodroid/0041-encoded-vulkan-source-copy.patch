diff --git a/src/main/cpp/vulkan/vulkancolorcopy.cpp b/src/main/cpp/vulkan/vulkancolorcopy.cpp
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkancolorcopy.cpp
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "vulkancolorcopy.h"
+
+#include <limits>
+
+namespace libretrodroid {
+namespace {
+constexpr uint64_t MAX_CACHE_BYTES = 128ull * 1024ull * 1024ull;
+constexpr uint32_t MAX_SOURCE_DIMENSION = 8192;
+
+bool componentIs(VkComponentSwizzle actual, VkComponentSwizzle identity, VkComponentSwizzle wanted) {
+    return (actual == VK_COMPONENT_SWIZZLE_IDENTITY ? identity : actual) == wanted;
+}
+
+void transition(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands, VkImage image,
+                VkImageLayout before, VkImageLayout after,
+                VkAccessFlags sourceAccess, VkAccessFlags destinationAccess,
+                VkPipelineStageFlags sourceStage) {
+    VkImageMemoryBarrier info { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    info.srcAccessMask = sourceAccess;
+    info.dstAccessMask = destinationAccess;
+    info.oldLayout = before;
+    info.newLayout = after;
+    info.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    info.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    info.image = image;
+    info.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    barrier(commands, sourceStage, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+            0, nullptr, 0, nullptr, 1, &info);
+}
+}
+
+VkFormat VulkanColorCopy::encodedFormat(VkFormat viewFormat, const VkComponentMapping& components) {
+    const bool same = componentIs(components.r, VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_R) &&
+        componentIs(components.g, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_G) &&
+        componentIs(components.b, VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_B) &&
+        componentIs(components.a, VK_COMPONENT_SWIZZLE_A, VK_COMPONENT_SWIZZLE_A);
+    const bool swap = componentIs(components.r, VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_B) &&
+        componentIs(components.g, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_G) &&
+        componentIs(components.b, VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_R) &&
+        componentIs(components.a, VK_COMPONENT_SWIZZLE_A, VK_COMPONENT_SWIZZLE_A);
+    if (!same && !swap) return VK_FORMAT_UNDEFINED;
+    switch (viewFormat) {
+        case VK_FORMAT_R8G8B8A8_UNORM:
+        case VK_FORMAT_R8G8B8A8_SRGB:
+            return same ? VK_FORMAT_R8G8B8A8_UNORM : VK_FORMAT_B8G8R8A8_UNORM;
+        case VK_FORMAT_B8G8R8A8_UNORM:
+        case VK_FORMAT_B8G8R8A8_SRGB:
+            return same ? VK_FORMAT_B8G8R8A8_UNORM : VK_FORMAT_R8G8B8A8_UNORM;
+        case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+            return same ? VK_FORMAT_A2B10G10R10_UNORM_PACK32 : VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+        case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+            return same ? VK_FORMAT_A2R10G10B10_UNORM_PACK32 : VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+        case VK_FORMAT_R16G16B16A16_SFLOAT:
+            return same ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_UNDEFINED;
+        default:
+            return VK_FORMAT_UNDEFINED;
+    }
+}
+
+bool VulkanColorCopy::validSubresource(const Source& source) {
+    return (source.viewType == VK_IMAGE_VIEW_TYPE_2D || source.viewType == VK_IMAGE_VIEW_TYPE_2D_ARRAY) &&
+        source.range.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT && source.range.levelCount != 0 &&
+        source.range.layerCount != 0 && source.range.baseMipLevel != std::numeric_limits<uint32_t>::max() &&
+        source.range.baseArrayLayer != std::numeric_limits<uint32_t>::max();
+}
+
+bool VulkanColorCopy::initialize(VkInstance instance, VkPhysicalDevice physical, VkDevice logical,
+                                 PFN_vkGetInstanceProcAddr getInstanceProcAddr) {
+    if (device == logical && gpu == physical && device != VK_NULL_HANDLE) return true;
+    release();
+    if (logical == VK_NULL_HANDLE || physical == VK_NULL_HANDLE || !getInstanceProcAddr) {
+        return fail("Vulkan device unavailable");
+    }
+    const auto getDeviceProcAddr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+        getInstanceProcAddr(instance, "vkGetDeviceProcAddr"));
+    if (!getDeviceProcAddr) return fail("Vulkan dispatch unavailable");
+    auto load = [&](const char* name) { return getDeviceProcAddr(logical, name); };
+    vk.formatProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceFormatProperties>(
+        getInstanceProcAddr(instance, "vkGetPhysicalDeviceFormatProperties"));
+    vk.memoryProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(
+        getInstanceProcAddr(instance, "vkGetPhysicalDeviceMemoryProperties"));
+    vk.deviceProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+        getInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties"));
+    vk.createImage = reinterpret_cast<PFN_vkCreateImage>(load("vkCreateImage"));
+    vk.destroyImage = reinterpret_cast<PFN_vkDestroyImage>(load("vkDestroyImage"));
+    vk.imageMemoryRequirements = reinterpret_cast<PFN_vkGetImageMemoryRequirements>(load("vkGetImageMemoryRequirements"));
+    vk.allocateMemory = reinterpret_cast<PFN_vkAllocateMemory>(load("vkAllocateMemory"));
+    vk.freeMemory = reinterpret_cast<PFN_vkFreeMemory>(load("vkFreeMemory"));
+    vk.bindImageMemory = reinterpret_cast<PFN_vkBindImageMemory>(load("vkBindImageMemory"));
+    vk.copyImage = reinterpret_cast<PFN_vkCmdCopyImage>(load("vkCmdCopyImage"));
+    vk.blitImage = reinterpret_cast<PFN_vkCmdBlitImage>(load("vkCmdBlitImage"));
+    vk.barrier = reinterpret_cast<PFN_vkCmdPipelineBarrier>(load("vkCmdPipelineBarrier"));
+    if (!vk.formatProperties || !vk.memoryProperties || !vk.deviceProperties || !vk.createImage ||
+        !vk.destroyImage || !vk.imageMemoryRequirements || !vk.allocateMemory || !vk.freeMemory ||
+        !vk.bindImageMemory || !vk.copyImage || !vk.blitImage || !vk.barrier) {
+        vk = {};
+        return fail("Vulkan color-copy dispatch incomplete");
+    }
+    device = logical;
+    gpu = physical;
+    failure = "";
+    return true;
+}
+
+bool VulkanColorCopy::prepare(const Source& source, VkFormat bridgeFormat,
+                              uint32_t bridgeWidth, uint32_t bridgeHeight) {
+    prepared = false;
+    if (device == VK_NULL_HANDLE) return fail("Vulkan color-copy not initialized");
+    format = encodedFormat(source.viewFormat, source.components);
+    if (format == VK_FORMAT_UNDEFINED) return fail("unsupported view format or component mapping");
+    if (!validSubresource(source)) return fail("unsupported image view subresource");
+    width = source.width;
+    height = source.height;
+    if (!width || !height || width > MAX_SOURCE_DIMENSION || height > MAX_SOURCE_DIMENSION ||
+        width > bridgeWidth || height > bridgeHeight) return fail("invalid source or bridge extent");
+    if (bridgeFormat != VK_FORMAT_R8G8B8A8_UNORM && bridgeFormat != VK_FORMAT_R16G16B16A16_SFLOAT) {
+        return fail("unsupported bridge format");
+    }
+    direct = format == VK_FORMAT_R8G8B8A8_UNORM && bridgeFormat == format &&
+        width == bridgeWidth && height == bridgeHeight;
+    if (direct) {
+        destroyCache();
+        prepared = true;
+        failure = "";
+        return true;
+    }
+    const uint64_t bytesPerPixel = format == VK_FORMAT_R16G16B16A16_SFLOAT ? 8 : 4;
+    if (uint64_t(width) * height * bytesPerPixel > MAX_CACHE_BYTES) {
+        return fail("normalized source exceeds 128 MiB cache budget");
+    }
+    if (cache && cacheFormat == format && cacheWidth == width && cacheHeight == height &&
+        cacheBridgeFormat == bridgeFormat) {
+        prepared = true;
+        failure = "";
+        return true;
+    }
+    VkPhysicalDeviceProperties properties {};
+    vk.deviceProperties(gpu, &properties);
+    if (width > properties.limits.maxImageDimension2D || height > properties.limits.maxImageDimension2D) {
+        return fail("normalized source exceeds device image limit");
+    }
+    VkFormatProperties sourceProperties {}, destinationProperties {};
+    vk.formatProperties(gpu, format, &sourceProperties);
+    vk.formatProperties(gpu, bridgeFormat, &destinationProperties);
+    const VkFormatFeatureFlags required = VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if ((sourceProperties.optimalTilingFeatures & required) != required ||
+        !(destinationProperties.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT)) {
+        return fail("normalized format conversion unavailable on device");
+    }
+    if (cache && cacheFormat == format && cacheWidth == width && cacheHeight == height) {
+        // A transport precision change needs fresh destination feature validation,
+        // but can reuse the exact same normalized source allocation.
+        cacheBridgeFormat = bridgeFormat;
+        prepared = true;
+        failure = "";
+        return true;
+    }
+    destroyCache(); // caller has completed its preceding frame
+    VkImageCreateInfo imageInfo { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = format;
+    imageInfo.extent = { width, height, 1 };
+    imageInfo.mipLevels = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vk.createImage(device, &imageInfo, nullptr, &cache) != VK_SUCCESS) {
+        cache = VK_NULL_HANDLE;
+        return fail("normalized image allocation failed");
+    }
+    VkMemoryRequirements requirements {};
+    vk.imageMemoryRequirements(device, cache, &requirements);
+    if (requirements.size > MAX_CACHE_BYTES) {
+        destroyCache();
+        return fail("normalized device allocation exceeds 128 MiB budget");
+    }
+    VkPhysicalDeviceMemoryProperties memoryProperties {};
+    vk.memoryProperties(gpu, &memoryProperties);
+    uint32_t memoryIndex = memoryProperties.memoryTypeCount;
+    for (uint32_t i = 0; i < memoryProperties.memoryTypeCount; ++i) {
+        if ((requirements.memoryTypeBits & (1u << i)) == 0) continue;
+        if (memoryIndex == memoryProperties.memoryTypeCount) memoryIndex = i;
+        if (memoryProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) {
+            memoryIndex = i;
+            break;
+        }
+    }
+    VkMemoryAllocateInfo allocation { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    allocation.allocationSize = requirements.size;
+    allocation.memoryTypeIndex = memoryIndex;
+    if (memoryIndex == memoryProperties.memoryTypeCount ||
+        vk.allocateMemory(device, &allocation, nullptr, &memory) != VK_SUCCESS ||
+        vk.bindImageMemory(device, cache, memory, 0) != VK_SUCCESS) {
+        destroyCache();
+        return fail("normalized image memory allocation failed");
+    }
+    cacheFormat = format;
+    cacheBridgeFormat = bridgeFormat;
+    cacheWidth = width;
+    cacheHeight = height;
+    prepared = true;
+    failure = "";
+    return true;
+}
+
+VulkanColorCopy::Image VulkanColorCopy::preparedImage(VkImage bridge) const {
+    if (!prepared) return {};
+    return { direct ? bridge : cache, format, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, width, height, direct };
+}
+
+VulkanColorCopy::Image VulkanColorCopy::record(VkCommandBuffer commands, VkImage source,
+        VkImageLayout sourceLayout, const Source& descriptor, VkImage bridge) {
+    if (!prepared) return {};
+    const VkImage destination = direct ? bridge : cache;
+    if (!direct) {
+        // Last frame's cache has completed, and every current texel is overwritten.
+        transition(vk.barrier, commands, cache, VK_IMAGE_LAYOUT_UNDEFINED,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT,
+                   VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT);
+    }
+    VkImageCopy copy {};
+    copy.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, descriptor.range.baseMipLevel,
+                           descriptor.range.baseArrayLayer, 1 };
+    copy.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    copy.extent = { width, height, 1 };
+    // Copy preserves bits; unlike blit it cannot perform an implicit sRGB EOTF.
+    vk.copyImage(commands, source, sourceLayout, destination,
+                 VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    transition(vk.barrier, commands, destination, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+               VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    if (!direct) {
+        VkImageBlit blit {};
+        blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        blit.srcOffsets[1] = { static_cast<int32_t>(width), static_cast<int32_t>(height), 1 };
+        blit.dstOffsets[1] = blit.srcOffsets[1];
+        // Only known non-sRGB formats reach this conversion. PQ/HLG code values
+        // remain encoded; any verified HDR decoding belongs to the display shader.
+        vk.blitImage(commands, cache, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, bridge,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+    }
+    return preparedImage(bridge);
+}
+
+void VulkanColorCopy::destroyCache() {
+    if (device && cache) vk.destroyImage(device, cache, nullptr);
+    if (device && memory) vk.freeMemory(device, memory, nullptr);
+    cache = VK_NULL_HANDLE;
+    memory = VK_NULL_HANDLE;
+    cacheFormat = VK_FORMAT_UNDEFINED;
+    cacheBridgeFormat = VK_FORMAT_UNDEFINED;
+    cacheWidth = cacheHeight = 0;
+}
+
+void VulkanColorCopy::release() {
+    destroyCache();
+    device = VK_NULL_HANDLE;
+    gpu = VK_NULL_HANDLE;
+    vk = {};
+    prepared = false;
+    failure = "not initialized";
+}
+
+} // namespace libretrodroid
