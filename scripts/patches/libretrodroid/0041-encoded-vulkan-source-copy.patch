+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#ifndef LIBRETRODROID_VULKANCOLORCOPY_H
+#define LIBRETRODROID_VULKANCOLORCOPY_H
+
+#include <vulkan/vulkan.h>
+#include <cstdint>
+
+namespace libretrodroid {
+
+/**
+ * Preserve the core view's encoded RGB code values before any format conversion.
+ *
+ * VkImageViewCreateInfo does not reveal its image's creation format. Blitting that
+ * image may silently decode sRGB even when the view is UNORM (or do the opposite).
+ * A raw compatible-size copy into a known non-sRGB format avoids this ambiguity.
+ * Frontend SDR filters expect encoded values; this is not an HDR/linear conversion.
+ * Only the explicit formats and identity / exact R-B component mappings below are
+ * accepted. Other mappings fail closed instead of pretending to support their colors.
+ *
+ * The caller owns source/destination synchronization and must complete the preceding
+ * frame before prepare(), release() or destruction. The tightly sized cache gives
+ * Slang the real source extent even when the shared AHB has grown and later shrunk.
+ */
+class VulkanColorCopy {
+public:
+    struct Source {
+        VkFormat viewFormat = VK_FORMAT_UNDEFINED;
+        VkComponentMapping components {};
+        VkImageViewType viewType = VK_IMAGE_VIEW_TYPE_2D;
+        VkImageSubresourceRange range { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        uint32_t width = 0;
+        uint32_t height = 0;
+    };
+    struct Image {
+        VkImage image = VK_NULL_HANDLE;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+        uint32_t width = 0;
+        uint32_t height = 0;
+        bool sharedBridge = false;
+    };
+
+    VulkanColorCopy() = default;
+    VulkanColorCopy(const VulkanColorCopy&) = delete;
+    VulkanColorCopy& operator=(const VulkanColorCopy&) = delete;
+
+    static VkFormat encodedFormat(VkFormat viewFormat, const VkComponentMapping& components);
+    static bool validSubresource(const Source& source);
+    bool initialize(VkInstance instance, VkPhysicalDevice gpu, VkDevice device,
+                    PFN_vkGetInstanceProcAddr getInstanceProcAddr);
+    bool prepare(const Source& source, VkFormat bridgeFormat, uint32_t bridgeWidth, uint32_t bridgeHeight);
+    // Source is already TRANSFER_SRC/GENERAL; bridge is already TRANSFER_DST.
+    // The returned source is TRANSFER_SRC and contains current, unpadded texels.
+    Image record(VkCommandBuffer commands, VkImage source, VkImageLayout sourceLayout,
+                 const Source& descriptor, VkImage bridge);
+    Image preparedImage(VkImage bridge) const;
+    bool usesCache() const { return !direct; }
+    const char* error() const { return failure; }
+    void release();
+
+private:
+    struct Dispatch {
+        PFN_vkGetPhysicalDeviceFormatProperties formatProperties = nullptr;
+        PFN_vkGetPhysicalDeviceMemoryProperties memoryProperties = nullptr;
+        PFN_vkGetPhysicalDeviceProperties deviceProperties = nullptr;
+        PFN_vkCreateImage createImage = nullptr;
+        PFN_vkDestroyImage destroyImage = nullptr;
+        PFN_vkGetImageMemoryRequirements imageMemoryRequirements = nullptr;
+        PFN_vkAllocateMemory allocateMemory = nullptr;
+        PFN_vkFreeMemory freeMemory = nullptr;
+        PFN_vkBindImageMemory bindImageMemory = nullptr;
+        PFN_vkCmdCopyImage copyImage = nullptr;
+        PFN_vkCmdBlitImage blitImage = nullptr;
+        PFN_vkCmdPipelineBarrier barrier = nullptr;
+    } vk;
+    bool fail(const char* reason) { failure = reason; return false; }
+    void destroyCache();
+    VkDevice device = VK_NULL_HANDLE;
+    VkPhysicalDevice gpu = VK_NULL_HANDLE;
+    VkImage cache = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkFormat cacheFormat = VK_FORMAT_UNDEFINED;
+    VkFormat cacheBridgeFormat = VK_FORMAT_UNDEFINED;
+    uint32_t cacheWidth = 0;
+    uint32_t cacheHeight = 0;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    bool direct = false;
+    bool prepared = false;
+    const char* failure = "not initialized";
+};
+
+} // namespace libretrodroid
+#endif
