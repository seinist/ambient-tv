+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <libretro.h>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+
+#if defined(__i386__) || defined(__x86_64__)
+#include <cpuid.h>
+#endif
+#if defined(__linux__) && (defined(__arm__) || defined(__aarch64__))
+#include <sys/auxv.h>
+#include <asm/hwcap.h>
+#endif
+#if defined(__ANDROID__)
+#include <android/log.h>
+#endif
+
+namespace libretrodroid::coreperf {
+
+inline retro_perf_tick_t RETRO_CALLCONV counter() {
+    using namespace std::chrono;
+    return static_cast<retro_perf_tick_t>(
+        duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count());
+}
+
+inline retro_time_t RETRO_CALLCONV timeUsec() {
+    return static_cast<retro_time_t>(counter() / 1000u);
+}
+
+// Pure decoding allows tests of unsupported AVX OS state on any host.
+// XCR0 is only read at runtime after CPUID reports XSAVE, OSXSAVE and AVX.
+inline uint64_t x86Features(unsigned ecx, unsigned edx, unsigned leaf7ebx, uint64_t xcr0) {
+    const auto bit = [](unsigned value, unsigned n) { return (value & (1u << n)) != 0; };
+    uint64_t result = 0;
+    if (bit(edx, 15)) result |= RETRO_SIMD_CMOV;
+    if (bit(edx, 23)) result |= RETRO_SIMD_MMX;
+    if (bit(edx, 25)) result |= RETRO_SIMD_SSE | RETRO_SIMD_MMXEXT;
+    if (bit(edx, 26)) result |= RETRO_SIMD_SSE2;
+    if (bit(ecx, 0)) result |= RETRO_SIMD_SSE3;
+    if (bit(ecx, 9)) result |= RETRO_SIMD_SSSE3;
+    if (bit(ecx, 19)) result |= RETRO_SIMD_SSE4;
+    if (bit(ecx, 20)) result |= RETRO_SIMD_SSE42;
+    if (bit(ecx, 22)) result |= RETRO_SIMD_MOVBE;
+    if (bit(ecx, 23)) result |= RETRO_SIMD_POPCNT;
+    if (bit(ecx, 25)) result |= RETRO_SIMD_AES;
+    if (bit(ecx, 26) && bit(ecx, 27) && bit(ecx, 28) && (xcr0 & 6u) == 6u) {
+        result |= RETRO_SIMD_AVX;
+        if (bit(leaf7ebx, 5)) result |= RETRO_SIMD_AVX2;
+    }
+    return result;
+}
+
+inline uint64_t detectFeatures() {
+#if defined(__i386__) || defined(__x86_64__)
+    unsigned eax = 0, ebx = 0, ecx = 0, edx = 0;
+    if (!__get_cpuid(1, &eax, &ebx, &ecx, &edx)) return 0;
+    uint64_t xcr0 = 0;
+    constexpr unsigned avxMask = (1u << 26) | (1u << 27) | (1u << 28);
+    if ((ecx & avxMask) == avxMask) {
+        unsigned low = 0, high = 0;
+        // Encode XGETBV directly: compiling the baseline must not require -mxsave.
+        __asm__ volatile(".byte 0x0f, 0x01, 0xd0" : "=a"(low), "=d"(high) : "c"(0));
+        xcr0 = (static_cast<uint64_t>(high) << 32) | low;
+    }
+    unsigned leaf7ebx = 0;
+    if (__get_cpuid_max(0, nullptr) >= 7) {
+        unsigned a = 0, c = 0, d = 0;
+        __cpuid_count(7, 0, a, leaf7ebx, c, d);
+    }
+    return x86Features(ecx, edx, leaf7ebx, xcr0);
+#elif defined(__linux__) && (defined(__arm__) || defined(__aarch64__))
+    const unsigned long hwcap = getauxval(AT_HWCAP);
+    uint64_t result = 0;
+#if defined(__aarch64__)
+#ifdef HWCAP_ASIMD
+    if (hwcap & HWCAP_ASIMD) result |= RETRO_SIMD_NEON | RETRO_SIMD_ASIMD;
+#endif
+#ifdef HWCAP_AES
+    if (hwcap & HWCAP_AES) result |= RETRO_SIMD_AES;
+#endif
+#else
+#ifdef HWCAP_NEON
+    if (hwcap & HWCAP_NEON) result |= RETRO_SIMD_NEON;
+#endif
+#ifdef HWCAP_VFPv3
+    if (hwcap & HWCAP_VFPv3) result |= RETRO_SIMD_VFPV3;
+#endif
+#ifdef HWCAP_VFPv4
+    if (hwcap & HWCAP_VFPv4) result |= RETRO_SIMD_VFPV4;
+#endif
+#ifdef HWCAP2_AES
+    if (getauxval(AT_HWCAP2) & HWCAP2_AES) result |= RETRO_SIMD_AES;
+#endif
+#endif
+    return result;
+#else
+    return 0;
+#endif
+}
+
+inline uint64_t RETRO_CALLCONV cpuFeatures() {
+    static const uint64_t features = detectFeatures();
+    return features;
+}
+
+// Only copied diagnostic data survives a callback. Never retain or dereference
+// a core-owned counter or string after the callback returns. Bounded storage
+// is used only by cores that explicitly opt into the performance counter API.
+struct Record {
+    uintptr_t key = 0;
+    std::array<char, 96> name{};
+    retro_perf_tick_t total = 0;
+    retro_perf_tick_t calls = 0;
+};
+inline std::array<Record, 64> records{};
+inline std::mutex recordsMutex;
+
+inline void clear() {
+    std::lock_guard<std::mutex> lock(recordsMutex);
+    records = {};
+}
+
+inline void RETRO_CALLCONV registerCounter(retro_perf_counter* value) {
+    if (!value || !value->ident) return;
+    const auto key = reinterpret_cast<uintptr_t>(value);
+    std::lock_guard<std::mutex> lock(recordsMutex);
+    Record* freeRecord = nullptr;
+    for (auto& entry : records) {
+        if (entry.key == key) {
+            freeRecord = &entry;
+            break;
+        }
+        if (!entry.key && !freeRecord) freeRecord = &entry;
+    }
+    if (freeRecord) {
+        *freeRecord = {};
+        freeRecord->key = key;
+        std::snprintf(freeRecord->name.data(), freeRecord->name.size(), "%.95s", value->ident);
+        freeRecord->total = value->total;
+        freeRecord->calls = value->call_cnt;
+    }
+    // Overflow still provides correct core-local counters; only the log is bounded.
+    value->registered = true;
+}
+
+inline void RETRO_CALLCONV start(retro_perf_counter* value) {
+    if (!value || !value->registered) return;
+    ++value->call_cnt;
+    value->start = counter();
+}
+
+inline void RETRO_CALLCONV stop(retro_perf_counter* value) {
+    if (!value || !value->registered) return;
+    const auto end = counter();
+    if (end >= value->start) value->total += end - value->start;
+    const auto key = reinterpret_cast<uintptr_t>(value);
+    std::lock_guard<std::mutex> lock(recordsMutex);
+    for (auto& entry : records) {
+        if (entry.key == key) {
+            entry.total = value->total;
+            entry.calls = value->call_cnt;
+            break;
+        }
+    }
+}
+
+inline void RETRO_CALLCONV log() {
+    std::array<Record, 64> snapshot{};
+    {
+        std::lock_guard<std::mutex> lock(recordsMutex);
+        snapshot = records;
+    }
+    for (const auto& entry : snapshot) {
+        if (!entry.key || !entry.calls) continue;
+#if defined(__ANDROID__)
+        __android_log_print(ANDROID_LOG_INFO, "libretrodroid",
+            "Core perf %s: %llu calls, %llu ns average", entry.name.data(),
+            static_cast<unsigned long long>(entry.calls),
+            static_cast<unsigned long long>(entry.total / entry.calls));
+#else
+        std::fprintf(stderr, "Core perf %s: %llu calls, %llu ns average\n", entry.name.data(),
+            static_cast<unsigned long long>(entry.calls),
+            static_cast<unsigned long long>(entry.total / entry.calls));
+#endif
+    }
+}
+
+inline bool provide(void* data) {
+    if (!data) return false;
+    *static_cast<retro_perf_callback*>(data) = {
+        timeUsec, cpuFeatures, counter, registerCounter, start, stop, log
+    };
+    return true;
+}
+} // namespace libretrodroid::coreperf
