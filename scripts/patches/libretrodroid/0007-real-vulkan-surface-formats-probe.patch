+uint32_t VulkanBackend::probeRealDisplaySurfaceFormats(ANativeWindow* window) {
+    // This method is diagnostic only. The existing Vulkan->GLES compositor
+    // remains the sole presenter until a separate window swapchain backend is
+    // implemented and validated. Do not query the offscreen AImageReader!
+    if (!isStarted() || window == nullptr || surface == VK_NULL_HANDLE ||
+        vk.createAndroidSurface == nullptr || vk.destroySurface == nullptr ||
+        vk.getPhysicalDeviceSurfaceSupport == nullptr ||
+        vk.getPhysicalDeviceSurfaceFormats == nullptr ||
+        vk.enumerateDeviceExtensionProperties == nullptr) {
+        return 0;
+    }
+
+    // The existing core device must support swapchains, not only Vulkan rendering.
+    uint32_t extensionCount = 0;
+    if (vk.enumerateDeviceExtensionProperties(gpu, nullptr, &extensionCount, nullptr) != VK_SUCCESS)
+        return 0;
+    std::vector<VkExtensionProperties> extensions(extensionCount);
+    if (vk.enumerateDeviceExtensionProperties(gpu, nullptr, &extensionCount, extensions.data()) != VK_SUCCESS ||
+        !hasExtension(extensions, VK_KHR_SWAPCHAIN_EXTENSION_NAME))
+        return 0;
+
+    VkAndroidSurfaceCreateInfoKHR info { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    info.window = window;
+    VkSurfaceKHR realSurface = VK_NULL_HANDLE;
+    if (vk.createAndroidSurface(instance, &info, nullptr, &realSurface) != VK_SUCCESS ||
+        realSurface == VK_NULL_HANDLE) {
+        LOGW("Cannot create Vulkan surface for real display capability probe");
+        return 0;
+    }
+
+    uint32_t flags = 0;
+    do {
+        VkBool32 present = VK_FALSE;
+        if (vk.getPhysicalDeviceSurfaceSupport(gpu, queueFamily, realSurface, &present) != VK_SUCCESS ||
+            present == VK_FALSE)
+            break;
+
+        uint32_t count = 0;
+        if (vk.getPhysicalDeviceSurfaceFormats(gpu, realSurface, &count, nullptr) != VK_SUCCESS ||
+            count == 0)
+            break;
+        std::vector<VkSurfaceFormatKHR> formats(count);
+        const VkResult result = vk.getPhysicalDeviceSurfaceFormats(gpu, realSurface, &count, formats.data());
+        if (result != VK_SUCCESS && result != VK_INCOMPLETE) break;
+        flags = 1; // The existing graphics queue can present to this window.
+        for (uint32_t i = 0; i < count; ++i) {
+            const VkSurfaceFormatKHR& candidate = formats[i];
+            const bool rgba8 =
+                candidate.format == VK_FORMAT_R8G8B8A8_UNORM ||
+                candidate.format == VK_FORMAT_B8G8R8A8_UNORM ||
+                candidate.format == VK_FORMAT_R8G8B8A8_SRGB ||
+                candidate.format == VK_FORMAT_B8G8R8A8_SRGB;
+            const bool rgb10 =
+                candidate.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32 ||
+                candidate.format == VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+            const bool fp16 = candidate.format == VK_FORMAT_R16G16B16A16_SFLOAT;
+            if (rgba8 && candidate.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR)
+                flags |= 2;
+            if (rgb10 && candidate.colorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT)
+                flags |= 4;
+            if (rgb10 && candidate.colorSpace == VK_COLOR_SPACE_HDR10_HLG_EXT)
+                flags |= 8;
+            if (fp16 && candidate.colorSpace == VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT)
+                flags |= 16;
+        }
+    } while (false);
+
+    vk.destroySurface(instance, realSurface, nullptr);
+    // Only *available* formats; not actual swapchain creation nor HDR signaling.
+    return flags;
+}
