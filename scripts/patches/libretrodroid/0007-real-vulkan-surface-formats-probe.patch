+// Invoked exclusively on the GL/emulation thread while the independent
+// target SurfaceView is valid. The caller keeps ownership of Surface.
+JNIEXPORT jint JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_probeVulkanSurfaceFormats(
+    JNIEnv* env, jclass obj, jobject surface
+) {
+    if (surface == nullptr) return 0;
+    ANativeWindow* window = ANativeWindow_fromSurface(env, surface);
+    if (window == nullptr) return 0;
+    const uint32_t flags = VulkanBackend::getInstance().probeRealDisplaySurfaceFormats(window);
+    ANativeWindow_release(window);
+    return static_cast<jint>(flags);
+}
