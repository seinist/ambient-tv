+        // Publish handles only after all allocations succeed. Failed Vulkan
+        // calls need not write usable output handles; never adopt those values.
+        template<class Dispatch>
+        bool create(const Dispatch& vk, VkDevice device, uint32_t queueFamily) {
+            if (inFlight || pool || command || fence || !device ||
+                !vk.createCommandPool || !vk.allocateCommandBuffers || !vk.createFence ||
+                !vk.destroyCommandPool || !vk.destroyFence) return false;
+
+            VkCommandPool newPool = VK_NULL_HANDLE;
+            VkCommandPoolCreateInfo poolInfo {};
+            poolInfo.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+            poolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+            poolInfo.queueFamilyIndex = queueFamily;
+            if (vk.createCommandPool(device, &poolInfo, nullptr, &newPool) != VK_SUCCESS) return false;
+
+            VkCommandBuffer newCommand = VK_NULL_HANDLE;
+            VkCommandBufferAllocateInfo allocInfo {};
+            allocInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+            allocInfo.commandPool = newPool;
+            allocInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+            allocInfo.commandBufferCount = 1;
+            if (vk.allocateCommandBuffers(device, &allocInfo, &newCommand) != VK_SUCCESS) {
+                vk.destroyCommandPool(device, newPool, nullptr);
+                return false;
+            }
+
+            VkFence newFence = VK_NULL_HANDLE;
+            VkFenceCreateInfo fenceInfo {};
+            fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+            if (vk.createFence(device, &fenceInfo, nullptr, &newFence) != VK_SUCCESS) {
+                vk.destroyCommandPool(device, newPool, nullptr);
+                return false;
+            }
+            pool = newPool;
+            command = newCommand;
+            fence = newFence;
+            return true;
+        }
+
+        // Caller must first prove GPU retirement; the slot independently
+        // refuses destruction while work is marked outstanding.
+        template<class Dispatch>
+        bool retire(const Dispatch& vk, VkDevice device) {
+            if (inFlight) return false;
+            if (!pool && !command && !fence) return true;
+            if (!device || (command && !pool) ||
+                (pool && !vk.destroyCommandPool) || (fence && !vk.destroyFence)) return false;
+            if (fence) vk.destroyFence(device, fence, nullptr);
+            if (pool) vk.destroyCommandPool(device, pool, nullptr);
+            pool = VK_NULL_HANDLE;
+            command = VK_NULL_HANDLE;
+            fence = VK_NULL_HANDLE;
+            return true;
         }
     };
