new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkancoloralternatepolicy.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstdint>
+
+namespace libretrodroid {
+// One recently used exact-size normalization allocation, never an in-flight slot.
+class VulkanColorAlternatePolicy {
+public:
+    static constexpr std::uint64_t totalBudget = 128ull * 1024ull * 1024ull;
+    static constexpr std::uint64_t idleBudget = 4ull * 1024ull * 1024ull;
+    static constexpr unsigned maxIdleFrames = 8;
+
+    static bool canRetain(std::uint64_t bytes) noexcept {
+        return bytes != 0 && bytes <= idleBudget;
+    }
+    static bool fits(std::uint64_t active, std::uint64_t alternate) noexcept {
+        return active <= totalBudget && alternate <= totalBudget - active &&
+               (alternate == 0 || canRetain(alternate));
+    }
+    bool keepUnusedFrame() noexcept {
+        if (idleFrames >= maxIdleFrames) return false;
+        ++idleFrames;
+        return true;
+    }
+    void reset() noexcept { idleFrames = 0; }
+
+private:
+    unsigned idleFrames = 0;
+};
+} // namespace libretrodroid
