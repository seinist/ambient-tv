+VkFormatFeatureFlags VulkanColorCopy::optimalFeatures(VkFormat encoded) {
+    if (!device || !gpu || !vk.formatProperties) return 0;
+    std::size_t index;
+    switch (encoded) {
+        case VK_FORMAT_R8G8B8A8_UNORM: index = 0; break;
+        case VK_FORMAT_B8G8R8A8_UNORM: index = 1; break;
+        case VK_FORMAT_A2B10G10R10_UNORM_PACK32: index = 2; break;
+        case VK_FORMAT_A2R10G10B10_UNORM_PACK32: index = 3; break;
+        case VK_FORMAT_R16G16B16A16_SFLOAT: index = 4; break;
+        default: return 0;
+    }
+    return formatFeatures.get(index, [&] {
+        VkFormatProperties properties {};
+        vk.formatProperties(gpu, encoded, &properties);
+        return properties.optimalTilingFeatures;
+    });
+}
