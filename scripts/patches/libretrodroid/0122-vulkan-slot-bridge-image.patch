+
+// The Vulkan-side AHB reference is independent of the EGL import's reference.
+// Retire only after the caller has proved GPU completion.
+template<class Buffer, class Image, class Memory>
+struct VulkanBridgeImage {
+    Buffer buffer{};
+    Image image{};
+    Memory memory{};
+    unsigned width = 0, height = 0;
+    bool fp16 = false;
+    uint64_t allocationBytes = 0;
+
+    VulkanBridgeImage() = default;
+    VulkanBridgeImage(const VulkanBridgeImage&) = delete;
+    VulkanBridgeImage& operator=(const VulkanBridgeImage&) = delete;
+
+    bool empty() const noexcept {
+        return !buffer && !image && !memory && !width && !height && !fp16 && !allocationBytes;
+    }
+
+    bool canRetire(bool inFlight, bool hasDevice, bool canDestroyImage, bool canFreeMemory) const noexcept {
+        return !inFlight && (!image || (hasDevice && canDestroyImage)) &&
+            (!memory || (hasDevice && canFreeMemory));
+    }
+
+    template<class DestroyImage, class FreeMemory, class ReleaseBuffer>
+    bool retire(bool inFlight, bool hasDevice, bool canDestroyImage, bool canFreeMemory,
+                DestroyImage destroyImage, FreeMemory freeMemory, ReleaseBuffer releaseBuffer) {
+        if (!canRetire(inFlight, hasDevice, canDestroyImage, canFreeMemory)) return false;
+        if (image) destroyImage(image);
+        if (memory) freeMemory(memory);
+        if (buffer) releaseBuffer(buffer);
+        image = {};
+        memory = {};
+        buffer = {};
+        width = height = 0;
+        fp16 = false;
+        allocationBytes = 0;
+        return true;
+    }
+};
+
+} // namespace libretrodroid
