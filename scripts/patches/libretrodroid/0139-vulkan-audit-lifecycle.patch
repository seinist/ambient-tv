+// The KHR promotion retains the EXT structure ABI, but its extension-name
+// dependencies are distinct. Literal extension names also support NDK headers
+// predating the promotion. Only advertise a matching instance/device pair.
+struct NativePresentMaintenance {
+    static constexpr unsigned ext = 1u, khr = 2u;
+    static constexpr const char* extSurface = "VK_EXT_surface_maintenance1";
+    static constexpr const char* khrSurface = "VK_KHR_surface_maintenance1";
+    static constexpr const char* extSwapchain = "VK_EXT_swapchain_maintenance1";
+    static constexpr const char* khrSwapchain = "VK_KHR_swapchain_maintenance1";
+    static constexpr unsigned surfaceMask(bool extAvailable, bool khrAvailable) noexcept {
+        return (extAvailable ? ext : 0u) | (khrAvailable ? khr : 0u);
+    }
+    static constexpr const char* deviceExtension(unsigned enabledSurface,
+            bool extAvailable, bool khrAvailable) noexcept {
+        if ((enabledSurface & khr) && khrAvailable) return khrSwapchain;
+        if ((enabledSurface & ext) && extAvailable) return extSwapchain;
+        return nullptr;
+    }
+};
