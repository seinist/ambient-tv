+bool VulkanBackend::prepareCoreStateAccess(bool changingState) {
+    if (hasFatalError() || shutdownReady) return false;
+    if (!isStarted()) return true;
+    // A state operation must not consume a staged semaphore or command buffer:
+    // those belong to the next video callback, not a save/load/reset call.
+    if (changingState && (!pendingCommandBuffers.empty() ||
+            pendingSignalSemaphore != VK_NULL_HANDLE || !pendingImage.waitSemaphores.empty()))
+        return false;
+    if (!waitForSlotFrame(frameSlot) || !waitForSlotFrame(spareFrameSlot) ||
+            !waitForNativeSlangFrame()) return false;
+    if (changingState) {
+        nativePresentation.invalidateFrame();
+        // Never reuse a pre-reset or pre-restore VkImage. The next VALID
+        // video callback needs a fresh set_image from the core.
+        pendingImage = PendingImage {};
+        coreSourceFormat.store(0u, std::memory_order_release);
+    }
+    return true;
+}
