new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanbridgesync.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+namespace libretrodroid {
+
+// Slot-local binary semaphore ownership. Capability flags stay device-wide.
+// Callers must prove GPU retirement before invoking retire().
+template<class Semaphore>
+struct VulkanBridgeSync {
+    Semaphore readSemaphore{};
+    Semaphore writeSemaphore{};
+    bool readPending = false;
+
+    VulkanBridgeSync() = default;
+    VulkanBridgeSync(const VulkanBridgeSync&) = delete;
+    VulkanBridgeSync& operator=(const VulkanBridgeSync&) = delete;
+
+    bool empty() const noexcept {
+        return !readSemaphore && !writeSemaphore && !readPending;
+    }
+
+    bool canRetire(bool inFlight, bool hasDevice, bool canDestroy) const noexcept {
+        if (inFlight) return false;
+        if (empty()) return true;
+        return hasDevice && canDestroy && (!readPending || readSemaphore) &&
+               (!readSemaphore || readSemaphore != writeSemaphore);
+    }
+
+    template<class Destroy>
+    bool retire(bool inFlight, bool hasDevice, bool canDestroy, Destroy destroy) {
+        if (!canRetire(inFlight, hasDevice, canDestroy)) return false;
+        if (readSemaphore) destroy(readSemaphore);
+        if (writeSemaphore) destroy(writeSemaphore);
+        readSemaphore = {};
+        writeSemaphore = {};
+        readPending = false;
+        return true;
+    }
+};
+
+} // namespace libretrodroid
