+void CoreSensors::reset() {
+    requested = 0;
+    requestChanged = true;
+    for (unsigned port = 0; port < 4; ++port) {
+        companionAccess[port] = 0;
+        companionRequested[port] = 0;
+    }
+    std::lock_guard<std::mutex> lock(readingsMutex);
+    readings = {};
+    companionReadings = {};
+}
+
+bool CoreSensors::setSensorState(unsigned port, retro_sensor_action action) {
+    const int sensor = sensorForAction(action);
+    if (port >= 4 || sensor == 0) return false;
+    const int permitted = (port == 0 ? access.load() : 0) | companionAccess[port].load();
+    if (isEnableAction(action)) {
+        if ((permitted & sensor) == 0) return false;
+        if (port == 0) requested |= sensor;
+        else companionRequested[port] |= sensor;
+    } else {
+        if (port == 0) requested &= ~sensor;
+        else companionRequested[port] &= ~sensor;
+    }
+    if (port == 0) requestChanged = true;
+    return true;
+}
+
+float CoreSensors::getSensorInput(unsigned port, unsigned id) {
+    if (port >= 4 || id > RETRO_SENSOR_ILLUMINANCE) return 0.0f;
+    const int sensor = id <= RETRO_SENSOR_ACCELEROMETER_Z ? ACCELEROMETER
+        : id <= RETRO_SENSOR_GYROSCOPE_Z ? GYROSCOPE : ILLUMINANCE;
+    const bool remote = (companionAccess[port].load() & sensor) != 0;
+    const bool local = port == 0 && (access.load() & sensor) != 0;
+    const int wanted = port == 0 ? requested.load() : companionRequested[port].load();
+    if ((wanted & sensor) == 0 || (!remote && !local)) return 0.0f;
+    std::lock_guard<std::mutex> lock(readingsMutex);
+    const float reading = remote ? companionReadings[port][id] : readings[id];
+    return sensor == ACCELEROMETER ? reading * accelerometerScale : reading;
+}
 
 }
 
