@@ -0,0 +1,28 @@
+package com.swordfish.libretrodroid
+
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.channels.BufferOverflow
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.merge
+import kotlinx.coroutines.flow.buffer
+
+/** GL-thread producer; independent sticky readiness and sampled status streams. */
+class GameRenderEvents<T>(private val surface: T, private val frame: T) {
+    private val surfaceEvents = MutableSharedFlow<T>(replay = 1, onBufferOverflow = BufferOverflow.DROP_OLDEST)
+    private val frameEvents = MutableSharedFlow<T>(replay = 1, onBufferOverflow = BufferOverflow.DROP_OLDEST)
+    @OptIn(ExperimentalCoroutinesApi::class)
+    val events = merge(surfaceEvents, frameEvents).buffer(0)
+    private var lastFrameNs: Long? = null
+
+    fun surfaceCreated() {
+        lastFrameNs = null
+        surfaceEvents.tryEmit(surface)
+    }
+
+    fun frameRendered(nowNs: Long) {
+        val previous = lastFrameNs
+        if (previous != null && nowNs - previous < 100_000_000L) return
+        lastFrameNs = nowNs
+        frameEvents.tryEmit(frame)
+    }
+}
