index 0000000..3f8682e
--- /dev/null
+++ b/src/main/cpp/sdrtohdr.h
@@ -0,0 +1,48 @@
+/*
+ *     Ambient TV: SDR picture as HDR10 on a BT2020 PQ window surface.
+ *
+ *     This program is free software: you can redistribute it and/or modify
+ *     it under the terms of the GNU General Public License as published by
+ *     the Free Software Foundation, either version 3 of the License, or
+ *     (at your option) any later version.
+ */
+
+#ifndef LIBRETRODROID_SDRTOHDR_H
+#define LIBRETRODROID_SDRTOHDR_H
+
+#include <string>
+
+namespace libretrodroid {
+
+/**
+ * Wraps the last picture pass so it writes PQ (SMPTE ST 2084) BT.2020 instead of sRGB:
+ * sRGB -> linear BT.709 -> BT.2020, SDR white at [whiteNits]. The pass itself is unchanged;
+ * its main() is renamed and called first. Only for GLSL ES 1.00 passes that write gl_FragColor.
+ */
+inline std::string wrapFragmentForPq(const std::string& fragment, int whiteNits) {
+    std::string head;
+    std::string body = fragment;
+    const auto first = fragment.find_first_not_of(" \t\r\n");
+    if (first != std::string::npos && fragment.compare(first, 8, "#version") == 0) {
+        const auto end = fragment.find('\n', first);
+        head = fragment.substr(0, end == std::string::npos ? fragment.size() : end + 1);
+        body = end == std::string::npos ? std::string() : fragment.substr(end + 1);
+    }
+    return head + "#define main ambient_picture_main\n" + body + "\n#undef main\n"
+        "#ifdef GL_FRAGMENT_PRECISION_HIGH\n#define AMBIENT_PQ_P highp\n#else\n#define AMBIENT_PQ_P mediump\n#endif\n"
+        "AMBIENT_PQ_P vec3 ambientSdrToPq(AMBIENT_PQ_P vec3 c) {\n"
+        "    AMBIENT_PQ_P vec3 x = clamp(c, 0.0, 1.0);\n"
+        "    AMBIENT_PQ_P vec3 lin = mix(x / 12.92, pow((x + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), x));\n"
+        "    lin = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956) * lin;\n"
+        "    AMBIENT_PQ_P vec3 p = pow(max(lin * (" + std::to_string(whiteNits) + ".0 / 10000.0), 0.0), vec3(0.1593017578125));\n"
+        "    return pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), vec3(78.84375));\n"
+        "}\n"
+        "void main() {\n"
+        "    ambient_picture_main();\n"
+        "    gl_FragColor = vec4(ambientSdrToPq(gl_FragColor.rgb), gl_FragColor.a);\n"
+        "}\n";
+}
+
+}
+
+#endif
