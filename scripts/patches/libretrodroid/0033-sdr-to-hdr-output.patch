diff --git a/src/main/java/com/swordfish/libretrodroid/SdrToHdrSurface.kt b/src/main/java/com/swordfish/libretrodroid/SdrToHdrSurface.kt
new file mode 100644
index 0000000..fa470eb
--- /dev/null
+++ b/src/main/java/com/swordfish/libretrodroid/SdrToHdrSurface.kt
@@ -0,0 +1,90 @@
+/*
+ *     Ambient TV: EGL setup for showing an SDR game as HDR10.
+ *
+ *     This program is free software: you can redistribute it and/or modify
+ *     it under the terms of the GNU General Public License as published by
+ *     the Free Software Foundation, either version 3 of the License, or
+ *     (at your option) any later version.
+ */
+
+package com.swordfish.libretrodroid
+
+import android.opengl.GLSurfaceView
+import android.util.Log
+import javax.microedition.khronos.egl.EGL10
+import javax.microedition.khronos.egl.EGLConfig
+import javax.microedition.khronos.egl.EGLDisplay
+import javax.microedition.khronos.egl.EGLSurface
+
+/**
+ * A 10-bit window config and a window surface tagged EGL_GL_COLORSPACE_BT2020_PQ_EXT, as Kodi
+ * and Ambient TV's mpv do for HDR10 on GLES. [active] is true only when both worked; otherwise
+ * the surface is a plain SDR one and the picture stays SDR.
+ */
+internal class SdrToHdrSurface(private val glesVersion: Int) :
+    GLSurfaceView.EGLConfigChooser, GLSurfaceView.EGLWindowSurfaceFactory {
+
+    @Volatile var active: Boolean = false
+        private set
+    @Volatile private var tenBit: Boolean = false
+
+    override fun chooseConfig(egl: EGL10, display: EGLDisplay): EGLConfig {
+        val renderable = if (glesVersion >= 3) EGL_OPENGL_ES3_BIT_KHR else EGL_OPENGL_ES2_BIT
+        choose(egl, display, renderable, 10, 2)?.let { tenBit = true; return it }
+        tenBit = false
+        Log.w(TAG, "No 10-bit EGL config: SDR output")
+        return choose(egl, display, renderable, 8, 0)
+            ?: throw IllegalArgumentException("No EGL config for OpenGL ES $glesVersion")
+    }
+
+    private fun choose(egl: EGL10, display: EGLDisplay, renderable: Int, bits: Int, alpha: Int): EGLConfig? {
+        val attributes = intArrayOf(
+            EGL10.EGL_RED_SIZE, bits, EGL10.EGL_GREEN_SIZE, bits, EGL10.EGL_BLUE_SIZE, bits,
+            EGL10.EGL_ALPHA_SIZE, alpha, EGL10.EGL_DEPTH_SIZE, 16,
+            EGL10.EGL_RENDERABLE_TYPE, renderable, EGL10.EGL_NONE,
+        )
+        val count = IntArray(1)
+        if (!egl.eglChooseConfig(display, attributes, null, 0, count) || count[0] <= 0) return null
+        val configs = arrayOfNulls<EGLConfig>(count[0])
+        if (!egl.eglChooseConfig(display, attributes, configs, configs.size, count)) return null
+        val value = IntArray(1)
+        fun size(config: EGLConfig, attribute: Int): Int =
+            if (egl.eglGetConfigAttrib(display, config, attribute, value)) value[0] else -1
+        // eglChooseConfig sorts deeper colour first; take the exact size asked for.
+        return configs.filterNotNull().firstOrNull { config ->
+            size(config, EGL10.EGL_RED_SIZE) == bits && size(config, EGL10.EGL_GREEN_SIZE) == bits &&
+                size(config, EGL10.EGL_BLUE_SIZE) == bits
+        }
+    }
+
+    override fun createWindowSurface(egl: EGL10, display: EGLDisplay, config: EGLConfig, nativeWindow: Any?): EGLSurface? {
+        val extensions = egl.eglQueryString(display, EGL10.EGL_EXTENSIONS).orEmpty().split(' ')
+        if (tenBit && "EGL_KHR_gl_colorspace" in extensions && "EGL_EXT_gl_colorspace_bt2020_pq" in extensions) {
+            val surface = runCatching {
+                egl.eglCreateWindowSurface(display, config, nativeWindow,
+                    intArrayOf(EGL_GL_COLORSPACE_KHR, EGL_GL_COLORSPACE_BT2020_PQ_EXT, EGL10.EGL_NONE))
+            }.getOrNull()
+            if (surface != null && surface != EGL10.EGL_NO_SURFACE) {
+                active = true
+                return surface
+            }
+            Log.w(TAG, "BT2020 PQ window surface refused: SDR output")
+        } else if (tenBit) {
+            Log.w(TAG, "EGL lacks EGL_EXT_gl_colorspace_bt2020_pq: SDR output")
+        }
+        active = false
+        return runCatching { egl.eglCreateWindowSurface(display, config, nativeWindow, null) }.getOrNull()
+    }
+
+    override fun destroySurface(egl: EGL10, display: EGLDisplay, surface: EGLSurface) {
+        egl.eglDestroySurface(display, surface)
+    }
+
+    private companion object {
+        const val TAG = "SdrToHdrSurface"
+        const val EGL_OPENGL_ES2_BIT = 0x0004
+        const val EGL_OPENGL_ES3_BIT_KHR = 0x0040
+        const val EGL_GL_COLORSPACE_KHR = 0x309D
+        const val EGL_GL_COLORSPACE_BT2020_PQ_EXT = 0x3340
+    }
+}
