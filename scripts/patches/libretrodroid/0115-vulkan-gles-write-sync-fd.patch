+bool Video::canImportExternalWriteFence() {
+#if defined(__ANDROID__)
+    const EGLDisplay display = eglGetCurrentDisplay();
+    const EGLContext context = eglGetCurrentContext();
+    if (!hwRenderTexture || !externalFrame.ownsContext(display, context)) return false;
+    if (!writeFenceProbed) {
+        writeFenceProbed = true;
+        const auto contains = [](const char* extensions, const char* name) {
+            if (!extensions) return false;
+            const size_t length = std::strlen(name);
+            for (const char* p = extensions; (p = std::strstr(p, name)); p += length) {
+                if ((p == extensions || p[-1] == ' ') && (p[length] == ' ' || p[length] == '\0'))
+                    return true;
+            }
+            return false;
+        };
+        const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
+        if (contains(extensions, "EGL_KHR_fence_sync") &&
+            contains(extensions, "EGL_ANDROID_native_fence_sync") &&
+            contains(extensions, "EGL_KHR_wait_sync") &&
+            contains(reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS)), "GL_OES_EGL_sync")) {
+            createWriteSync = reinterpret_cast<PFNEGLCREATESYNCKHRPROC>(eglGetProcAddress("eglCreateSyncKHR"));
+            destroyWriteSync = reinterpret_cast<PFNEGLDESTROYSYNCKHRPROC>(eglGetProcAddress("eglDestroySyncKHR"));
+            waitWriteSync = reinterpret_cast<PFNEGLWAITSYNCKHRPROC>(eglGetProcAddress("eglWaitSyncKHR"));
+        }
+    }
+    return createWriteSync && destroyWriteSync && waitWriteSync;
+#else
+    return false;
+#endif
+}
+
+bool Video::importExternalWriteFence(int fd) {
+    if (fd < 0) return fd == -1; // Vulkan's already-signaled SYNC_FD sentinel.
+#if defined(__ANDROID__)
+    if (canImportExternalWriteFence()) {
+        const EGLDisplay display = eglGetCurrentDisplay();
+        const EGLint attrs[] = { EGL_SYNC_NATIVE_FENCE_FD_ANDROID, fd, EGL_NONE };
+        // EGL takes ownership on the call; never close or reuse fd afterwards.
+        const EGLSyncKHR sync = createWriteSync(display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+        if (sync != EGL_NO_SYNC_KHR) {
+            const bool queued = waitWriteSync(display, sync, 0) == EGL_TRUE;
+            const bool destroyed = destroyWriteSync(display, sync) == EGL_TRUE;
+            if (queued && destroyed) return true;
+        }
+        // The caller has already waited on its Vulkan CPU fence. Disable the
+        // optional server wait on failure, retaining the proven fallback.
+        waitWriteSync = nullptr;
+        return false;
+    }
+#endif
+    close(fd); // No ownership transfer took place.
+    return false;
+}
