+bool VulkanBackend::canExportBridgeWriteFence() const {
+    return bridgeWriteFenceEnabled && isStarted() && !hasFatalError() && !shutdownReady &&
+           vk.createSemaphore && vk.destroySemaphore && vk.getSemaphoreFd;
+}
+
+bool VulkanBackend::prepareBridgeWriteFence() {
+    if (!canExportBridgeWriteFence() || frameInFlight) return false;
+    if (bridgeWriteSemaphore != VK_NULL_HANDLE) return true;
+    VkExportSemaphoreCreateInfo external { VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO };
+    external.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    VkSemaphoreCreateInfo info { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    info.pNext = &external;
+    const VkResult result = vk.createSemaphore(device, &info, nullptr, &bridgeWriteSemaphore);
+    if (result == VK_SUCCESS) return true;
+    bridgeWriteSemaphore = VK_NULL_HANDLE;
+    bridgeWriteFenceEnabled = false;
+    if (result == VK_ERROR_DEVICE_LOST) checkFrameResult(result, "create bridge write semaphore");
+    else LOGW("Cannot create bridge write semaphore; retaining CPU fence");
+    return false;
+}
+
+int VulkanBackend::exportBridgeWriteFence() {
+    // Export only after a successful submit signalling this binary semaphore.
+    // SYNC_FD copy transference consumes the signal payload. The CPU frame fence
+    // still proves submission completion before any reuse or retirement.
+    VkSemaphoreGetFdInfoKHR info { VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR };
+    info.semaphore = bridgeWriteSemaphore;
+    info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    int fd = -1;
+    const VkResult result = vk.getSemaphoreFd(device, &info, &fd);
+    if (result == VK_SUCCESS) return fd;
+    bridgeWriteFenceEnabled = false; // do not re-signal a potentially unconsumed payload
+    if (result == VK_ERROR_DEVICE_LOST) checkFrameResult(result, "export bridge write fence");
+    else LOGW("Cannot export bridge write fence; retaining CPU fence");
+    return -1;
+}
