diff --git a/src/main/cpp/audiocallbackcontrols.h b/src/main/cpp/audiocallbackcontrols.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/audiocallbackcontrols.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace libretrodroid {
+
+// The emulation thread publishes independent scalar controls. The audio callback
+// reads each exactly once per block; no lock, allocation or retry is needed.
+struct AudioCallbackControls {
+    static_assert(std::atomic<double>::is_always_lock_free, "Audio speed must be lock-free");
+    static_assert(std::atomic<float>::is_always_lock_free, "Audio volume must be lock-free");
+    static_assert(std::atomic<bool>::is_always_lock_free, "Audio pitch flag must be lock-free");
+
+    struct Snapshot {
+        double speed;
+        float volume;
+        bool preservePitch;
+    };
+
+    void setSpeed(double value) noexcept { speed.store(value, std::memory_order_relaxed); }
+    void setVolume(float value) noexcept { volume.store(value, std::memory_order_relaxed); }
+    void setPreservePitch(bool value) noexcept { preservePitch.store(value, std::memory_order_relaxed); }
+
+    Snapshot snapshot() const noexcept {
+        return {speed.load(std::memory_order_relaxed), volume.load(std::memory_order_relaxed),
+                preservePitch.load(std::memory_order_relaxed)};
+    }
+
+private:
+    std::atomic<double> speed{1.0};
+    std::atomic<float> volume{1.0f};
+    std::atomic<bool> preservePitch{false};
+};
+
+// Apply a single callback's volume after resampling. Muting still consumes the
+// same audio and preserves the timing controller and time-stretcher state.
+inline void applyAudioCallbackVolume(int16_t* output, int32_t frames, float volume) {
+    if (frames <= 0 || volume == 1.0f) return;
+    const auto samples = static_cast<std::size_t>(frames) * 2;
+    if (volume == 0.0f) {
+        std::fill_n(output, samples, int16_t{0});
+        return;
+    }
+    for (std::size_t i = 0; i < samples; ++i) {
+        float s = output[i] * volume;
+        if (s > 32767.0f) s = 32767.0f;
+        else if (s < -32768.0f) s = -32768.0f;
+        output[i] = static_cast<int16_t>(std::lrintf(s));
+    }
+}
+
+} // namespace libretrodroid
