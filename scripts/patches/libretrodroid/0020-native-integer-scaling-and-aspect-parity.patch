diff --git a/src/main/cpp/vulkan/vulkanbackend.cpp b/src/main/cpp/vulkan/vulkanbackend.cpp
--- a/src/main/cpp/vulkan/vulkanbackend.cpp
+++ b/src/main/cpp/vulkan/vulkanbackend.cpp
@@ -1227,5 +1227,18 @@
-        const int32_t dstW = std::clamp(static_cast<int32_t>(std::lround(displayWidth)),
+        int32_t dstW = std::clamp(static_cast<int32_t>(std::lround(displayWidth)),
                                         1, static_cast<int32_t>(nativeSdrExtent.width));
-        const int32_t dstH = std::clamp(static_cast<int32_t>(std::lround(displayHeight)),
+        int32_t dstH = std::clamp(static_cast<int32_t>(std::lround(displayHeight)),
                                         1, static_cast<int32_t>(nativeSdrExtent.height));
+        if (nativeIntegerScaling && copyWidth > 0 && copyHeight > 0) {
+            // Match VideoLayout: largest whole-number source-pixel scale.
+            // If the screen is smaller than a source frame, retain normal fit.
+            const uint32_t sx = nativeSdrExtent.width / copyWidth;
+            const uint32_t sy = nativeSdrExtent.height / copyHeight;
+            const uint32_t whole = std::min(sx, sy);
+            if (whole >= 1u) {
+                dstW = static_cast<int32_t>(std::min<uint64_t>(
+                    nativeSdrExtent.width, uint64_t(copyWidth) * whole));
+                dstH = static_cast<int32_t>(std::min<uint64_t>(
+                    nativeSdrExtent.height, uint64_t(copyHeight) * whole));
+            }
+        }
         const int32_t left = (static_cast<int32_t>(nativeSdrExtent.width) - dstW) / 2;
@@ -1387,2 +1387,3 @@
     nativeCoreSourceTransfer = 0u;
+    nativeIntegerScaling = false;
     nativeSdrStatus.store(0u, std::memory_order_release);
