diff --git a/src/main/cpp/vulkan/vulkancolorallocationbudget.h b/src/main/cpp/vulkan/vulkancolorallocationbudget.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkancolorallocationbudget.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+
+namespace libretrodroid {
+
+// One render-thread-owned budget shared by every normalization slot. Charge
+// actual VkMemoryRequirements::size before allocation, and release after free.
+class VulkanColorAllocationBudget {
+public:
+    static constexpr std::uint64_t maximum = 128ull * 1024ull * 1024ull;
+    explicit VulkanColorAllocationBudget(std::uint64_t bytes = maximum) noexcept
+        : capacity(bytes <= maximum ? bytes : maximum) {}
+    VulkanColorAllocationBudget(const VulkanColorAllocationBudget&) = delete;
+    VulkanColorAllocationBudget& operator=(const VulkanColorAllocationBudget&) = delete;
+
+    std::uint64_t used() const noexcept { return reserved; }
+    std::uint64_t available() const noexcept { return capacity - reserved; }
+
+    bool reserve(std::uint64_t bytes) noexcept {
+        if (!bytes || bytes > available()) return false;
+        reserved += bytes;
+        return true;
+    }
+
+    bool release(std::uint64_t bytes) noexcept {
+        // Invalid release cannot grant additional capacity.
+        if (bytes > reserved) return false;
+        reserved -= bytes;
+        return true;
+    }
+
+private:
+    const std::uint64_t capacity;
+    std::uint64_t reserved = 0;
+};
+
+} // namespace libretrodroid
