+    if (!allocateBridgeImage(spare.bridgeImage, primary.width, primary.height, primary.fp16, budget)) {
+        // No submit has occurred. Roll back only the new slot, unless a fatal
+        // error requires the global device-idle/loss retirement path.
+        if (!hasFatalError() && !releaseSpareFrameBuffer())
