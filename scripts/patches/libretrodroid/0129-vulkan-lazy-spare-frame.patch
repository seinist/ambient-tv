+    // Optional setup must not stall an outstanding frame, change precision,
+    // or replace an allocation still imported by EGL.
+    if (hasFatalError() || shutdownReady || !isStarted() || frameSlot.inFlight || spare.inFlight ||
+            !primary.buffer || !primary.image || !primary.memory || !primary.width || !primary.height ||
+            !canRetireFrameSlots()) return false;
