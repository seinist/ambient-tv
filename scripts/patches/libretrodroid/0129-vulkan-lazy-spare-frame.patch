+bool VulkanBackend::releaseSpareFrameBuffer() {
+    auto& spare = spareFrameSlot;
+    if (!spareFramePrepared && !spare.inFlight && !spare.pool && !spare.command && !spare.fence &&
+            spare.bridgeImage.empty() && spare.bridgeSync.empty()) return true;
+    if (hasFatalError() || shutdownReady || frameSlot.inFlight || !waitForSlotFrame(spare)) return false;
+    if (!canRetireFrameSlots() || !retireFrameSlot(spare))
+        return checkFrameResult(VK_ERROR_INITIALIZATION_FAILED, "retire spare frame slot");
+    spareFramePrepared = false;
