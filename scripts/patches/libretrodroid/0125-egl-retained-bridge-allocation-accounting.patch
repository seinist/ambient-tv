     // Bound the old-error drain even if the context/driver is broken. Do not
     // discard errors from creating/binding the new texture itself.
     GLenum error = GL_NO_ERROR;
     for (unsigned i = 0; i < 16; ++i) {
         error = glGetError();
         if (error == GL_NO_ERROR) break;
     }
     if (error != GL_NO_ERROR) {
         releaseSlot();
         return false;
     }
 
     glGenTextures(1, &slot.texture);
     glBindTexture(GL_TEXTURE_2D, slot.texture);
     targetTexture(GL_TEXTURE_2D, static_cast<GLeglImageOES>(image));
     // A driver can accept FP16 in Vulkan but fail to import/sample it in GLES.
     const GLenum importError = glGetError();
     if (slot.texture == 0 || importError != GL_NO_ERROR) {
         LOGW("EGLImage to GLES texture import failed: 0x%x", importError);
         glBindTexture(GL_TEXTURE_2D, 0);
         releaseSlot();
