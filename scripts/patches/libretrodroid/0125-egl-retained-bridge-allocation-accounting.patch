+bool Video::prepareExternalFrameSlot(std::size_t index, AHardwareBuffer* buffer, unsigned width, unsigned height,
+                                     std::uint64_t allocationBytes) {
+    if (!externalFrames || !width || !height || !externalFrame.canImport(index, buffer)) return false;
+    auto& slot = *externalFrame.get(index);
+    const EGLDisplay display = eglGetCurrentDisplay();
+    const EGLContext context = eglGetCurrentContext();
+    if (display == EGL_NO_DISPLAY || context == EGL_NO_CONTEXT) return false;
+
+    // A buffer and its texture may be reused only within the same EGL context.
+    // The AHB reference prevents recycling its identity while this import lives.
+    if (slot.lease.matches(buffer, display, context, slot.texture))
+        return slot.width == width && slot.height == height && slot.allocationBytes == allocationBytes;
