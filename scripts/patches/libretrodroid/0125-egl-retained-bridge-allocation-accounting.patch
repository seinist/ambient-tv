+namespace libretrodroid {
+
+// Texture ownership belongs to the EGL slot; the renderer only borrows the
+// selected name. Preparing another slot must not publish it to the renderer.
+template<class Ops, std::size_t Count = 2>
+class ExternalFrameSlots {
+public:
+    using Buffer = typename Ops::Buffer;
+    using Display = typename Ops::Display;
+    using Context = typename Ops::Context;
+    using Texture = typename Ops::Texture;
+    struct Slot {
+        ExternalFrameLease<Ops> lease;
+        Texture texture{};
+        unsigned width = 0, height = 0;
+        std::uint64_t allocationBytes = 0;
+    };
+
+    static_assert(Count > 0, "At least one EGL slot is required");
+    Slot* get(std::size_t index) noexcept { return index < Count ? &slots[index] : nullptr; }
+    const Slot* get(std::size_t index) const noexcept { return index < Count ? &slots[index] : nullptr; }
+    std::size_t selected() const noexcept { return current; }
+
+    // Count the EGL-held allocations not already accounted for by Vulkan.
+    // Context invalidation is not release. Unknown sizes or overflow must
+    // conservatively deny a future bounded allocation, never wrap to zero.
+    std::uint64_t retainedAllocationBytesExcept(Buffer first = {}, Buffer second = {}) const noexcept {
+        constexpr auto unknown = std::numeric_limits<std::uint64_t>::max();
+        std::uint64_t total = 0;
+        for (const auto& slot : slots) {
+            if (!slot.lease.retainsBuffer() || slot.lease.references(first) || slot.lease.references(second))
+                continue;
+            if (!slot.allocationBytes || slot.allocationBytes > unknown - total) return unknown;
+            total += slot.allocationBytes;
+        }
+        return total;
+    }
+
+    bool canImport(std::size_t index, Buffer buffer) const noexcept {
+        if (index >= Count || !buffer) return false;
+        // The same AHB cannot have two independent read/write ownership records.
+        for (std::size_t i = 0; i < Count; ++i)
+            if (i != index && slots[i].lease.references(buffer)) return false;
+        return true;
+    }
+
+    bool select(std::size_t index, Display display, Context context, Texture& borrowed) noexcept {
+        const auto* slot = get(index);
+        if (!slot || !slot->texture || !slot->width || !slot->height ||
+                !slot->lease.ownsContext(display, context)) return false;
+        current = index;
+        borrowed = slot->texture;
+        return true;
+    }
+
+    bool ownsContext(Display display, Context context) const noexcept {
+        const auto& slot = slots[current];
+        return slot.texture && slot.lease.ownsContext(display, context);
+    }
+
+    bool markUse(Texture borrowed, Display display, Context context) noexcept {
+        auto& slot = slots[current];
+        return borrowed == slot.texture && slot.lease.markUse(slot.texture, display, context);
+    }
+
+    bool finishSlotUse(std::size_t index, Display display, Context context, Ops& ops,
+                       bool allowEmpty = false) {
+        auto* slot = get(index);
+        return slot && slot->lease.finishUse(slot->texture, display, context, ops, allowEmpty);
+    }
+
+    bool finishUse(Texture borrowed, Display display, Context context, Ops& ops,
+                   bool allowEmpty = false) {
+        return borrowed == slots[current].texture && finishSlotUse(current, display, context, ops, allowEmpty);
+    }
+
+    void invalidateContext() noexcept {
+        for (auto& slot : slots) slot.lease.invalidateContext();
+    }
+
+    void releaseSlot(std::size_t index, Texture& borrowed, Display display, Context context, Ops& ops) {
+        auto* slot = get(index);
+        if (!slot) return;
+        if (index == current) borrowed = {};
+        slot->lease.release(slot->texture, display, context, ops);
+        slot->width = slot->height = 0;
+        slot->allocationBytes = 0;
     }
 
     void release(Texture& borrowed, Display display, Context context, Ops& ops) {
         for (std::size_t i = 0; i < Count; ++i) releaseSlot(i, borrowed, display, context, ops);
         current = 0;
     }
 
 private:
     std::array<Slot, Count> slots{};
     std::size_t current = 0;
 };
 
 } // namespace libretrodroid
