     }
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
     glBindTexture(GL_TEXTURE_2D, 0);
     const GLenum samplerError = glGetError();
     if (samplerError != GL_NO_ERROR) {
         LOGW("Imported Vulkan texture setup failed: 0x%x", samplerError);
         releaseSlot();
         return false;
     }
 
     slot.width = width;
     slot.height = height;
     LOGI("Vulkan frame buffer imported into GLES: tex=%u %ux%u", slot.texture, width, height);
     return true;
 }
 
 bool Video::selectExternalFrameSlot(std::size_t index) {
     if (!externalFrames) return false;
     const auto previous = externalFrame.selected();
     const auto previousTexture = hwRenderTexture;
     if (!externalFrame.select(index, eglGetCurrentDisplay(), eglGetCurrentContext(), hwRenderTexture)) return false;
     const auto& slot = *externalFrame.get(index);
     if (previous == index && previousTexture == hwRenderTexture &&
             hwFBOWidth == slot.width && hwFBOHeight == slot.height) return true;
     hwFBOWidth = slot.width;
     hwFBOHeight = slot.height;
     if (renderer != nullptr) {
         renderer->updateRenderedResolution(slot.width, slot.height);
     }
     return true;
 }
 
 void Video::resizeHWRenderTarget(unsigned int width, unsigned int height) {
     if (!hwAccelerated || hwCtx == EGL_NO_CONTEXT) return;
     if (width == 0 || height == 0) return;
