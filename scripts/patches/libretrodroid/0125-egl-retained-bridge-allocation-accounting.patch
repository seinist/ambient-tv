+    if (image == EGL_NO_IMAGE_KHR) {
+        LOGE("eglCreateImageKHR failed for the Vulkan frame buffer: 0x%x", eglGetError());
+        AHardwareBuffer_release(buffer);
+        return false;
+    }
+    slot.lease.adopt(buffer, display, context, image, destroyImage);
