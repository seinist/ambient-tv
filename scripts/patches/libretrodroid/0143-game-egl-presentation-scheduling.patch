@@ -24,6 +24,15 @@
     static bool validRate(double fps) noexcept {
         return std::isfinite(fps) && fps >= 1.0 && fps <= 1000000000.0;
     }
 
+    // Ordinary VSync runs at the physical display cadence (also used by
+    // the audio stretch calculation). Keeping a slightly different software
+    // deadline would cause periodic drift/missed refreshes, e.g. 59.73 vs 60.
+    // External BFI timing retains its existing core-rate backstop.
+    static double cadenceRate(double content, double display, bool vsync,
+                              bool externalTiming) noexcept {
+        return vsync && !externalTiming && validRate(display) ? display : content;
+    }
+
     void setRate(double fps) noexcept {
         if (!validRate(fps)) return;
