diff --git a/src/main/java/com/swordfish/libretrodroid/IdlePresentationPolicy.kt b/src/main/java/com/swordfish/libretrodroid/IdlePresentationPolicy.kt
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/swordfish/libretrodroid/IdlePresentationPolicy.kt
@@ -0,0 +1,12 @@
+package com.swordfish.libretrodroid
+
+/** Pure shared GLES/Vulkan presentation policy. No dependence on Android or driver state. */
+internal object IdlePresentationPolicy {
+    fun continuous(foreground: Boolean, emulating: Boolean, enabled: Boolean): Boolean =
+        foreground && (emulating || !enabled)
+
+    // A paused visible view must repaint after a queued picture mutation.
+    // Background tasks still drain but do not request unnecessary EGL swaps.
+    fun wakeForWork(foreground: Boolean, emulating: Boolean, enabled: Boolean): Boolean =
+        foreground && enabled && !emulating
+}
