 void VulkanBackend::shutdown() {
+    // Retire the real display WSI resources before destroying the core's VkDevice
+    // or its VkInstance, including when a SurfaceView disappears mid-session.
+    destroyNativeSdrSwapchain();
+    if (nativeSdrWindow != nullptr) ANativeWindow_release(nativeSdrWindow);
+    nativeSdrWindow = nullptr;
+    nativeSdrDisabled = false;
+    nativeSdrStatus.store(0u, std::memory_order_release);
     if (device != VK_NULL_HANDLE) {
         if (vk.deviceWaitIdle != nullptr) vk.deviceWaitIdle(device);
         destroyFrameBuffer();
