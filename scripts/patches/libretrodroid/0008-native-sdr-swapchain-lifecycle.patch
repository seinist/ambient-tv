+void VulkanBackend::destroyNativeSdrSwapchain() {
+    // Surface changes and shutdown are synchronized on the GL/emulation thread.
+    if (device != VK_NULL_HANDLE && nativeSdrSwapchain != VK_NULL_HANDLE &&
+        vk.deviceWaitIdle != nullptr) {
+        vk.deviceWaitIdle(device);
+    }
+    if (device != VK_NULL_HANDLE && vk.destroySemaphore != nullptr) {
+        if (nativeSdrAcquire != VK_NULL_HANDLE) vk.destroySemaphore(device, nativeSdrAcquire, nullptr);
+        for (VkSemaphore semaphore : nativeSdrComplete) {
+            if (semaphore != VK_NULL_HANDLE) vk.destroySemaphore(device, semaphore, nullptr);
+        }
+    }
+    nativeSdrAcquire = VK_NULL_HANDLE;
+    nativeSdrComplete.clear();
+    nativeSdrImages.clear();
+    if (device != VK_NULL_HANDLE && nativeSdrSwapchain != VK_NULL_HANDLE &&
+        vk.destroySwapchain != nullptr) {
+        vk.destroySwapchain(device, nativeSdrSwapchain, nullptr);
+    }
+    nativeSdrSwapchain = VK_NULL_HANDLE;
+    if (instance != VK_NULL_HANDLE && nativeSdrSurface != VK_NULL_HANDLE && vk.destroySurface != nullptr) {
+        vk.destroySurface(instance, nativeSdrSurface, nullptr);
+    }
+    nativeSdrSurface = VK_NULL_HANDLE;
+    nativeSdrExtent = {};
+    nativeSdrFormat = VK_FORMAT_UNDEFINED;
+    nativeSdrStatus.store(nativeSdrWindow == nullptr ? 0u : (nativeSdrDisabled ? 9u : 1u),
+                          std::memory_order_release);
+}
+
+void VulkanBackend::setNativeSdrSurface(ANativeWindow* ownedWindow) {
+    // A repeated SurfaceChanged can have the same native pointer but different
+    // dimensions: always retire the old swapchain. The JNI caller owns the new
+    // reference until this function consumes it.
+    destroyNativeSdrSwapchain();
+    if (nativeSdrWindow != nullptr) ANativeWindow_release(nativeSdrWindow);
+    nativeSdrWindow = ownedWindow;
+    nativeSdrDisabled = false;
+    nativeSdrStatus.store(nativeSdrWindow != nullptr ? 1u : 0u, std::memory_order_release);
+}
+
+void VulkanBackend::disableNativeSdrSwapchain(const char* reason) {
+    LOGW("Native Vulkan SDR presentation disabled: %s", reason);
+    nativeSdrDisabled = true;
+    destroyNativeSdrSwapchain();
+}
+
+bool VulkanBackend::ensureNativeSdrSwapchain() {
+    if (nativeSdrSwapchain != VK_NULL_HANDLE) return true;
+    if (!isStarted() || nativeSdrWindow == nullptr || nativeSdrDisabled ||
+        surface == VK_NULL_HANDLE || !surfaceExtensionsEnabled ||
+        vk.createAndroidSurface == nullptr || vk.destroySurface == nullptr ||
+        vk.getPhysicalDeviceSurfaceSupport == nullptr ||
+        vk.getPhysicalDeviceSurfaceCapabilities == nullptr ||
+        vk.getPhysicalDeviceSurfaceFormats == nullptr ||
+        vk.getPhysicalDeviceFormatProperties == nullptr ||
+        vk.createSwapchain == nullptr || vk.destroySwapchain == nullptr ||
+        vk.getSwapchainImages == nullptr || vk.acquireNextImage == nullptr ||
+        vk.queuePresent == nullptr || vk.createSemaphore == nullptr ||
+        vk.destroySemaphore == nullptr) {
+        return false;
+    }
+    VkAndroidSurfaceCreateInfoKHR androidSurface { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    androidSurface.window = nativeSdrWindow;
+    if (vk.createAndroidSurface(instance, &androidSurface, nullptr, &nativeSdrSurface) != VK_SUCCESS) {
+        disableNativeSdrSwapchain("real Android Vulkan surface could not be created");
+        return false;
+    }
+
+    VkBool32 supportsPresent = VK_FALSE;
+    VkSurfaceCapabilitiesKHR caps {};
+    uint32_t formatCount = 0;
+    if (vk.getPhysicalDeviceSurfaceSupport(gpu, queueFamily, nativeSdrSurface, &supportsPresent) != VK_SUCCESS ||
+        supportsPresent != VK_TRUE ||
+        vk.getPhysicalDeviceSurfaceCapabilities(gpu, nativeSdrSurface, &caps) != VK_SUCCESS ||
+        (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_DST_BIT) == 0 ||
+        vk.getPhysicalDeviceSurfaceFormats(gpu, nativeSdrSurface, &formatCount, nullptr) != VK_SUCCESS ||
+        formatCount == 0) {
+        disableNativeSdrSwapchain("presentation queue, image transfer usage or surface formats unavailable");
+        return false;
+    }
+    std::vector<VkSurfaceFormatKHR> formats(formatCount);
+    const VkResult formatsResult = vk.getPhysicalDeviceSurfaceFormats(
+        gpu, nativeSdrSurface, &formatCount, formats.data());
+    if (formatsResult != VK_SUCCESS && formatsResult != VK_INCOMPLETE) {
+        disableNativeSdrSwapchain("surface format enumeration failed");
+        return false;
+    }
+
+    // Only SDR/sRGB nonlinear and a Vulkan-compatible UNORM image. HDR10 and HLG
+    // must never be selected until color-managed core source contracts exist.
+    VkSurfaceFormatKHR choice { VK_FORMAT_UNDEFINED, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR };
+    for (uint32_t i = 0; i < formatCount; ++i) {
+        const auto& candidate = formats[i];
+        if (candidate.colorSpace != VK_COLOR_SPACE_SRGB_NONLINEAR_KHR ||
+            (candidate.format != VK_FORMAT_R8G8B8A8_UNORM &&
+             candidate.format != VK_FORMAT_B8G8R8A8_UNORM)) continue;
+        VkFormatProperties properties {};
+        vk.getPhysicalDeviceFormatProperties(gpu, candidate.format, &properties);
+        if ((properties.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT) == 0) continue;
+        choice = candidate;
+        break;
+    }
+    if (choice.format == VK_FORMAT_UNDEFINED) {
+        disableNativeSdrSwapchain("no blit-capable SDR swapchain format");
+        return false;
+    }
+
+    VkExtent2D extent = caps.currentExtent;
+    if (extent.width == UINT32_MAX) {
+        const uint32_t width = static_cast<uint32_t>(std::max(1, ANativeWindow_getWidth(nativeSdrWindow)));
+        const uint32_t height = static_cast<uint32_t>(std::max(1, ANativeWindow_getHeight(nativeSdrWindow)));
+        extent.width = std::clamp(width, caps.minImageExtent.width, caps.maxImageExtent.width);
+        extent.height = std::clamp(height, caps.minImageExtent.height, caps.maxImageExtent.height);
+    }
+    if (extent.width == 0 || extent.height == 0) {
+        disableNativeSdrSwapchain("invalid window extent");
+        return false;
+    }
+
+    VkCompositeAlphaFlagBitsKHR alpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    if ((caps.supportedCompositeAlpha & alpha) == 0) {
+        const VkCompositeAlphaFlagBitsKHR possibilities[] = {
+            VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR,
+            VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR,
+            VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR
+        };
+        for (const auto item : possibilities) {
+            if (caps.supportedCompositeAlpha & item) { alpha = item; break; }
+        }
+        if ((caps.supportedCompositeAlpha & alpha) == 0) {
+            disableNativeSdrSwapchain("no supported composite alpha");
+            return false;
+        }
+    }
+    uint32_t images = caps.minImageCount + 1;
+    if (caps.maxImageCount != 0) images = std::min(images, caps.maxImageCount);
+    VkSwapchainCreateInfoKHR info { VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    info.surface = nativeSdrSurface;
+    info.minImageCount = images;
+    info.imageFormat = choice.format;
+    info.imageColorSpace = choice.colorSpace;
+    info.imageExtent = extent;
+    info.imageArrayLayers = 1;
+    info.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    info.preTransform = caps.currentTransform;
+    info.compositeAlpha = alpha;
+    info.presentMode = VK_PRESENT_MODE_FIFO_KHR; // guaranteed by Vulkan WSI
+    info.clipped = VK_TRUE;
+    if (vk.createSwapchain(device, &info, nullptr, &nativeSdrSwapchain) != VK_SUCCESS) {
+        disableNativeSdrSwapchain("swapchain creation failed");
+        return false;
+    }
+
+    uint32_t count = 0;
+    if (vk.getSwapchainImages(device, nativeSdrSwapchain, &count, nullptr) != VK_SUCCESS || count == 0) {
+        disableNativeSdrSwapchain("swapchain contains no images");
+        return false;
+    }
+    nativeSdrImages.resize(count);
+    if (vk.getSwapchainImages(device, nativeSdrSwapchain, &count, nativeSdrImages.data()) != VK_SUCCESS) {
+        disableNativeSdrSwapchain("cannot obtain swapchain images");
+        return false;
+    }
+    nativeSdrImages.resize(count);
+    VkSemaphoreCreateInfo semaphoreInfo { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    if (vk.createSemaphore(device, &semaphoreInfo, nullptr, &nativeSdrAcquire) != VK_SUCCESS) {
+        disableNativeSdrSwapchain("image acquisition semaphore allocation failed");
+        return false;
+    }
+    nativeSdrComplete.assign(count, VK_NULL_HANDLE);
+    for (auto& semaphore : nativeSdrComplete) {
+        if (vk.createSemaphore(device, &semaphoreInfo, nullptr, &semaphore) != VK_SUCCESS) {
+            disableNativeSdrSwapchain("image completion semaphore allocation failed");
+            return false;
+        }
+    }
+    nativeSdrExtent = extent;
+    nativeSdrFormat = choice.format;
+    nativeSdrStatus.store(3u, std::memory_order_release); // requested + built
+    LOGI("Experimental Vulkan SDR swapchain ready: %ux%u, %u images",
+         extent.width, extent.height, count);
+    return true;
+}
