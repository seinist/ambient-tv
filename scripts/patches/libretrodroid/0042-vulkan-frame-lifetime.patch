+bool VulkanBackend::waitForFrame() {
+    if (hasFatalError() || shutdownReady) return false;
+    if (!frameInFlight) return true;
+    bool warned = false;
+    for (;;) {
+        const VkResult result = vk.waitForFences(device, 1, &frameFence, VK_TRUE, FENCE_TIMEOUT_NS);
+        if (result == VK_TIMEOUT) {
+            // A timeout says nothing about completion. Never reset/reuse the
+            // fence, command buffer, AHB or core image while work is pending.
+            if (!warned) LOGW("Vulkan frame is still pending; waiting for its completion");
+            warned = true;
+            continue;
+        }
+        if (!checkFrameResult(result, "wait for frame fence")) return false;
+        break;
+    }
+    if (!checkFrameResult(vk.resetFences(device, 1, &frameFence), "reset frame fence")) return false;
     frameInFlight = false;
+    return true;
+}
