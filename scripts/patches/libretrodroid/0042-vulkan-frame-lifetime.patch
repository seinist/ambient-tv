+        result = vk.deviceWaitIdle(device);
+    }
+    // Vulkan defines DEVICE_LOST as completion for resource lifetime purposes.
+    // Other errors prove neither idle nor safe destruction, even after a fence
+    // error. Keep every object alive and the fatal latch set in that case.
+    if (result == VK_ERROR_DEVICE_LOST) {
