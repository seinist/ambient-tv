+bool VulkanBackend::completeDuplicateFrame() {
+    if (!isStarted() || !waitForFrame()) return false;
+
+    // Libretro Vulkan v5: duplicates do not consume set_image waits, but
+    // set_command_buffers and set_signal_semaphore are consumed exactly once.
+    // No bridge write, image layout transition, GLES drain or WSI acquire.
+    pendingImage.waitSemaphores.clear();
+    if (pendingCommandBuffers.empty() && pendingSignalSemaphore == VK_NULL_HANDLE) return true;
+
+    VkSubmitInfo submit { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    if (!pendingCommandBuffers.empty()) {
+        submit.commandBufferCount = static_cast<uint32_t>(pendingCommandBuffers.size());
+        submit.pCommandBuffers = pendingCommandBuffers.data();
+    }
+    const VkSemaphore signal = pendingSignalSemaphore;
+    if (signal != VK_NULL_HANDLE) {
+        submit.signalSemaphoreCount = 1;
+        submit.pSignalSemaphores = &signal;
+    }
+    VkResult result;
+    {
+        GameTraceScope trace("AmbientGame Vulkan duplicate submit");
+        std::lock_guard<std::mutex> lock(queueMutex);
+        result = vk.queueSubmit(queue, 1, &submit, frameFence);
+    }
+    pendingCommandBuffers.clear();
+    pendingSignalSemaphore = VK_NULL_HANDLE;
+    if (!checkFrameResult(result, "submit duplicate frame")) return false;
+    frameInFlight = true;
+    return waitForFrame();
+}
