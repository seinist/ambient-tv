+// Raw, explicitly present-fenced native WSI may grow once after sustained
+// nonblocking acquire starvation. Never request extra images from the driver
+// by default, for legacy WSI, or for a temporal filter/HDR presentation.
+class AdaptiveNativeWsiDepth {
+public:
+    void reset() noexcept { *this = AdaptiveNativeWsiDepth{}; }
+    bool shouldGrow() const noexcept { return pending; }
+    void cancelPending() noexcept { pending = false; score = 0; }
+    void commitGrowth() noexcept { grew = true; canGrow = false; cancelPending(); }
+    static bool allowsExtra(uint32_t minimum, uint32_t maximum) noexcept {
+        return minimum < std::numeric_limits<uint32_t>::max() &&
+            (maximum == 0 || maximum > minimum);
+    }
+    uint32_t requestedCount(uint32_t minimum, uint32_t maximum, bool eligible) const noexcept {
+        return minimum + (grew && eligible && allowsExtra(minimum, maximum) ? 1u : 0u);
+    }
+    void created(uint32_t minimum, uint32_t maximum, uint32_t requested,
+                 uint32_t actual, bool eligible) noexcept {
+        cancelPending();
+        canGrow = eligible && !grew && allowsExtra(minimum, maximum) &&
+            requested == minimum && actual == requested;
+    }
+    void observe(bool miss, bool success, bool eligible) noexcept {
+        if (!eligible || !canGrow) { cancelPending(); return; }
+        if (pending) return;
+        if (success) { if (score) --score; }
+        else if (miss) {
+            score = std::min(12u, score + 2u);
+            pending = score >= 12u;
+        }
+    }
+private:
+    bool grew = false;
+    bool canGrow = false;
+    bool pending = false;
+    unsigned score = 0;
+};
