+#ifndef LIBRETRODROID_GAMECONTENT_H
+#define LIBRETRODROID_GAMECONTENT_H
+
+#include <libretro.h>
+#include <string>
+#include <utility>
+#include "utils/utils.h"
+
+namespace libretrodroid {
+
+/** Keep the source bytes and path alive through core unload/deinit, including
+ * failed startup. A unique_ptr moves this owner without invalidating info.path
+ * for short strings. Full-path cores retain their original path and no buffer.
+ */
+class GameContent {
+public:
+    explicit GameContent(std::string path, Utils::ReadResult bytes = {})
+        : path(std::move(path)), bytes(std::move(bytes)) {
+        info.path = this->path.empty() ? nullptr : this->path.c_str();
+        info.data = this->bytes.data.get();
+        info.size = this->bytes.size;
+    }
+
+    GameContent(const GameContent&) = delete;
+    GameContent& operator=(const GameContent&) = delete;
+    GameContent(GameContent&&) = delete;
+    GameContent& operator=(GameContent&&) = delete;
+
+    const retro_game_info* get() const { return &info; }
+
+private:
+    std::string path;
+    Utils::ReadResult bytes;
+    retro_game_info info {};
+};
+
+}
+
+#endif
