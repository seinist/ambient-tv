+JNIEXPORT void JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_setNativeVulkanShaderPreset(
+    JNIEnv* env, jclass, jstring value
+) {
+    if (value == nullptr) {
+        VulkanBackend::getInstance().setNativeShaderPresetPath("");
+        return;
+    }
+    const char* chars = env->GetStringUTFChars(value, nullptr);
+    if (chars == nullptr) return;
+    const std::string path(chars);
+    env->ReleaseStringUTFChars(value, chars);
+    VulkanBackend::getInstance().setNativeShaderPresetPath(path);
+}
