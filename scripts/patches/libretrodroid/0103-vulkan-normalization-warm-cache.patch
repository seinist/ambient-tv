--- /dev/null
+++ b/src/main/cpp/vulkan/vulkancolorcachepolicy.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstdint>
+
+namespace libretrodroid {
+// Keep at most one small, already allocated normalization image warm during a
+// short sequence of same-extent direct frames. No new allocation is made here.
+class VulkanColorCacheRetention {
+public:
+    static constexpr std::uint64_t maxIdleBytes = 4ull * 1024ull * 1024ull;
+    static constexpr std::uint32_t maxDirectFrames = 8;
+
+    bool retainDirectFrame(std::uint64_t allocationBytes, bool sameExtent) noexcept {
+        if (!sameExtent || allocationBytes == 0 || allocationBytes > maxIdleBytes ||
+            consecutiveDirectFrames >= maxDirectFrames) return false;
+        ++consecutiveDirectFrames;
+        return true;
+    }
+    void reset() noexcept { consecutiveDirectFrames = 0; }
+
+private:
+    std::uint32_t consecutiveDirectFrames = 0;
+};
+} // namespace libretrodroid
