+bool Environment::environment_handle_set_core_options_v1(
+    const struct retro_core_option_definition* us, const struct retro_core_option_definition* local) {
+    if (us == nullptr) return false;
+    for (auto* definition = us; definition->key != nullptr; definition++) {
+        const struct retro_core_option_definition* translated = nullptr;
+        if (local != nullptr) {
+            for (auto* candidate = local; candidate->key != nullptr; candidate++) {
+                if (strcmp(candidate->key, definition->key) == 0) { translated = candidate; break; }
+            }
+        }
+        OptionMeta meta;
+        meta.title = nonEmpty(translated != nullptr ? translated->desc : nullptr, definition->desc);
+        meta.info = nonEmpty(translated != nullptr ? translated->info : nullptr, definition->info);
+        for (int i = 0; i < RETRO_NUM_CORE_OPTION_VALUES_MAX && definition->values[i].value != nullptr; i++) {
+            std::string value = definition->values[i].value;
+            std::string label = nonEmpty(definition->values[i].label, definition->values[i].value);
+            if (translated != nullptr) {
+                for (int j = 0; j < RETRO_NUM_CORE_OPTION_VALUES_MAX && translated->values[j].value != nullptr; j++) {
+                    if (value == translated->values[j].value && translated->values[j].label != nullptr) {
+                        label = translated->values[j].label;
+                        break;
+                    }
+                }
+            }
+            meta.values.emplace_back(value, label);
+        }
+        meta.defaultValue = definition->default_value != nullptr ? definition->default_value : "";
+        registerOption(definition->key, meta);
     }
+    return true;
 }
 
