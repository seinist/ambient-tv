+std::string Environment::optionMetaJson(const struct OptionMeta& meta) {
+    auto quote = [](const std::string& text) {
+        std::string out = "\"";
+        for (unsigned char c : text) {
+            switch (c) {
+                case '"': out += "\\\""; break;
+                case '\\': out += "\\\\"; break;
+                case '\n': out += "\\n"; break;
+                case '\r': out += "\\r"; break;
+                case '\t': out += "\\t"; break;
+                default:
+                    if (c < 0x20) {
+                        char buffer[8];
+                        snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+                        out += buffer;
+                    } else {
+                        out += static_cast<char>(c);
+                    }
+            }
+        }
+        return out + "\"";
+    };
+    std::string json = "{\"v\":2,\"title\":" + quote(meta.title) +
+        ",\"info\":" + quote(meta.info) +
+        ",\"category\":" + quote(meta.category) +
+        ",\"categoryTitle\":" + quote(meta.categoryTitle) +
+        ",\"categoryInfo\":" + quote(meta.categoryInfo) +
+        ",\"default\":" + quote(meta.defaultValue) +
+        ",\"visible\":" + (meta.visible ? "true" : "false") +
+        ",\"values\":[";
+    for (size_t i = 0; i < meta.values.size(); i++) {
+        if (i > 0) json += ",";
+        json += "{\"value\":" + quote(meta.values[i].first) + ",\"label\":" + quote(meta.values[i].second) + "}";
+    }
+    return json + "]}";
+}
+
+void Environment::registerOption(const std::string& key, struct OptionMeta meta) {
+    auto current = variables[key];
+    current.key = key;
+    if (current.value.empty()) {
+        current.value = !meta.defaultValue.empty() ? meta.defaultValue
+            : (meta.values.empty() ? std::string() : meta.values.front().first);
+    }
+    auto previous = optionMeta.find(key);
+    if (previous != optionMeta.end()) meta.visible = previous->second.visible;
+    optionMeta[key] = meta;
+    variables[key] = current;
+}
+
+static const char* nonEmpty(const char* preferred, const char* fallback) {
+    return (preferred != nullptr && preferred[0] != '\0') ? preferred : (fallback != nullptr ? fallback : "");
+}
+
+bool Environment::environment_handle_set_core_options_v2(
+    const struct retro_core_options_v2* us, const struct retro_core_options_v2* local) {
+    if (us == nullptr || us->definitions == nullptr) return false;
+    std::unordered_map<std::string, std::pair<std::string, std::string>> categories;
+    auto collectCategories = [&](const struct retro_core_options_v2* options, bool override) {
+        if (options == nullptr || options->categories == nullptr) return;
+        for (auto* category = options->categories; category->key != nullptr; category++) {
+            auto& entry = categories[category->key];
+            if (override || entry.first.empty()) entry.first = category->desc != nullptr ? category->desc : "";
+            if (override || entry.second.empty()) entry.second = category->info != nullptr ? category->info : "";
+        }
+    };
+    collectCategories(us, false);
+    collectCategories(local, true);
+
+    for (auto* definition = us->definitions; definition->key != nullptr; definition++) {
+        const struct retro_core_option_v2_definition* translated = nullptr;
+        if (local != nullptr && local->definitions != nullptr) {
+            for (auto* candidate = local->definitions; candidate->key != nullptr; candidate++) {
+                if (strcmp(candidate->key, definition->key) == 0) { translated = candidate; break; }
+            }
+        }
+        OptionMeta meta;
+        bool categorized = definition->category_key != nullptr && definition->category_key[0] != '\0';
+        const char* title = categorized ? nonEmpty(definition->desc_categorized, definition->desc) : nonEmpty(definition->desc, "");
+        const char* info = categorized ? nonEmpty(definition->info_categorized, definition->info) : nonEmpty(definition->info, "");
+        if (translated != nullptr) {
+            title = categorized ? nonEmpty(translated->desc_categorized, nonEmpty(translated->desc, title)) : nonEmpty(translated->desc, title);
+            info = categorized ? nonEmpty(translated->info_categorized, nonEmpty(translated->info, info)) : nonEmpty(translated->info, info);
+        }
+        meta.title = title;
+        meta.info = info;
+        if (categorized) {
+            meta.category = definition->category_key;
+            auto category = categories.find(meta.category);
+            if (category != categories.end()) {
+                meta.categoryTitle = category->second.first;
+                meta.categoryInfo = category->second.second;
+            }
+        }
+        for (int i = 0; i < RETRO_NUM_CORE_OPTION_VALUES_MAX && definition->values[i].value != nullptr; i++) {
+            std::string value = definition->values[i].value;
+            std::string label = nonEmpty(definition->values[i].label, definition->values[i].value);
+            if (translated != nullptr) {
+                for (int j = 0; j < RETRO_NUM_CORE_OPTION_VALUES_MAX && translated->values[j].value != nullptr; j++) {
+                    if (value == translated->values[j].value && translated->values[j].label != nullptr) {
+                        label = translated->values[j].label;
+                        break;
+                    }
+                }
+            }
+            meta.values.emplace_back(value, label);
+        }
+        meta.defaultValue = definition->default_value != nullptr ? definition->default_value : "";
+        registerOption(definition->key, meta);
+    }
+    return true;
+}
