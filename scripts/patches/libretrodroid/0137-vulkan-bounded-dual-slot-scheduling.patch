+bool Video::prepareExternalFrameResize() {
+    // Drain the last published slot first. The primary allocation is retained
+    // until the replacement attaches; stop borrowing the spare before release.
+    if (!finishExternalFrameUse(true)) return false;
+    if (externalFrame.selected() == 1) {
+        if (!externalFrame.select(0, eglGetCurrentDisplay(), eglGetCurrentContext(), hwRenderTexture) ||
+                !finishExternalFrameUse()) return false;
+    }
+    return releaseSpareExternalFrame();
+}
