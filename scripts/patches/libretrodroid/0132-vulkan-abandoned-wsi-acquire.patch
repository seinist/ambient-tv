diff --git a/src/main/cpp/vulkan/vulkanwsiacquirestate.h b/src/main/cpp/vulkan/vulkanwsiacquirestate.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanwsiacquirestate.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+
+namespace libretrodroid {
+
+// Render-thread ledger for binary acquire semaphore payloads. A successful
+// acquire can signal asynchronously, even when no frame submit follows.
+template<std::size_t Count = 2>
+class VulkanWsiAcquireState {
+public:
+    enum class Phase { Idle, Acquired, Submitted, Uncertain };
+    static constexpr std::size_t count = Count;
+
+    bool ready(std::size_t index) const noexcept {
+        return index < Count && phases[index] == Phase::Idle;
+    }
+    bool acquired(std::size_t index) const noexcept {
+        return index < Count && phases[index] == Phase::Acquired;
+    }
+    bool markAcquired(std::size_t index) noexcept {
+        if (!ready(index)) return false;
+        phases[index] = Phase::Acquired;
+        return true;
+    }
+    void markSubmitted(std::size_t index) noexcept {
+        if (acquired(index)) phases[index] = Phase::Submitted;
+    }
+    void markUncertain(std::size_t index) noexcept {
+        if (acquired(index)) phases[index] = Phase::Uncertain;
+    }
+    void completeSubmitted(std::size_t index) noexcept {
+        if (index < Count && phases[index] == Phase::Submitted) phases[index] = Phase::Idle;
+    }
+    void completeAllSubmitted() noexcept {
+        for (std::size_t i = 0; i < Count; ++i) completeSubmitted(i);
+    }
+    bool allIdle() const noexcept {
+        for (const auto phase : phases) if (phase != Phase::Idle) return false;
+        return true;
+    }
+    // Device loss permits destruction, not reuse. The backend's sticky fatal
+    // latch prevents any subsequent acquire until a new device is created.
+    void abandonAfterDeviceLoss() noexcept { phases.fill(Phase::Idle); }
+
+private:
+    std::array<Phase, Count> phases{};
+};
+
+} // namespace libretrodroid
