diff --git a/src/main/cpp/shaderuniformvalue.h b/src/main/cpp/shaderuniformvalue.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/shaderuniformvalue.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstring>
+
+namespace libretrodroid {
+
+// One value per active uniform in one linked frontend program. The caller
+// must bypass the cache whenever a shared/external hardware context may
+// change program state. No GL queries, heap allocations or tolerance rounding.
+template <std::size_t N>
+class ShaderUniformValue {
+public:
+    bool needsWrite(bool cacheEnabled, const std::array<float, N>& next) noexcept {
+        if (!cacheEnabled) {
+            initialized = false;
+            return true;
+        }
+        if (initialized && std::memcmp(value.data(), next.data(), sizeof(float) * N) == 0)
+            return false;
+        std::memcpy(value.data(), next.data(), sizeof(float) * N);
+        initialized = true;
+        return true;
+    }
+
+private:
+    std::array<float, N> value {};
+    bool initialized = false;
+};
+
+} // namespace libretrodroid
