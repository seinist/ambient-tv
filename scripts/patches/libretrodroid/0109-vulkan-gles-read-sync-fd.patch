+bool VulkanBackend::canImportBridgeReadFence() const {
+    return bridgeFenceEnabled && isStarted() && !hasFatalError() && !shutdownReady &&
+           vk.createSemaphore && vk.destroySemaphore && vk.importSemaphoreFd;
