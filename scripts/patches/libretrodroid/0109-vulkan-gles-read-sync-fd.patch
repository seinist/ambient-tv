+int Video::exportExternalReadFence() {
+#if defined(__ANDROID__)
+    const EGLDisplay display = eglGetCurrentDisplay();
+    const EGLContext context = eglGetCurrentContext();
+    if (!hwRenderTexture || !externalFrame.ownsContext(display, context)) return -1;
+    if (!externalFenceProbed) {
+        externalFenceProbed = true;
+        const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
+        const auto contains = [extensions](const char* name) {
+            if (!extensions) return false;
+            const size_t length = std::strlen(name);
+            for (const char* p = extensions; (p = std::strstr(p, name)); p += length) {
+                if ((p == extensions || p[-1] == ' ') && (p[length] == ' ' || p[length] == '\0'))
+                    return true;
+            }
+            return false;
+        };
+        if (contains("EGL_KHR_fence_sync") && contains("EGL_ANDROID_native_fence_sync")) {
+            createExternalSync = reinterpret_cast<PFNEGLCREATESYNCKHRPROC>(eglGetProcAddress("eglCreateSyncKHR"));
+            destroyExternalSync = reinterpret_cast<PFNEGLDESTROYSYNCKHRPROC>(eglGetProcAddress("eglDestroySyncKHR"));
+            duplicateExternalFence = reinterpret_cast<PFNEGLDUPNATIVEFENCEFDANDROIDPROC>(
+                eglGetProcAddress("eglDupNativeFenceFDANDROID"));
+        }
+    }
+    if (!createExternalSync || !destroyExternalSync || !duplicateExternalFence) return -1;
+    const EGLint attributes[] = { EGL_SYNC_NATIVE_FENCE_FD_ANDROID, EGL_NO_NATIVE_FENCE_FD_ANDROID, EGL_NONE };
+    const EGLSyncKHR sync = createExternalSync(display, EGL_SYNC_NATIVE_FENCE_ANDROID, attributes);
+    if (sync == EGL_NO_SYNC_KHR) return -1;
+    // The fence follows every prior command in this context, including secondary
+    // output and capture reads. Flush before duplicating the native sync FD.
+    glFlush();
+    const int fd = duplicateExternalFence(display, sync);
+    if (destroyExternalSync(display, sync) != EGL_TRUE) {
+        if (fd >= 0) close(fd);
+        return -1;
+    }
+    return fd;
+#else
+    return -1; // Host renderer tests do not implement Android sync-file export.
+#endif
+}
