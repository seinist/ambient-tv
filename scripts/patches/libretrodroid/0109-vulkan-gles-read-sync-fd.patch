+bool VulkanBackend::supportsBridgeReadFence() const {
+#if defined(__ANDROID__)
+    // Experimental, default-off and limited to a device we create ourselves.
+    // Custom drivers and core-negotiated devices retain the proven CPU handoff.
+    char value[PROP_VALUE_MAX] {};
+    if (__system_property_get("debug.ambient.game_sync_fd", value) <= 0 ||
+        strcmp(value, "1") != 0 || driverConfig.isCustom() ||
+        !vk.enumerateDeviceExtensionProperties || !vk.getPhysicalDeviceProperties) return false;
+    VkPhysicalDeviceProperties deviceProperties {};
+    vk.getPhysicalDeviceProperties(gpu, &deviceProperties);
+    if (deviceProperties.apiVersion < VK_API_VERSION_1_1) return false;
+    uint32_t count = 0;
+    if (vk.enumerateDeviceExtensionProperties(gpu, nullptr, &count, nullptr) != VK_SUCCESS || !count) return false;
+    std::vector<VkExtensionProperties> extensions(count);
+    if (vk.enumerateDeviceExtensionProperties(gpu, nullptr, &count, extensions.data()) != VK_SUCCESS) return false;
+    extensions.resize(count);
+    if (!hasExtension(extensions, VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME)) return false;
+    const auto query = reinterpret_cast<PFN_vkGetPhysicalDeviceExternalSemaphoreProperties>(
+        vk.getInstanceProcAddr(instance, "vkGetPhysicalDeviceExternalSemaphoreProperties"));
+    if (!query) return false;
+    VkPhysicalDeviceExternalSemaphoreInfo info { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_SEMAPHORE_INFO };
+    info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    VkExternalSemaphoreProperties properties { VK_STRUCTURE_TYPE_EXTERNAL_SEMAPHORE_PROPERTIES };
+    query(gpu, &info, &properties);
+    return (properties.externalSemaphoreFeatures & VK_EXTERNAL_SEMAPHORE_FEATURE_IMPORTABLE_BIT) != 0 &&
+           (properties.compatibleHandleTypes & VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT) != 0;
+#else
+    return false;
+#endif
+}
