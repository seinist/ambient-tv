+
+bool VulkanBackend::importBridgeReadFence(int fd) {
+    if (!canImportBridgeReadFence() || !waitForFrame()) {
+        if (fd >= 0) close(fd);
+        return false;
+    }
+    // An earlier presentFrame may have returned before queue submission (e.g.
+    // no source image). Its temporary payload was never consumed. Retire it
+    // rather than overwriting it; waitForFrame above rules out in-flight use.
+    if (bridgeReadPending) {
+        vk.destroySemaphore(device, bridgeReadSemaphore, nullptr);
+        bridgeReadSemaphore = VK_NULL_HANDLE;
+        bridgeReadPending = false;
+    }
+    if (fd < 0) {
+        bridgeFenceEnabled = false;
+        LOGW("EGL SYNC_FD export unavailable; retaining GLES finish for this session");
+        return false;
+    }
+    if (bridgeReadSemaphore == VK_NULL_HANDLE) {
+        VkSemaphoreCreateInfo info { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+        const VkResult result = vk.createSemaphore(device, &info, nullptr, &bridgeReadSemaphore);
+        if (result != VK_SUCCESS) {
+            bridgeReadSemaphore = VK_NULL_HANDLE;
+            close(fd);
+            bridgeFenceEnabled = false;
+            if (result == VK_ERROR_DEVICE_LOST) checkFrameResult(result, "create GLES read semaphore");
+            else LOGW("Cannot create GLES read semaphore; retaining GLES finish");
+            return false;
+        }
+    }
+    VkImportSemaphoreFdInfoKHR info { VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_FD_INFO_KHR };
+    info.semaphore = bridgeReadSemaphore;
+    info.flags = VK_SEMAPHORE_IMPORT_TEMPORARY_BIT;
+    info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    info.fd = fd;
+    const VkResult result = vk.importSemaphoreFd(device, &info);
+    if (result != VK_SUCCESS) {
+        // Vulkan takes FD ownership only on a successful import.
+        close(fd);
+        bridgeFenceEnabled = false;
+        if (result == VK_ERROR_DEVICE_LOST) checkFrameResult(result, "import GLES read fence");
+        else LOGW("Cannot import GLES SYNC_FD; retaining GLES finish");
+        return false;
+    }
+    bridgeReadPending = true;
+    return true; // Vulkan owns fd until the temporary payload is consumed/retired.
+}
