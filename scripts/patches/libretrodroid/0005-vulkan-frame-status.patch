+
+bool VulkanBackend::ensureFrameBuffer(unsigned width, unsigned height) {
+    if (!isStarted() || width == 0 || height == 0) return false;
+    if (frameBuffer != nullptr && width == frameWidth && height == frameHeight) return true;
+    destroyFrameBuffer();
+
+    const auto publishStatus = [this]() {
+        frameStatus.store(1u | (fp16Frame ? 2u : 0u) |
+            (preferFp16Frame ? 4u : 0u) | (forceRgba8Frame ? 8u : 0u),
+            std::memory_order_release);
+    };
+    // Avoid repeatedly attempting unsupported FP16 on subsequent frame resizes.
+    if (preferFp16Frame && !forceRgba8Frame) {
+        if (createFrameBuffer(width, height, true)) {
+            publishStatus();
+            return true;
+        }
+        forceRgba8Frame = true;
+        LOGW("FP16 Vulkan/GLES bridge unavailable; using RGBA8");
+    }
+    if (!createFrameBuffer(width, height, false)) return false;
+    publishStatus();
+    return true;
+}
 
