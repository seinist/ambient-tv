+uint64_t LibretroDroid::rewindPreviewDistance(size_t steps) const {
+    // A restored state is shown after one emulated frame, like a rewind step.
+    const uint64_t pending = rewindTimeline.pendingFrames();
+    uint64_t distance = pending > 0 ? pending - 1 : 0;
+    for (size_t index = 0; index < steps; ++index) distance += rewindBuffer->recordFrames(index);
+    return distance;
+}
