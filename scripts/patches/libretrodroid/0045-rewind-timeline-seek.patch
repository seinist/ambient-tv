+bool LibretroDroid::showRewindState(const uint8_t* data, size_t size) {
+    if (!core->retro_unserialize(data, size)) return false;
+    const bool hadAudio = audioEnabled;
+    audioEnabled = false;
+    VulkanBackend::getInstance().invalidateNativeFrame();
+    if (video && video->isHWAccelerated()) video->bindHWContext();
+    core->retro_run();
+    checkVulkanFrameError();
+    if (video && video->isHWAccelerated()) video->bindMainContext();
+    audioEnabled = hadAudio;
+    publishContentFrameSize();
+    return true;
+}
