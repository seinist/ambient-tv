+void LibretroDroid::endRewindPreview() {
+    rewindPreview.active = false;
+    rewindPreview.steps = 0;
+    rewindPreview.scratchValid = false;
+    rewindPreview.scratchSteps = 0;
+    rewindPreview.scratchSize = 0;
+    rewindPreview.live.reset();
+    rewindPreview.liveSize = 0;
+}
+
+int64_t LibretroDroid::previewRewind(uint64_t framesBack) {
+    if (!core || !rewindEnabled || !rewindBuffer || !rewindTempBuffer ||
+        rewindBuffer->getValidCount() == 0) return -1;
+    ScopedSignalStackGuard signalStackGuard;
+    if (!rewindPreview.active) {
+        if (framesBack == 0) return 0;
+        // Keep the live point, so the bar can return to it until play continues.
+        const size_t size = core->retro_serialize_size();
+        if (size == 0 || size > rewindBuffer->getMaxStateSize()) return -1;
+        try {
+            rewindPreview.live.reset(new uint8_t[size]);
+        } catch (const std::bad_alloc&) {
+            LOGW("Rewind seek unavailable: no memory for the live state");
+            return -1;
+        }
+        if (!core->retro_serialize(rewindPreview.live.get(), size)) {
+            rewindPreview.live.reset();
+            return -1;
+        }
+        rewindPreview.liveSize = size;
+        rewindPreview.active = true;
+        rewindPreview.scratchValid = false;
+    }
+    if (framesBack == 0) {
+        const bool shown = showRewindState(rewindPreview.live.get(), rewindPreview.liveSize);
+        endRewindPreview();
+        return shown ? 0 : -1;
+    }
+    // The newest stored state at or before the request; the oldest when it is further back.
+    const size_t records = rewindBuffer->getValidCount() - 1;
+    size_t steps = 0;
+    uint64_t distance = rewindPreviewDistance(0);
+    while (steps < records && distance < framesBack) {
+        distance += rewindBuffer->recordFrames(steps);
+        ++steps;
+    }
+    // Going further back continues the previous reconstruction instead of starting over.
+    uint8_t* scratch = rewindTempBuffer.get();
+    size_t size = rewindPreview.scratchSize;
+    const bool decoded = rewindPreview.scratchValid && steps >= rewindPreview.scratchSteps
+        ? rewindBuffer->peekFurther(rewindPreview.scratchSteps, steps, scratch, &size)
+        : rewindBuffer->peek(steps, scratch, &size);
+    rewindPreview.scratchValid = decoded;
+    if (!decoded) return -1;
+    rewindPreview.scratchSteps = steps;
+    rewindPreview.scratchSize = size;
+    if (!showRewindState(scratch, size)) {
+        // The core refused a stored state: return to live and offer no further history.
+        showRewindState(rewindPreview.live.get(), rewindPreview.liveSize);
+        LOGW("Rewind seek disabled: core rejected a stored state");
+        clearRewindBuffer();
+        rewindEnabled = false;
+        publishRewindSnapshot();
+        return -1;
+    }
+    rewindPreview.steps = steps;
+    return static_cast<int64_t>(distance);
+}
+
+bool LibretroDroid::commitRewindPreview() {
+    if (!rewindPreview.active) return false;
+    const size_t steps = rewindPreview.steps;
+    bool kept = rewindBuffer && rewindBuffer->getValidCount() > steps;
+    // The core already shows the chosen state plus one frame. Consume history exactly as
+    // a rewind pop of that state would, so the timeline keeps honest distances.
+    for (size_t index = 0; kept && index < steps; ++index) kept = rewindBuffer->discard();
+    if (kept) {
+        const uint64_t historyBefore = rewindBuffer->getHistoryFrames();
+        kept = rewindBuffer->discard();
+        if (kept) rewindTimeline.restored(*rewindBuffer, historyBefore - rewindBuffer->getHistoryFrames());
+    }
+    endRewindPreview();
+    if (!kept) clearRewindBuffer();
+    if (rewindBuffer) publishRewindSnapshot();
+    return kept;
+}
