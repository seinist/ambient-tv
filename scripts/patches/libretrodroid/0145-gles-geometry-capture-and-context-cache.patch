+void Video::RawCaptureCache::release() noexcept {
+    if (context != EGL_NO_CONTEXT && context == eglGetCurrentContext()) {
+        if (copyProgram) glDeleteProgram(copyProgram);
+        if (fbo) glDeleteFramebuffers(1, &fbo);
+        if (target) glDeleteTextures(1, &target);
+        if (copyVao) glDeleteVertexArrays(1, &copyVao);
+        if (copyBuffer) glDeleteBuffers(1, &copyBuffer);
+    }
+    *this = {};
+}
+
+void Video::releaseFrontendGeometry() noexcept {
+    if (frontendGeometryContext != EGL_NO_CONTEXT &&
+        frontendGeometryContext == eglGetCurrentContext()) {
+        for (auto& binding : frontendGeometryBindings)
+            if (binding.vao) glDeleteVertexArrays(1, &binding.vao);
+        if (frontendGeometryBuffer) glDeleteBuffers(1, &frontendGeometryBuffer);
+    }
+    frontendGeometryContext = EGL_NO_CONTEXT;
+    frontendGeometryBuffer = 0;
+    frontendGeometryValid = false;
+    frontendGeometryBindings = {};
+}
+
+void Video::abandonFrontendResources() noexcept {
+    // Context recreation: do not delete old numeric names in the new context.
+    rawCapture = {};
+    frontendGeometryContext = EGL_NO_CONTEXT;
+    frontendGeometryBuffer = 0;
+    frontendGeometryValid = false;
+    frontendGeometryBindings = {};
+}
+
+bool Video::prepareFrontendGeometry() {
+    if (openGLESVersion < 3 || hwAccelerated || externalFrames || hwRenderTexture != 0)
+        return false;
+    const auto context = eglGetCurrentContext();
+    if (context == EGL_NO_CONTEXT) return false;
+    if (frontendGeometryContext != context) releaseFrontendGeometry();
+    frontendGeometryContext = context;
+    if (!frontendGeometryBuffer) glGenBuffers(1, &frontendGeometryBuffer);
+    if (!frontendGeometryBuffer) return false;
+    std::array<float, 48> next {};
+    const std::array<float, 12>* sources[] = {
+        &videoLayout.getForegroundVertices(), &videoLayout.getFramebufferVertices(),
+        &videoLayout.getTextureCoordinates(), &videoLayout.getFramebufferTextureCoordinates()
+    };
+    for (std::size_t i = 0; i < 4; ++i)
+        std::copy(sources[i]->begin(), sources[i]->end(), next.begin() + 12 * i);
+    if (!frontendGeometryValid || next != frontendGeometryValues) {
+        glBindBuffer(GL_ARRAY_BUFFER, frontendGeometryBuffer);
+        glBufferData(GL_ARRAY_BUFFER, sizeof(next), next.data(), GL_DYNAMIC_DRAW);
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+        if (glGetError() != GL_NO_ERROR) {
+            releaseFrontendGeometry();
+            return false;
+        }
+        frontendGeometryValues = next;
+        frontendGeometryValid = true;
+    }
+    return true;
+}
+
+bool Video::bindFrontendGeometry(std::size_t pass, GLint position, GLint coordinate,
+                                 bool first, bool last) {
+    if (pass >= frontendGeometryBindings.size()) return false;
+    auto& binding = frontendGeometryBindings[pass];
+    if (binding.vao && (binding.position != position || binding.coordinate != coordinate ||
+            binding.first != first || binding.last != last)) {
+        glDeleteVertexArrays(1, &binding.vao);
+        binding = {};
+    }
+    if (binding.vao) {
+        glBindVertexArray(binding.vao);
+        return true;
+    }
+    glGenVertexArrays(1, &binding.vao);
+    if (!binding.vao) return false;
+    binding.position = position; binding.coordinate = coordinate;
+    binding.first = first; binding.last = last;
+    glBindVertexArray(binding.vao);
+    glBindBuffer(GL_ARRAY_BUFFER, frontendGeometryBuffer);
+    if (position >= 0) {
+        const auto offset = (last ? 0u : 12u) * sizeof(float);
+        glVertexAttribPointer(position, 2, GL_FLOAT, GL_FALSE, 0,
+                              reinterpret_cast<const void*>(offset));
+        glEnableVertexAttribArray(position);
+    }
+    if (coordinate >= 0) {
+        const auto offset = (first ? 24u : 36u) * sizeof(float);
+        glVertexAttribPointer(coordinate, 2, GL_FLOAT, GL_FALSE, 0,
+                              reinterpret_cast<const void*>(offset));
+        glEnableVertexAttribArray(coordinate);
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    if (glGetError() != GL_NO_ERROR) {
+        glBindVertexArray(0);
+        glDeleteVertexArrays(1, &binding.vao);
+        binding = {};
+        return false;
+    }
+    return true;
+}
