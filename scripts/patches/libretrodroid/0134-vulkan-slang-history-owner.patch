diff --git a/src/main/cpp/vulkan/vulkanslanghistoryuse.h b/src/main/cpp/vulkan/vulkanslanghistoryuse.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/vulkan/vulkanslanghistoryuse.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstddef>
+
+namespace libretrodroid {
+
+// A single temporal filter chain is shared by all frame slots. Recording may
+// mutate history and allocate GPU resources even when the FFI returns an error.
+// With librashader frames_in_flight=1, neither another record nor destruction
+// may proceed until the owning submission (or the entire device) has retired.
+class VulkanSlangHistoryUse {
+public:
+    enum class Phase { Idle, Recorded, Submitted };
+    static constexpr std::size_t noOwner = 2;
+
+    bool idle() const noexcept { return phase == Phase::Idle; }
+    std::size_t owner() const noexcept { return slot; }
+    bool submitted() const noexcept { return phase == Phase::Submitted; }
+
+    bool begin(std::size_t index) noexcept {
+        if (!idle() || index >= noOwner) return false;
+        slot = index;
+        phase = Phase::Recorded;
+        return true;
+    }
+    bool markSubmitted(std::size_t index) noexcept {
+        if (phase != Phase::Recorded || slot != index) return false;
+        phase = Phase::Submitted;
+        return true;
+    }
+    void completeSubmitted(std::size_t index) noexcept {
+        if (phase == Phase::Submitted && slot == index) retireAfterDeviceIdle();
+    }
+    // Covers failed/abandoned recordings as well as accepted submissions.
+    // The caller must establish device-idle or device-loss proof first.
+    void retireAfterDeviceIdle() noexcept {
+        phase = Phase::Idle;
+        slot = noOwner;
+    }
+
+private:
+    Phase phase = Phase::Idle;
+    std::size_t slot = noOwner;
+};
+
+} // namespace libretrodroid
