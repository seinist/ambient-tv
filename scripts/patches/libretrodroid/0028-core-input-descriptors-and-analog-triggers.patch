+void Input::onInputSnapshot(unsigned port, uint32_t buttons, float leftX, float leftY,
+                            float rightX, float rightY, float leftTrigger, float rightTrigger) {
+    if (port >= 4) return;
+    std::lock_guard<std::mutex> lock(inputMutex);
+    auto& target = netplayActive ? captured[port] : pads[port];
+    target.dpadXAxis = 0;
+    target.dpadYAxis = 0;
+    target.dpadReleasePending = false;
+    const uint64_t requested = buttons & 0xffffu;
+    // A down/up within one render interval still reaches the core for a frame.
+    target.pendingReleases = target.pressedKeys & ~requested;
+    target.pressedKeys |= requested;
+    target.joypadLeftXAxis = finiteAxis(leftX);
+    target.joypadLeftYAxis = finiteAxis(leftY);
+    target.joypadRightXAxis = finiteAxis(rightX);
+    target.joypadRightYAxis = finiteAxis(rightY);
+    const float left = finitePressure(leftTrigger);
+    const float right = finitePressure(rightTrigger);
+    target.leftTriggerReleasePending = left == 0.f && target.leftTrigger > 0.f;
+    target.rightTriggerReleasePending = right == 0.f && target.rightTrigger > 0.f;
+    if (!target.leftTriggerReleasePending) target.leftTrigger = left;
+    if (!target.rightTriggerReleasePending) target.rightTrigger = right;
+}
