+        bitmask |= (1u << RETRO_DEVICE_ID_JOYPAD_UP) | (1u << RETRO_DEVICE_ID_JOYPAD_RIGHT);
+    if ((source.pressedKeys & (uint64_t{1} << RETRO_DEVICE_ID_JOYPAD_DOWN_LEFT)) != 0)
