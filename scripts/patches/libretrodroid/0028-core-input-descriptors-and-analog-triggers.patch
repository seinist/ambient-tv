+JNIEXPORT jlong JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_getInputDescriptorRevision(JNIEnv*, jclass) {
+    return static_cast<jlong>(Environment::getInstance().getInputDescriptorRevision());
+}
+
+JNIEXPORT jobjectArray JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_getInputDescriptors(JNIEnv* env, jclass) {
+    const auto rows = Environment::getInstance().getInputDescriptors();
+    jclass stringClass = env->FindClass("java/lang/String");
+    if (!stringClass) return nullptr;
+    const jmethodID constructor = env->GetMethodID(stringClass, "<init>", "([BLjava/lang/String;)V");
+    if (!constructor) { env->DeleteLocalRef(stringClass); return nullptr; }
+    jstring charset = env->NewStringUTF("UTF-8");
+    if (!charset) { env->DeleteLocalRef(stringClass); return nullptr; }
+    jobjectArray result = env->NewObjectArray(static_cast<jsize>(rows.size()), stringClass, nullptr);
+    if (result) {
+        for (size_t i = 0; i < rows.size(); ++i) {
+            const auto& value = rows[i];
+            jbyteArray bytes = env->NewByteArray(static_cast<jsize>(value.size()));
+            if (!bytes) break;
+            env->SetByteArrayRegion(bytes, 0, static_cast<jsize>(value.size()),
+                                    reinterpret_cast<const jbyte*>(value.data()));
+            if (env->ExceptionCheck()) { env->DeleteLocalRef(bytes); break; }
+            // Core descriptions are UTF-8, not JNI modified UTF-8. This also replaces a
+            // truncated final sequence safely instead of passing malformed bytes to ART.
+            jobject string = env->NewObject(stringClass, constructor, bytes, charset);
+            env->DeleteLocalRef(bytes);
+            if (!string) break;
+            env->SetObjectArrayElement(result, static_cast<jsize>(i), string);
+            env->DeleteLocalRef(string);
+            if (env->ExceptionCheck()) break;
+        }
+    }
+    env->DeleteLocalRef(charset);
+    env->DeleteLocalRef(stringClass);
+    return result;
+}
+
