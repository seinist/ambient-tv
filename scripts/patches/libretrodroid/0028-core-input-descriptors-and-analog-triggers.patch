diff --git a/src/main/cpp/inputdescriptors.h b/src/main/cpp/inputdescriptors.h
new file mode 100644
--- /dev/null
+++ b/src/main/cpp/inputdescriptors.h
@@ -0,0 +1,50 @@
+// Ambient TV: owned, bounded input descriptions. Core pointers never escape the callback.
+#pragma once
+
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+#include "../../libretro-common/include/libretro.h"
+
+class InputDescriptorStore {
+public:
+    static constexpr size_t MAX_DESCRIPTORS = 256;
+    static constexpr size_t MAX_DESCRIPTION_BYTES = 256;
+
+    bool replace(const retro_input_descriptor* source) {
+        std::vector<std::string> next;
+        if (source) {
+            for (size_t i = 0; i < MAX_DESCRIPTORS && source[i].description; ++i) {
+                const auto& item = source[i];
+                if (item.port >= 4 || (item.device & RETRO_DEVICE_MASK) > RETRO_DEVICE_POINTER ||
+                    item.index > 255 || item.id > 65535) continue;
+                const size_t length = strnlen(item.description, MAX_DESCRIPTION_BYTES);
+                if (length == 0) continue;
+                next.emplace_back(std::to_string(item.port) + ":" + std::to_string(item.device) + ":" +
+                    std::to_string(item.index) + ":" + std::to_string(item.id) + ":" +
+                    std::string(item.description, length));
+            }
+        }
+        std::lock_guard<std::mutex> lock(mutex);
+        if (rows != next) {
+            rows = std::move(next);
+            revision.fetch_add(1, std::memory_order_release);
+        }
+        return true;
+    }
+
+    std::vector<std::string> snapshot() const {
+        std::lock_guard<std::mutex> lock(mutex);
+        return rows;
+    }
+
+    unsigned generation() const { return revision.load(std::memory_order_acquire); }
+
+private:
+    mutable std::mutex mutex;
+    std::vector<std::string> rows;
+    std::atomic<unsigned> revision { 0 };
+};
