+    output[2] = static_cast<int>(std::lround(finiteAxis(source.joypadLeftYAxis) * MAX_RANGE_MOTION));
+    output[3] = static_cast<int>(std::lround(finiteAxis(source.joypadRightXAxis) * MAX_RANGE_MOTION));
