--- /dev/null
+++ b/src/main/cpp/audioprocessinggate.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace libretrodroid {
+
+// One render/control owner, one audio consumer. Stream creation and retirement
+// must still be serialized by the caller. The audio callback never waits: a
+// rare control operation gets exclusive access after the in-flight block ends.
+class AudioProcessingGate {
+    static_assert(std::atomic<uint32_t>::is_always_lock_free,
+                  "Audio processing gate must be lock-free on the callback");
+    static constexpr uint32_t callbackBit = 1;
+    static constexpr uint32_t controlBit = 2;
+    std::atomic<uint32_t> state{0};
+
+public:
+    class CallbackScope {
+    public:
+        explicit CallbackScope(AudioProcessingGate& gate) noexcept : gate(gate) {
+            uint32_t expected = 0;
+            entered = gate.state.compare_exchange_strong(expected, callbackBit,
+                    std::memory_order_acquire, std::memory_order_relaxed);
+        }
+        ~CallbackScope() {
+            if (entered) gate.state.fetch_and(~callbackBit, std::memory_order_release);
+        }
+        CallbackScope(const CallbackScope&) = delete;
+        CallbackScope& operator=(const CallbackScope&) = delete;
+        explicit operator bool() const noexcept { return entered; }
+
+    private:
+        AudioProcessingGate& gate;
+        bool entered = false;
+    };
+
+    class ControlScope {
+    public:
+        explicit ControlScope(AudioProcessingGate& gate) : gate(gate) {
+            gate.state.fetch_or(controlBit, std::memory_order_acq_rel);
+            // No new callback can enter. Only the non-realtime owner waits,
+            // and it does not hold a lock needed by the callback.
+            while (gate.state.load(std::memory_order_acquire) & callbackBit) {
+                std::this_thread::sleep_for(std::chrono::microseconds(50));
+            }
+        }
+        ~ControlScope() { gate.state.store(0, std::memory_order_release); }
+        ControlScope(const ControlScope&) = delete;
+        ControlScope& operator=(const ControlScope&) = delete;
+
+    private:
+        AudioProcessingGate& gate;
+    };
+};
+
+} // namespace libretrodroid
