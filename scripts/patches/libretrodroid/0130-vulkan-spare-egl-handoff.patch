+bool LibretroDroid::prepareSpareVulkanFrame() {
+    auto& backend = VulkanBackend::getInstance();
+    if (!video || backend.hasFatalError() || !video->matchesPrimaryExternalFrame(
+            backend.getFrameBuffer(), backend.getFrameBufferWidth(), backend.getFrameBufferHeight(),
+            backend.getFrameBufferAllocationBytes())) return false;
+    const auto retained = video->retainedExternalFrameBytesExcept(
+        backend.getFrameBuffer(), backend.getSpareFrameBuffer());
+    if (!backend.ensureSpareFrameBuffer(retained)) return false;
+    if (video->prepareSpareExternalFrame(backend.getSpareFrameBuffer(), backend.getFrameBufferWidth(),
+            backend.getFrameBufferHeight(), backend.getSpareFrameBufferAllocationBytes())) return true;
+    // Optional EGL import failure is not a primary bridge failure. Stop using
+    // the optional lease before retiring its independent Vulkan allocation.
+    // If EGL cannot prove safe retirement, retain both owners for teardown.
+    if (video->releaseSpareExternalFrame()) backend.releaseSpareFrameBuffer();
+    return false;
+}
