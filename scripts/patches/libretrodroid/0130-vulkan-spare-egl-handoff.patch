+bool Video::matchesPrimaryExternalFrame(AHardwareBuffer* buffer, unsigned width, unsigned height,
+                                        std::uint64_t allocationBytes) const {
+    const auto* slot = externalFrame.get(0);
+    return externalFrames && externalFrame.selected() == 0 && slot && slot->texture == hwRenderTexture &&
+        slot->lease.matches(buffer, eglGetCurrentDisplay(), eglGetCurrentContext(), hwRenderTexture) &&
+        slot->width == width && slot->height == height && slot->allocationBytes == allocationBytes;
+}
+
+bool Video::prepareSpareExternalFrame(AHardwareBuffer* buffer, unsigned width, unsigned height,
+                                     std::uint64_t allocationBytes) {
+    // Preparation may bind a new texture but must not change the renderer's
+    // borrowed texture, geometry or selected primary import.
+    if (!externalFrames || externalFrame.selected() != 0 || !allocationBytes ||
+            !externalFrame.ownsContext(eglGetCurrentDisplay(), eglGetCurrentContext())) return false;
+    const auto* spare = externalFrame.get(1);
+    if (!spare || (spare->lease.retainsBuffer() &&
+            !spare->lease.ownsContext(eglGetCurrentDisplay(), eglGetCurrentContext()))) return false;
+    return prepareExternalFrameSlot(1, buffer, width, height, allocationBytes);
+}
+
+bool Video::releaseSpareExternalFrame() {
+    if (!externalFrames || externalFrame.selected() == 1) return false;
+    const auto* spare = externalFrame.get(1);
+    if (!spare) return false;
+    if (!spare->lease.retainsBuffer() && !spare->texture) return true;
+    const auto display = eglGetCurrentDisplay();
+    const auto context = eglGetCurrentContext();
+    // Ordinary release must prove the owning context is current. Context loss
+    // instead follows the existing generation invalidation/destruction path.
+    if (!spare->texture || !spare->lease.ownsContext(display, context)) return false;
+    ExternalFrameOps ops;
+    externalFrame.releaseSlot(1, hwRenderTexture, display, context, ops);
+    return true;
 }
 
